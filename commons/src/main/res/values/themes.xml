<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->

    <style name="Theme.NoiseFit" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:colorPrimary">@color/md_theme_dark_primary</item>
        <item name="android:colorPrimaryDark">@color/md_theme_dark_primary</item>
        <item name="android:textColorPrimary">@color/md_theme_dark_text_color</item>
        <item name="colorAccent">@color/md_theme_dark_accent</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowContentTransitions">true</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>

        <!-- Customize your theme here. -->
        <!--<item name="android:background">@color/md_theme_dark_background</item>-->

    </style>


    <style name="ToolbarBackButton" parent="Widget.AppCompat.ImageButton">
        <item name="android:background">@drawable/back_modal_new_round</item>
        <item name="android:src">@drawable/baseline_arrow_back_white_24dp</item>
        <!--        <item name="android:background">@android:color/transparent</item>-->
        <item name="android:layout_width">@dimen/dimen_32dp</item>
        <item name="android:layout_height">@dimen/dimen_32dp</item>
        <item name="android:clickable">true</item>
        <item name="android:contentDescription">Back Button</item>
        <!-- Ripple for API 21 of android, and regular selector on older -->
        <item name="android:focusable">true</item>
        <!--<item name="android:foreground">?android:attr/selectableItemBackground</item>-->//TODO
        Create custom circle ripple
    </style>

    <style name="MaterialAlertDialog_rounded" parent="@style/ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/DialogCorners</item>
    </style>

    <style name="DialogCorners">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <style name="BaseText">
        <item name="android:background">@android:color/transparent</item>
        <item name="fontFamily">@font/gilroy_medium</item>
    </style>

    <style name="BaseTextRegular">
        <item name="android:background">@android:color/transparent</item>
        <item name="fontFamily">@font/gilroy_regular</item>
    </style>

    <style name="H1" parent="BaseText">

        <item name="android:lineSpacingExtra">8sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">36sp</item>
    </style>

    <style name="H28" parent="BaseText">

        <item name="android:lineSpacingExtra">8sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">28sp</item>
    </style>

