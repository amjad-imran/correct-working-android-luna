<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    tools:context="com.oreo.ui.chatGpt.audio.AudioAiCalibrationFragment">

    <VideoView
        android:id="@+id/videoView"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/ivBack"
        style="@style/ToolbarBackButton"
        android:layout_margin="@dimen/side_margin"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="ContentDescription" />

    <TextView
        android:id="@+id/tvHeader"
        style="@style/S16"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="@+id/ivBack"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/ivBack"
        app:layout_constraintVertical_chainStyle="packed"
        android:text="@string/help_me_learn_your_voice" />

    <TextView
        android:id="@+id/tvSayHiLuna"
        style="@style/S20"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="48dp"
        android:layout_marginTop="166dp"
        android:layout_marginEnd="48dp"
        android:gravity="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvHeader"
        android:text="@string/say_hey_luna" />

    <TextView
        android:id="@+id/tvHeyLuna1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="@string/hey_luna"
        style="@style/S16"
        android:alpha="0.6"
        app:layout_constraintTop_toBottomOf="@id/tvSayHiLuna"
        app:layout_constraintStart_toStartOf="@id/tvSayHiLuna"
        app:layout_constraintEnd_toEndOf="@id/tvSayHiLuna"
        />

    <TextView
        android:id="@+id/tvHeyLuna2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/hey_luna"
        android:alpha="0.6"
        style="@style/S16"
        app:layout_constraintTop_toBottomOf="@id/tvHeyLuna1"
        app:layout_constraintStart_toStartOf="@id/tvSayHiLuna"
        app:layout_constraintEnd_toEndOf="@id/tvSayHiLuna"
        />

    <TextView
        android:id="@+id/tvHeyLuna3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/hey_luna"
        android:alpha="0.6"
        style="@style/S16"
        app:layout_constraintTop_toBottomOf="@id/tvHeyLuna2"
        app:layout_constraintStart_toStartOf="@id/tvSayHiLuna"
        app:layout_constraintEnd_toEndOf="@id/tvSayHiLuna"
        />

    <TextView
        android:id="@+id/tvListening"
        style="@style/S16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="26dp"
        android:gravity="center"
        android:text="@string/text_listening_dot"
        android:textColor="#99FFFFFF"
        android:layout_marginTop="140dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvHeyLuna3"
        tools:visibility="visible" />

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/lottieView"
        android:layout_width="wrap_content"
        android:layout_height="136dp"
        android:scaleType="centerInside"
        android:layout_marginTop="@dimen/dimen_8dp"
        app:layout_constraintEnd_toEndOf="@id/tvListening"
        app:layout_constraintStart_toStartOf="@id/tvListening"
        app:layout_constraintTop_toBottomOf="@id/tvListening"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        app:lottie_rawRes="@raw/voice_ai_listening" />

    <androidx.constraintlayout.widget.Group
        android:id="@+id/groupListening"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:constraint_referenced_ids="lottieView, tvListening" />

    <TextView
        android:id="@+id/tvRecord"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="70dp"
        android:background="@drawable/bg_capsule_white"
        android:paddingHorizontal="48dp"
        android:paddingVertical="@dimen/dimen_16dp"
        android:text="@string/record"
        android:textColor="@color/black"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <include
        android:id="@+id/lytBottomChecks"
        layout="@layout/layout_calibration_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        app:layout_constraintTop_toTopOf="@id/tvHeyLuna1"
        app:layout_constraintBottom_toBottomOf="@id/tvHeyLuna3"
        app:layout_constraintEnd_toStartOf="@id/tvHeyLuna1" />

    <TextView
        android:id="@+id/tvDone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/S18"
        android:text="@string/done"
        android:visibility="gone"
        android:drawablePadding="30dp"
        android:gravity="center"
        app:drawableTopCompat="@drawable/ic_done"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <include
        android:id="@+id/progressBar"
        layout="@layout/default_loader"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>