                    android:visibility="visible"
                    app:image="@drawable/ic_suggest_feature"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:text="@string/text_suggest_a_feature" />

                <com.noisefit_commans.ui.custom.SettingsRow
                    android:id="@+id/rowSelectLanguage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:visibility="visible"
                    app:image="@drawable/ic_language_change"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/llMyProfile"
                    app:text="@string/text_select_language" />



                <com.noisefit_commans.ui.custom.SettingsRow
                    android:id="@+id/rowHelp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:image="@drawable/ic_question_mark"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/rowSelectLanguage"
                    app:text="@string/text_help_and_support" />

                <com.noisefit_commans.ui.custom.SettingsRow
                    android:id="@+id/rowReportToDevs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:image="@drawable/ic_report_dev"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/rowHelp"
                    app:text="@string/text_report_to_developers" />


                <com.noisefit_commans.ui.custom.SettingsRow
