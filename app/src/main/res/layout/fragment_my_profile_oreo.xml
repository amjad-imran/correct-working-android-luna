                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:image="@drawable/ic_learn_more"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/rowFeedBack"
                    app:text="@string/text_learn_more" />

                <com.noisefit_commans.ui.custom.SettingsRow
                    android:id="@+id/rowSettings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:image="@drawable/ic_settings"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/rowLearn"
                    app:text="@string/text_settings" />

                <com.noisefit_commans.ui.custom.SettingsRow
                    android:id="@+id/rowSupport"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:image="@drawable/ic_support"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/rowSettings"
                    app:text="@string/text_email_support" />

                <com.noisefit_commans.ui.custom.SettingsRow
                    android:id="@+id/rowAbout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="visible"
                    app:image="@drawable/ic_info_black"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/rowSupport"
                    app:text="@string/text_about" />

                <com.noisefit_commans.ui.custom.SettingsRow
                    android:id="@+id/rowCycleTracker"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="visible"
                    app:image="@drawable/ic_info_cycle_tracker"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/rowAbout"
                    app:text="@string/text_cycle_tracker" />

                <com.noisefit_commans.ui.custom.SettingsRow
                    android:id="@+id/rowReferral"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="visible"
                    app:image="@drawable/ic_refer_and_earn"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/rowCycleTracker"
                    app:text="@string/text_refer_and_earn" />

                <include
                    layout="@layout/layout_divider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/rowCycleTracker" />

