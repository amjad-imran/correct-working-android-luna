<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/transparent">

    <TextView
        android:id="@+id/tvHabitTitle"
        android:layout_width="@dimen/dimen_0dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/gilroy_medium"
        tools:text="Cold Plunge"
        android:textColor="@color/color_B3FFFFFF"
        android:textSize="@dimen/dimen_14sp"
        android:layout_marginStart="@dimen/dimen_12dp"
        app:layout_constraintEnd_toStartOf="@+id/igCross"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/igCross"
        app:layout_constraintTop_toTopOf="@id/igCross" />

    <ImageButton
        android:id="@+id/igCross"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_log_habit"
        android:src="@drawable/ic_btn_close"
        android:padding="@dimen/dimen_4dp"
        android:layout_marginEnd="@dimen/dimen_8dp"
        android:layout_marginVertical="@dimen/dimen_8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/viewDivider"
        app:layout_constraintEnd_toStartOf="@id/igTick"
        />

    <ImageButton
        android:id="@+id/igTick"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="@dimen/dimen_4dp"
        android:background="@drawable/bg_log_habit"
        android:src="@drawable/ic_btn_tick"
        android:layout_marginEnd="@dimen/dimen_12dp"
        app:layout_constraintTop_toTopOf="@id/igCross"
        app:layout_constraintBottom_toBottomOf="@id/igCross"
        app:layout_constraintEnd_toEndOf="parent"/>

    <View
        android:id="@+id/viewDivider"
        android:layout_width="0dp"
        android:layout_height="@dimen/dimen_1dp"
        android:background="#1AFFFFFF"
        android:layout_marginTop="@dimen/dimen_16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />
</androidx.constraintlayout.widget.ConstraintLayout>