<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/materialCardView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/side_margin"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="@dimen/side_margin"
        app:cardBackgroundColor="#1cffffff"
        app:cardCornerRadius="12dp"
        app:strokeColor="#2effffff"
        app:strokeWidth="1dp"
        app:cardElevation="0dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="16dp">

            <ImageView
                android:id="@+id/imageViewBack"
                android:layout_width="match_parent"
                android:layout_height="144dp"
                android:scaleType="centerCrop"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/textViewStatus"
                style="@style/Small"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/back_upcoming_challenge"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/side_margin"
                android:paddingTop="4dp"
                android:paddingEnd="@dimen/side_margin"
                android:paddingBottom="4dp"
                android:text="@string/text_upcoming"
                android:textColor="@android:color/white"
                android:textSize="10sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/textViewStartInDay"
                style="@style/Small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/side_margin"
                android:layout_marginTop="16dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/imageViewBack"
                tools:text="Start in 3 Days" />

            <TextView
                android:id="@+id/textViewTitle"
                style="@style/H4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/side_margin"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/very_light_pink"
                app:layout_constraintEnd_toStartOf="@+id/imageViewType1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textViewStartInDay"
                tools:text="Noise for the Heart" />

            <ImageView
                android:id="@+id/imageViewType1"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="@dimen/side_margin"
                android:layout_marginEnd="@dimen/side_margin"
                android:background="@drawable/circle_black"
                android:padding="4dp"
                android:src="@drawable/ic_steps"
                android:visibility="invisible"
                app:layout_constraintBottom_toBottomOf="@id/textViewTitle"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/textViewTitle"
                tools:ignore="ContentDescription" />


            <LinearLayout
                android:id="@+id/lytImageSlider"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/side_margin"
                android:layout_marginTop="24dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textViewTitle">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/imageViewCircle1"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/evolve_demo_bg"
                    android:padding="1dp"
                    app:shapeAppearance="@style/ShapeAppearance.App.CircleImageView"
                    app:strokeColor="@android:color/white"
                    app:strokeWidth="1dp" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/imageViewCircle2"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="-6dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/evolve_demo_bg"
                    android:padding="1dp"
                    app:shapeAppearance="@style/ShapeAppearance.App.CircleImageView"
                    app:strokeColor="@android:color/white"
                    app:strokeWidth="1dp" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/imageViewCircle3"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="-6dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/evolve_demo_bg"
                    android:padding="1dp"
                    app:shapeAppearance="@style/ShapeAppearance.App.CircleImageView"
                    app:strokeColor="@android:color/white"
                    app:strokeWidth="1dp" />
            </LinearLayout>


            <TextView
                android:id="@+id/tvParticipantValue"
                style="@style/H6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/very_light_pink"
                app:layout_constraintBottom_toBottomOf="@id/lytImageSlider"
                app:layout_constraintStart_toEndOf="@id/lytImageSlider"
                tools:text="123456 Participants" />

            <ImageView
                android:id="@+id/imageViewType"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="@dimen/side_margin"
                android:layout_marginEnd="@dimen/side_margin"
                android:background="@drawable/circle_black"
                android:padding="4dp"
                android:src="@drawable/ic_steps"
                app:layout_constraintBottom_toBottomOf="@id/lytImageSlider"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/lytImageSlider" />


        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>
</layout>