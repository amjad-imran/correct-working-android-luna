<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent">


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/list"
            style="@style/ModalStyleDialog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimen_12dp"
            android:layout_marginTop="@dimen/dimen_12dp"
            android:layout_marginEnd="@dimen/dimen_12dp"
            android:layout_marginBottom="@dimen/dimen_12dp"
            tools:listitem="@layout/fragment_privacy_bottom_dialog_list_dialog_item">

            <View
                android:id="@+id/view10"
                android:layout_width="80dp"
                android:layout_height="2dp"
                android:layout_marginTop="4dp"
                android:alpha="0.5"
                android:background="@drawable/back_bottom_sheet_drag"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvTitle"
                style="@style/H4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dimen_16dp"
                android:layout_marginTop="@dimen/dimen_24dp"
                android:layout_marginEnd="@dimen/dimen_16dp"
                android:gravity="center"
                android:textColor="@color/white"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/view10"
                tools:text="Custom watch face" />


            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/bgImv"
                android:layout_width="@dimen/dimen_160dp"
                android:layout_height="188dp"
                android:layout_marginTop="24dp"
                android:adjustViewBounds="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvTitle"
                app:layout_constraintVertical_chainStyle="packed"
                app:shapeAppearance="@style/ShapeAppearanceOverlay.App.CornerSize10dp" />

            <ImageView
                android:id="@+id/lvAnimFirst"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginTop="24dp"
                android:layout_marginStart="42dp"
                android:src="@drawable/ic_star_border"
                app:layout_constraintEnd_toStartOf="@+id/lvAnimSecond"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintHorizontal_chainStyle="spread_inside"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/bgImv" />

            <ImageView
                android:id="@+id/lvAnimSecond"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_star_border"
                app:layout_constraintBottom_toBottomOf="@+id/lvAnimFirst"
                app:layout_constraintEnd_toStartOf="@+id/lvAnimThird"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/lvAnimFirst"
                app:layout_constraintTop_toTopOf="@+id/lvAnimFirst" />

            <ImageView
                android:id="@+id/lvAnimThird"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_star_border"
                app:layout_constraintBottom_toBottomOf="@+id/lvAnimFirst"
                app:layout_constraintEnd_toStartOf="@+id/lvAnimFourth"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/lvAnimSecond"
                app:layout_constraintTop_toTopOf="@+id/lvAnimFirst" />

            <ImageView
                android:id="@+id/lvAnimFourth"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_star_border"
                app:layout_constraintBottom_toBottomOf="@+id/lvAnimFirst"
                app:layout_constraintEnd_toStartOf="@+id/lvAnimFifth"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/lvAnimThird"
                app:layout_constraintTop_toTopOf="@+id/lvAnimFirst" />

            <ImageView
                android:id="@+id/lvAnimFifth"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="42dp"
                android:src="@drawable/ic_star_border"
                app:layout_constraintBottom_toBottomOf="@+id/lvAnimFirst"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/lvAnimFourth"
                app:layout_constraintTop_toTopOf="@+id/lvAnimFirst" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancel"
                style="@style/SecondaryButtonStyle"
                android:layout_width="0dp"
                android:layout_height="@dimen/dimen_40dp"
                android:layout_marginStart="@dimen/dimen_16dp"
                android:layout_marginTop="32dp"
                android:layout_marginEnd="@dimen/dimen_16dp"
                android:layout_marginBottom="@dimen/dimen_24dp"
                android:text="@string/text_no_thank_you"
                app:backgroundTint="@null"
                app:layout_constraintBottom_toBottomOf="parent"

                app:layout_constraintEnd_toStartOf="@+id/btnSubmit"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/lvAnimFirst" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSubmit"
                style="@style/PrimaryButtonStyle"
                android:layout_width="0dp"
                android:layout_height="@dimen/dimen_40dp"
                android:layout_marginStart="@dimen/dimen_16dp"
                android:layout_marginTop="32dp"
                android:layout_marginEnd="@dimen/dimen_16dp"
                android:layout_marginBottom="@dimen/dimen_24dp"
                android:text="@string/text_submit"
                app:backgroundTint="@null"
                android:enabled="false"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/btnCancel"
                app:layout_constraintTop_toBottomOf="@+id/lvAnimFirst" />



        </androidx.constraintlayout.widget.ConstraintLayout>
    </RelativeLayout>
</layout>
