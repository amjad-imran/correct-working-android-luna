<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/S16"
        android:text="@string/text_acitivity_monitor"
        android:layout_marginStart="16dp"
        android:layout_marginTop="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitle">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/shapeableImageView16"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/image_back_health_monitor"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearance="@style/ShapeAppearanceOverlay.App.CornerSize10dp" />

        <ImageView
            android:id="@+id/ivLightExposure"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="36dp"
            android:layout_marginTop="32dp"
            app:layout_constraintHorizontal_chainStyle="spread_inside"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:src="@drawable/ic_sun_activity_monitor" />

        <ImageView
            android:id="@+id/ivDailySteps"
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:layout_constraintBottom_toBottomOf="@+id/ivLightExposure"
            app:layout_constraintEnd_toStartOf="@id/ivWorkout"
            app:layout_constraintStart_toEndOf="@+id/ivLightExposure"
            app:layout_constraintTop_toTopOf="@+id/ivLightExposure"
            android:src="@drawable/ic_steps_activity_monitor" />

        <ImageView
            android:id="@+id/ivWorkout"
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:layout_constraintBottom_toBottomOf="@+id/ivLightExposure"
            app:layout_constraintEnd_toStartOf="@id/ivCaffeine"
            app:layout_constraintStart_toEndOf="@+id/ivDailySteps"
            app:layout_constraintTop_toTopOf="@+id/ivLightExposure"
            android:src="@drawable/ic_workout_activity_monitor" />

        <ImageView
            android:id="@+id/ivCaffeine"
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:layout_constraintBottom_toBottomOf="@+id/ivLightExposure"
            app:layout_constraintEnd_toStartOf="@id/ivMeal"
            app:layout_constraintStart_toEndOf="@+id/ivWorkout"
            app:layout_constraintTop_toTopOf="@+id/ivLightExposure"
            android:src="@drawable/ic_caffeine_activity_monitor" />

        <ImageView
            android:id="@+id/ivMeal"
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:layout_constraintBottom_toBottomOf="@+id/ivLightExposure"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ivCaffeine"
            app:layout_constraintTop_toTopOf="@+id/ivLightExposure"
            android:src="@drawable/ic_meal_activity_monitor" />

        <ImageView
            android:id="@+id/ivStateLight"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginTop="12dp"
            app:layout_constraintEnd_toEndOf="@+id/ivLightExposure"
            app:layout_constraintStart_toStartOf="@+id/ivLightExposure"
            app:layout_constraintTop_toBottomOf="@+id/ivLightExposure"
             />

        <ImageView
            android:id="@+id/ivStateSteps"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginTop="12dp"
            app:layout_constraintEnd_toEndOf="@+id/ivDailySteps"
            app:layout_constraintStart_toStartOf="@+id/ivDailySteps"
            app:layout_constraintTop_toBottomOf="@+id/ivDailySteps"
             />

        <ImageView
            android:id="@+id/ivStateWorkout"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginTop="12dp"
            app:layout_constraintEnd_toEndOf="@+id/ivWorkout"
            app:layout_constraintStart_toStartOf="@+id/ivWorkout"
            app:layout_constraintTop_toBottomOf="@+id/ivWorkout"
             />

        <ImageView
            android:id="@+id/ivStateCaffeine"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginTop="12dp"
            app:layout_constraintEnd_toEndOf="@+id/ivCaffeine"
            app:layout_constraintStart_toStartOf="@+id/ivCaffeine"
            app:layout_constraintTop_toBottomOf="@+id/ivCaffeine"
             />

        <ImageView
            android:id="@+id/ivStateMeal"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginTop="12dp"
            app:layout_constraintEnd_toEndOf="@+id/ivMeal"
            app:layout_constraintStart_toStartOf="@+id/ivMeal"
            app:layout_constraintTop_toBottomOf="@+id/ivMeal"
             />

        <TextView
            android:id="@+id/tvDesc"
            style="@style/S12"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="22dp"
            android:text="@string/text_your_overall_circadian_is_well_aligned"
            android:textColor="#8CFFFFFF"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ivStateLight" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>