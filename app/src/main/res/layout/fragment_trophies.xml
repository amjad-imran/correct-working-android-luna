<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="viewModel"
            type="com.noisefit.ui.trophies.TrophiesViewModel" />

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".ui.dashboard.graphs.steps.StepsDetailsFragment">

        <include
            android:id="@+id/layoutToolbar"
            layout="@layout/layout_toolbar" />

        <LinearLayout
            android:id="@+id/layoutTabs"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginStart="@dimen/side_margin"
            android:layout_marginTop="@dimen/dimen_12dp"
            android:layout_marginEnd="@dimen/side_margin"
            android:gravity="start"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layoutToolbar">

            <include
                android:id="@+id/layoutSteps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                layout="@layout/row_tabs"/>
            <include
                android:id="@+id/layoutDistance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                layout="@layout/row_tabs"/>

        </LinearLayout>

        <!--<androidx.core.widget.NestedScrollView
            android:id="@+id/svMain"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_alignParentTop="true"
            android:layout_marginTop="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layoutTabs">
-->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/dimen_16dp"
            app:layout_constraintBottom_toTopOf="@+id/tvRemoveBuddy"
            app:layout_constraintTop_toBottomOf="@+id/layoutTabs">

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/vpTrophies"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/dimen_16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />


        </androidx.constraintlayout.widget.ConstraintLayout>
        <!--        </androidx.core.widget.NestedScrollView>-->

        <TextView
            android:id="@+id/tvRemoveBuddy"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            style="@style/H5"
            android:gravity="center"
            android:visibility="gone"
            tools:visibility="gone"
            android:text="@string/text_remove_buddy"
            android:textColor="@color/errorRed"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <include
            android:id="@+id/progressBar"
            layout="@layout/default_loader"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layoutToolbar" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>