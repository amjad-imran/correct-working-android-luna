<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/back_modal_purple">

        <ImageView
            android:id="@+id/imageView39"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="16dp"
            android:src="@drawable/ic_npl_ball"
            app:layout_constraintBottom_toBottomOf="@+id/tvTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvTitle" />

        <TextView
            android:id="@+id/tvTitle"
            style="@style/H5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="40dp"
            tools:text="@string/text_npl_recap"
            android:textColor="@color/white"
            android:visibility="visible"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/imageView39"
            app:layout_constraintTop_toTopOf="parent"
            tools:visibility="visible" />
        <ImageView
            android:id="@+id/ivMore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/side_margin"
            android:alpha=".5"
            android:src="@drawable/ic_arrow_right_cal"
            android:visibility="visible"
            app:layout_constraintBottom_toBottomOf="@id/tvTitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvTitle"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tvCorrectAnswer"
            style="@style/H5"
            android:layout_marginStart="@dimen/side_margin"
            android:layout_marginEnd="@dimen/side_margin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="@color/accent_color_purple"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTitle"
            tools:text="0" />

        <TextView
            android:id="@+id/tvCorrectAnswerCount"
            style="@style/H6"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textColor="@color/white_64"
            app:layout_constraintBottom_toBottomOf="@+id/tvCorrectAnswer"
            app:layout_constraintStart_toEndOf="@id/tvCorrectAnswer"
            app:layout_constraintTop_toTopOf="@+id/tvCorrectAnswer"
            tools:text="/150 correct answer" />

        <View
            android:id="@+id/vBackProgress"
            android:layout_width="0dp"
            android:layout_height="16dp"
            android:layout_marginHorizontal="@dimen/side_margin"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/back_progress_16"
            android:visibility="visible"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvCorrectAnswerCount" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/pbSteps"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            app:indicatorColor="@color/purple_"
            app:layout_constraintBottom_toBottomOf="@+id/vBackProgress"
            app:layout_constraintEnd_toEndOf="@+id/vBackProgress"
            app:layout_constraintStart_toStartOf="@+id/vBackProgress"
            app:layout_constraintTop_toTopOf="@+id/vBackProgress"
            app:trackColor="#19ffffff"
            app:trackCornerRadius="2dp"
            app:trackThickness="4dp" />

        <TextView
            android:id="@+id/tvQLeftTitle"
            style="@style/H6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/side_margin"
            android:layout_marginTop="9dp"
            android:text="@string/text_question_left"
            android:textColor="@color/white_64"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/vBackProgress" />

        <TextView
            android:id="@+id/tvQLeftValue"
            style="@style/H6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:adjustViewBounds="true"
            tools:text="200"
            android:textColor="@color/white"
            app:layout_constraintBottom_toBottomOf="@+id/tvQLeftTitle"
            app:layout_constraintStart_toEndOf="@+id/tvQLeftTitle"
            app:layout_constraintTop_toTopOf="@id/tvQLeftTitle"
            tools:ignore="ContentDescription" />

        <TextView
            android:id="@+id/tvBRValue"
            style="@style/H6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:layout_marginEnd="@dimen/side_margin"
            android:layout_marginBottom="16dp"
            android:textColor="@color/white"
            app:drawableStartCompat="@drawable/ic_noise_c_20"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/vBackProgress"
            tools:text="500" />

        <TextView
            android:id="@+id/tvBonusReward"
            style="@style/H6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:drawablePadding="4dp"
            android:gravity="center"
            android:textSize="12sp"
            android:text="@string/text_bonus_reward"
            android:textColor="@color/white_64"
            app:layout_constraintBottom_toBottomOf="@id/tvBRValue"
            app:layout_constraintEnd_toStartOf="@+id/tvBRValue"
            app:layout_constraintTop_toTopOf="@id/tvBRValue" />

        <View
            android:id="@+id/dummyViewQuestion"
            android:layout_width="match_parent"
            android:layout_height="14dp"
            android:layout_marginTop="6dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvQLeftTitle" />

        <include
            android:id="@+id/divider1"
            layout="@layout/layout_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:visibility="gone"
            tools:visibility="visible"
            android:layout_marginBottom="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/dummyViewQuestion" />
        <TextView
            android:id="@+id/tvMsg"
            style="@style/H6"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingBottom="8dp"
            android:visibility="gone"
            tools:visibility="visible"
            android:layout_marginStart="@dimen/side_margin"
            android:layout_marginEnd="@dimen/side_margin"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/divider1"
            tools:text="Everyday one lucky winner will get ManCompany
perfume worth Rs.1,299" />

        <include
            android:id="@+id/divider2"
            layout="@layout/layout_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="8dp"
            android:visibility="gone"
            tools:visibility="visible"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvMsg" />
        <TextView
            android:id="@+id/tvPowered"
            style="@style/Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/side_margin"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:text="@string/text_powered_by"
            android:visibility="gone"
            tools:visibility="visible"
            app:layout_constraintBottom_toBottomOf="parent"
            android:textColor="@color/white_64"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/divider2" />

        <ImageView
            android:id="@+id/ivPowered"
            android:layout_width="wrap_content"
            android:layout_height="10dp"
            android:layout_marginStart="4dp"
            android:adjustViewBounds="true"
            android:visibility="gone"
            tools:visibility="visible"
            tools:src="@drawable/ic_fancode"
            app:layout_constraintBottom_toBottomOf="@+id/tvPowered"
            app:layout_constraintStart_toEndOf="@+id/tvPowered"
            app:layout_constraintTop_toTopOf="@id/tvPowered"
            tools:ignore="ContentDescription" />


    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>