<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/side_margin"
            android:layout_marginTop="21dp"
            android:layout_marginBottom="24dp"
            style="@style/H6"
            android:textColor="#88b0ff"
            android:id="@+id/tvSetUpAlarm"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:text="@string/text_set_up_alarm" />
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/ivAlarmMore"
            android:src="@drawable/ic_sa_frwrd_arrow"
            android:layout_marginEnd="@dimen/side_margin"
            app:layout_constraintTop_toTopOf="@id/tvSetUpAlarm"
            app:layout_constraintBottom_toBottomOf="@id/tvSetUpAlarm"
            app:layout_constraintEnd_toEndOf="parent"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/H6"
            android:id="@+id/tvAlarmTime"
            android:visibility="gone"
            tools:visibility="visible"
            android:layout_marginEnd="12dp"
            app:layout_constraintTop_toTopOf="@id/ivAlarmMore"
            app:layout_constraintEnd_toStartOf="@id/ivAlarmMore"
            app:layout_constraintBottom_toBottomOf="@id/ivAlarmMore"
            android:textColor="#88b0ff"
            tools:text="7:30am"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>