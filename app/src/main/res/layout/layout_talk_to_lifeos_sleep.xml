<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/back_talk_lifeos_card_sleep"
    android:padding="12dp">

    <ImageView
        android:id="@+id/imageView131"
        android:layout_width="24dp"
        android:layout_height="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_lifeos_star" />

    <ImageView
        android:id="@+id/ivBackBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/back_modal_new_round"
        android:src="@drawable/ic_arrow_planner_right"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textView130"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        style="@style/S14"
        android:textStyle="bold"
        android:lineHeight="17sp"
        android:layout_marginBottom="8dp"
        android:layout_marginHorizontal="16dp"
        android:text="Curious about your sleep patterns?"
        app:layout_constraintBottom_toTopOf="@+id/textView223"
        app:layout_constraintEnd_toStartOf="@+id/ivBackBtn"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/imageView131"
        app:layout_constraintTop_toTopOf="@+id/imageView131"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/textView223"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        style="@style/S14"
        android:fontFamily="@font/gilroy_regular"
        android:lineHeight="17sp"
        android:layout_marginHorizontal="16dp"
        android:text="Talk it out with Life OS"
        app:layout_constraintBottom_toBottomOf="@+id/imageView131"
        app:layout_constraintEnd_toStartOf="@+id/ivBackBtn"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/imageView131"
        app:layout_constraintTop_toBottomOf="@+id/textView130" />

</androidx.constraintlayout.widget.ConstraintLayout>