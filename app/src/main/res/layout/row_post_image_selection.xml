<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp">

        <View
            android:id="@+id/vBackSelector"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/back_modal_new"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivMain"
            android:layout_width="78dp"
            android:layout_height="78dp"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="@+id/vBackSelector"
            app:layout_constraintEnd_toEndOf="@+id/vBackSelector"
            app:layout_constraintStart_toStartOf="@+id/vBackSelector"
            app:layout_constraintTop_toTopOf="@+id/vBackSelector"
            app:shapeAppearance="@style/ShapeAppearanceOverlay.App.CornerSize10dp" />

        <TextView
            android:id="@+id/tvImageName"
            style="@style/Small"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="1dp"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="@color/white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/ivMain"
            app:layout_constraintStart_toStartOf="@+id/ivMain"
            app:layout_constraintTop_toBottomOf="@+id/ivMain"
            tools:text="Upload" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>