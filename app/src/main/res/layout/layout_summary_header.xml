<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/back_modal_new"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="16dp"
        android:clipChildren="false">

        <TextView
            android:id="@+id/textView65"
            style="@style/H5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/side_margin"
            android:layout_marginTop="16dp"
            android:text="@string/text_health_overview"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/ivShare"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:padding="14dp"
            android:src="@drawable/ic_share"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.hookedonplay.decoviewlib.DecoView
            android:id="@+id/dynamicArcView"
            android:layout_width="124dp"
            android:layout_height="124dp"
            android:layout_marginEnd="@dimen/side_margin"
            app:layout_constraintBottom_toBottomOf="@+id/imageView20"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/textSteps" />

        <TextView
            android:id="@+id/textCalories"
            style="@style/Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/side_margin"
            android:layout_marginTop="20dp"
            android:text="@string/text_calories"
            android:textColor="@color/white"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/imageView19"
            app:layout_constraintVertical_chainStyle="packed" />

        <ImageView
            android:id="@+id/imageView20"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginTop="6dp"
            android:src="@drawable/ic_calories"
            app:layout_constraintStart_toStartOf="@+id/textCalories"
            app:layout_constraintTop_toBottomOf="@+id/textCalories" />

        <TextView
            android:id="@+id/tvCalorieCurrent"
            style="@style/H4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textColor="@color/calories_arc"
            app:layout_constraintBottom_toBottomOf="@+id/imageView20"
            app:layout_constraintStart_toEndOf="@+id/imageView20"
            app:layout_constraintTop_toTopOf="@+id/imageView20"
            tools:text="2500" />

        <TextView
            android:id="@+id/tvCalorieGoal"
            style="@style/Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBaseline_toBaselineOf="@id/tvCalorieCurrent"
            android:textColor="@color/white_80"
            app:layout_constraintBottom_toBottomOf="@+id/tvCalorieCurrent"
            app:layout_constraintStart_toEndOf="@+id/tvCalorieCurrent"
            tools:text="/2500" />

        <TextView
            android:id="@+id/textSteps"
            style="@style/Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/text_steps"
            android:textColor="@color/white"
            app:layout_constraintStart_toStartOf="@+id/imageView20"
            app:layout_constraintTop_toBottomOf="@+id/textView65" />

        <TextView
            android:id="@+id/tvStepCurrent"
            style="@style/H4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textColor="@color/steps_arc"
            app:layout_constraintBottom_toBottomOf="@+id/imageView6"
            app:layout_constraintStart_toEndOf="@+id/imageView6"
            app:layout_constraintTop_toTopOf="@+id/imageView6"
            tools:text="2500" />


        <ImageView
            android:id="@+id/imageView6"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="2dp"
            android:layout_marginTop="6dp"
            android:src="@drawable/ic_steps"
            app:layout_constraintStart_toStartOf="@+id/textSteps"
            app:layout_constraintTop_toBottomOf="@+id/textSteps" />

        <TextView
            android:id="@+id/tvStepGoal"
            style="@style/Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white_80"
            app:layout_constraintBaseline_toBaselineOf="@id/tvStepCurrent"
            app:layout_constraintBottom_toBottomOf="@+id/tvStepCurrent"
            app:layout_constraintStart_toEndOf="@+id/tvStepCurrent"
            tools:text="/2500" />

        <TextView
            android:id="@+id/textDistance"
            style="@style/Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/distance"
            android:textColor="@color/white"
            app:layout_constraintStart_toStartOf="@+id/textCalories"
            app:layout_constraintTop_toBottomOf="@+id/imageView6" />

        <TextView
            android:id="@+id/tvDistanceCurrent"
            style="@style/H4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textColor="@color/distance_arc"
            app:layout_constraintBottom_toBottomOf="@+id/imageView19"
            app:layout_constraintStart_toEndOf="@+id/imageView19"
            app:layout_constraintTop_toTopOf="@+id/imageView19"
            tools:text="2500" />

        <ImageView
            android:id="@+id/imageView19"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginTop="6dp"
            android:src="@drawable/ic_distance"
            app:layout_constraintStart_toStartOf="@+id/textDistance"
            app:layout_constraintTop_toBottomOf="@+id/textDistance" />

        <TextView
            android:id="@+id/tvDistanceGoal"
            style="@style/Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white_80"
            app:layout_constraintBaseline_toBaselineOf="@id/tvDistanceCurrent"
            app:layout_constraintBottom_toBottomOf="@+id/tvDistanceCurrent"
            app:layout_constraintStart_toEndOf="@+id/tvDistanceCurrent"
            tools:text="/2500" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>