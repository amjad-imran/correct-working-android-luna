<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <include
            android:id="@+id/lytHourMin"
            layout="@layout/layout_hour_min_sleep_contri"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <View
            android:id="@+id/viewTextBack"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="-4dp"
            android:layout_marginEnd="-4dp"
            android:alpha="0.2"
            app:layout_constraintBottom_toBottomOf="@+id/tvRangeValue"
            app:layout_constraintEnd_toEndOf="@+id/tvRangeValue"
            app:layout_constraintStart_toStartOf="@+id/tvRangeValue"
            app:layout_constraintTop_toTopOf="@+id/tvRangeValue"
            tools:background="@drawable/back_hm_optimal" />

        <TextView
            android:id="@+id/tvRangeValue"
            style="@style/S12"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="4dp"
            android:drawablePadding="4dp"
            android:padding="2dp"
            android:textColor="#29cc74"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/lytHourMin"
            tools:drawableStart="@drawable/ic_hm_tick"
            tools:text="wihtin 56 -sdfsdfsdf 58" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>