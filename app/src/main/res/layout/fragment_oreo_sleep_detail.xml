<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:lineChart="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:background="@color/black">


        <ScrollView
            android:id="@+id/svMain"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:visibility="visible">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/lytToolbar">



                <ImageView
                    android:id="@+id/imageView48"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:src="@drawable/sleep_back_top"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:background="@drawable/back_stick_bottom"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/imageView48" />
                <include
                    android:id="@+id/lytToolbar"
                    layout="@layout/oreo_layout_toolbar_with_2_icons"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
                <com.oreo.ui.custom.LineChart
                    android:id="@+id/rvTopGraph"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/lytToolbar"
                    lineChart:bgBottomColor="@android:color/transparent"
                    lineChart:bgColor="@android:color/transparent"
                    lineChart:bgLeftColor="@android:color/transparent"
                    lineChart:bgRightColor="@android:color/transparent"
                    lineChart:bgTopColor="@android:color/transparent"
                    lineChart:bottomWith="30dp"
                    lineChart:centerLineColor="@color/white_80"
                    lineChart:centerLineWidth="3dp"
                    lineChart:chartLineColor="#d8b4ff"
                    lineChart:chartLineWidth="2dp"
                    lineChart:fillColorEnd="#00aa5bff"
                    lineChart:fillColorStart="#4caa5bff"
                    lineChart:gridColor="@color/white_12"
                    lineChart:hCount="11"
                    lineChart:innerCircleColor="#ffffff"
                    lineChart:innerCircleRadius="4dp"
                    lineChart:leftWith="0dp"
                    lineChart:outCircleColor="#66aa5bff"
                    lineChart:outCircleRadius="1dp"
                    lineChart:rightWith="0dp"
                    lineChart:scaleColor="#ff000000"
                    lineChart:scaleLenth="4dp"
                    lineChart:scaleNodeColor="#FFFFFF"
                    lineChart:scaleNodeRadius="6dp"
                    lineChart:showGrid="true"
                    lineChart:topWith="40dp"
                    lineChart:vCount="2"
                    lineChart:xLineColor="#80FFFFFF"
                    lineChart:xMax="130"
                    lineChart:xMin="0"
                    lineChart:xTextColor="#FFFFFF"
                    lineChart:xTextSize="12sp"
                    lineChart:yLineColor="#00FFFFFF"
                    lineChart:yTextSize="12sp" />


                <include
                    android:id="@+id/lytSleepScore"
                    layout="@layout/oreo_layout_sleep_score_subdata"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/side_margin"
                    android:layout_marginTop="24dp"
                    android:layout_marginEnd="@dimen/side_margin"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/rvTopGraph" />

                <include
                    android:id="@+id/divider11"
                    layout="@layout/layout_divider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    app:layout_constraintTop_toBottomOf="@id/lytSleepScore" />

                <include
                    android:id="@+id/lytSleepContributor"
                    layout="@layout/oreo_layout_sleep_contributors"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/side_margin"
                    android:layout_marginTop="32dp"
                    android:layout_marginEnd="@dimen/side_margin"
                    app:layout_constraintTop_toBottomOf="@+id/divider11" />

                <include
                    android:id="@+id/divider22"
                    layout="@layout/layout_divider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="32dp"
                    app:layout_constraintTop_toBottomOf="@id/lytSleepContributor" />


                <include
                    android:id="@+id/lytSSAnalysis"
                    layout="@layout/oreo_layout_sleep_stage_analysis"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@+id/divider22" />

                <!--                <include-->
                <!--                    android:id="@+id/divider2"-->
                <!--                    layout="@layout/layout_divider"-->
                <!--                    android:layout_width="match_parent"-->
                <!--                    android:layout_height="1dp"-->
                <!--                    android:layout_marginTop="16dp"-->
                <!--                    app:layout_constraintTop_toBottomOf="@id/lytSSAnalysis" />-->

                <!--                <include-->
                <!--                    android:id="@+id/lytNightMovement"-->
                <!--                    layout="@layout/oreo_layout_sleep_night_time_meovement"-->
                <!--                    android:layout_width="match_parent"-->
                <!--                    android:layout_height="wrap_content"-->
                <!--                    app:layout_constraintEnd_toEndOf="parent"-->
                <!--                    app:layout_constraintStart_toStartOf="parent"-->
                <!--                    app:layout_constraintTop_toBottomOf="@+id/divider2" />-->

                <include
                    android:id="@+id/divider3"
                    layout="@layout/layout_divider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="32dp"
                    app:layout_constraintTop_toBottomOf="@id/lytSSAnalysis" />

                <include
                    android:id="@+id/lytHeartRate"
                    layout="@layout/oreo_layout_sleep_movement"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/divider3" />

                <include
                    android:id="@+id/divider4"
                    layout="@layout/layout_divider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="32dp"
                    app:layout_constraintTop_toBottomOf="@id/lytHeartRate" />

                <include
                    android:id="@+id/lytHRVariability"
                    layout="@layout/oreo_layout_sleep_movement"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/divider4" />

                <include
                    android:id="@+id/divider5"
                    layout="@layout/layout_divider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="32dp"
                    app:layout_constraintTop_toBottomOf="@id/lytHRVariability" />


            </androidx.constraintlayout.widget.ConstraintLayout>
        </ScrollView>

        <include
            android:id="@+id/progressBar1"
            layout="@layout/default_loader"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>