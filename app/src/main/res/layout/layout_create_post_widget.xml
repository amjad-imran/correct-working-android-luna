<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <View
        android:id="@+id/vPostAdd"
        android:background="@drawable/back_primary_btn_highlight_10"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_40dp"
        android:layout_marginStart="@dimen/dimen_16dp"
        android:layout_marginEnd="@dimen/dimen_16dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textView29"
        style="@style/H6"
        android:layout_width="0dp"
        android:fontFamily="@font/gilroy_regular"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dimen_16dp"
        android:layout_marginEnd="@dimen/dimen_16dp"
        android:text="@string/text_what_s_on_your_mind"
        app:layout_constraintBottom_toBottomOf="@+id/vPostAdd"
        app:layout_constraintEnd_toEndOf="@+id/vPostAdd"
        app:layout_constraintStart_toStartOf="@+id/vPostAdd"
        app:layout_constraintTop_toTopOf="@+id/vPostAdd" />

</androidx.constraintlayout.widget.ConstraintLayout>