<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:id="@+id/layoutParent"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/tvHeartTitle"
        style="@style/H4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/side_margin"
        android:layout_marginTop="@dimen/dimen_16dp"
        android:layout_marginEnd="@dimen/side_margin"
        android:text="@string/heart_rate"
        android:textColor="@color/very_light_pink"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvAverageTitle"
        style="@style/Small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="25dp"
        android:layout_marginTop="20dp"
        android:text="@string/text_minimum"
        android:textColor="#ed54a7"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvHeartTitle" />

    <TextView
        android:id="@+id/tvHeartAvgValue"
        style="@style/H2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="25dp"
        android:layout_marginTop="5dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvAverageTitle"
        tools:text="96" />

    <TextView
        android:id="@+id/tvUnit"
        style="@style/Small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:layout_marginTop="5dp"
        android:text="@string/unit_bpm"
        app:layout_constraintBottom_toBottomOf="@+id/tvHeartAvgValue"
        app:layout_constraintStart_toEndOf="@+id/tvHeartAvgValue"
        app:layout_constraintTop_toBottomOf="@id/tvAverageTitle" />

    <TextView
        android:id="@+id/tvMaximumTitle"
        style="@style/Small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="33dp"
        android:layout_marginTop="20dp"
        android:text="@string/maximum"
        android:textColor="#ed54a7"
        app:layout_constraintStart_toEndOf="@+id/tvAverageTitle"
        app:layout_constraintTop_toBottomOf="@id/tvHeartTitle" />

    <TextView
        android:id="@+id/tvHeartMaxValue"
        style="@style/H2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="55dp"
        android:layout_marginTop="5dp"
        app:layout_constraintStart_toEndOf="@+id/tvHeartAvgValue"
        app:layout_constraintTop_toBottomOf="@id/tvAverageTitle"
        tools:text="96" />

    <TextView
        android:id="@+id/tvMaxUnit"
        style="@style/Small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:layout_marginTop="5dp"
        android:text="@string/unit_bpm"
        app:layout_constraintBottom_toBottomOf="@+id/tvHeartMaxValue"
        app:layout_constraintStart_toEndOf="@+id/tvHeartMaxValue"
        app:layout_constraintTop_toBottomOf="@id/tvMaximumTitle" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/containerMpChart"
        style="@style/ModalStyleNew"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/side_margin"
        android:layout_marginTop="@dimen/dimen_24dp"
        android:layout_marginEnd="@dimen/side_margin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvMaxUnit">

        <com.github.mikephil.charting.charts.LineChart
            android:id="@+id/lineChart"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_margin="@dimen/dimen_16dp"
            app:layout_constraintTop_toTopOf="parent"
            tools:layout_editor_absoluteX="16dp" />


        <TextView
            android:id="@+id/tvHrStartTime"
            style="@style/Tinny"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimen_16dp"
            android:layout_marginBottom="@dimen/dimen_24dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@+id/lineChart"
            app:layout_constraintTop_toBottomOf="@id/lineChart"
            tools:text="11:53 am" />

        <TextView
            android:id="@+id/tvHrEndTime"
            style="@style/Tinny"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/side_margin"
            android:layout_marginBottom="@dimen/dimen_24dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/lineChart"
            app:layout_constraintTop_toBottomOf="@id/lineChart"
            tools:text="11:53 am" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>