<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">


    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/backLayer"
        android:layout_width="0dp"
        android:layout_height="16dp"
        android:layout_marginEnd="2dp"
        tools:background="#00FF66"
        app:layout_constraintBottom_toBottomOf="@+id/tvPercent"
        app:layout_constraintEnd_toStartOf="@+id/textView154"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvPercent"
        app:shapeAppearance="@style/ShapeAppearanceOverlay.App.CornerSize4dp" />

    <ImageView
        android:id="@+id/ivTrend"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvPercent"
        style="@style/S10"
        android:fontFamily="@font/gilroy_medium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/ivTrend"
        app:layout_constraintStart_toEndOf="@+id/ivTrend"
        app:layout_constraintTop_toTopOf="@+id/ivTrend"
        tools:text="7%" />

    <TextView
        android:id="@+id/textView154"
        style="@style/S10"
        android:fontFamily="@font/gilroy_medium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:text="@string/text_since_value_mins"
        android:textColor="#B3FFFFFF"
        app:layout_constraintBaseline_toBaselineOf="@+id/tvPercent"
        app:layout_constraintStart_toEndOf="@+id/tvPercent"
        app:layout_constraintTop_toTopOf="@+id/tvPercent" />

</androidx.constraintlayout.widget.ConstraintLayout>