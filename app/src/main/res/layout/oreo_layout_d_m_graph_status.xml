<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.imageview.ShapeableImageView
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:id="@+id/viewHigh"
            app:layout_constraintStart_toStartOf="parent"
            app:shapeAppearance="@style/ShapeAppearance.App.CircleImageView"
            app:layout_constraintTop_toTopOf="@id/tvHigh"
            app:layout_constraintBottom_toBottomOf="@id/tvHigh"
            android:layout_marginStart="45dp"
            android:background="@color/white"/>

        <TextView
            android:id="@+id/tvHigh"
            style="@style/Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/text_high"
            android:textColor="@color/white_80"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/viewHigh"
            app:layout_constraintTop_toTopOf="parent" />
        <com.google.android.material.imageview.ShapeableImageView
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:id="@+id/viewMedium"
            app:shapeAppearance="@style/ShapeAppearance.App.CircleImageView"
            app:layout_constraintTop_toTopOf="@id/tvMed"
            android:layout_marginEnd="8dp"
            android:background="@color/medium_movement"
            app:layout_constraintBottom_toBottomOf="@id/tvMed"
            app:layout_constraintEnd_toStartOf="@id/tvMed"/>

        <TextView
            android:id="@+id/tvMed"
            style="@style/Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/text_medium"
            android:textColor="@color/white_80"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/tvHigh"
            app:layout_constraintEnd_toStartOf="@id/tvLow"
            app:layout_constraintTop_toTopOf="parent" />
        <com.google.android.material.imageview.ShapeableImageView
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:id="@+id/viewLow"
            app:shapeAppearance="@style/ShapeAppearance.App.CircleImageView"
            app:layout_constraintTop_toTopOf="@id/tvLow"
            android:background="@color/low_movement"
            app:layout_constraintBottom_toBottomOf="@id/tvLow"
            app:layout_constraintEnd_toStartOf="@id/tvLow"
            android:layout_marginEnd="8dp"/>
        <TextView
            android:id="@+id/tvLow"
            style="@style/Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/text_low"
            android:textColor="@color/white_80"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/tvMed"
            app:layout_constraintEnd_toStartOf="@id/tvInactive"
            app:layout_constraintTop_toTopOf="parent" />
        <com.google.android.material.imageview.ShapeableImageView
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@color/inactive_movement"
            app:shapeAppearance="@style/ShapeAppearance.App.CircleImageView"
            android:layout_marginEnd="8dp"
            android:id="@+id/viewInactive"
            app:layout_constraintTop_toTopOf="@id/tvInactive"
            app:layout_constraintBottom_toBottomOf="@id/tvInactive"
            app:layout_constraintEnd_toStartOf="@id/tvInactive"/>
        <TextView
            android:id="@+id/tvInactive"
            style="@style/Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/text_inactive"
            android:textColor="@color/white_80"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginEnd="45dp"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>