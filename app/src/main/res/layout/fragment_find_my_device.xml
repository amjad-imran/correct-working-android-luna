<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".ui.dashboard.feature.findmydevice.FindMyDeviceFragment">

        <include
            android:id="@+id/lytToolbarWithDetails"
            layout="@layout/layout_toolbar_with_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/vBackWatch"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@color/modal_color"
            app:layout_constraintBottom_toBottomOf="@+id/animateView"
            app:layout_constraintEnd_toEndOf="@+id/animateView"
            app:layout_constraintStart_toStartOf="@+id/animateView"
            app:layout_constraintTop_toTopOf="@+id/animateView"
            app:shapeAppearance="@style/ShapeAppearance.App.CircleImageView" />

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/animateView"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_marginTop="@dimen/dimen_56dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/lytToolbarWithDetails"
            app:lottie_autoPlay="true"
            app:lottie_repeatCount="1" />

        <ImageView
            android:id="@+id/ivWatchFace"
            android:layout_width="60dp"
            android:layout_height="60dp"
            app:layout_constraintBottom_toBottomOf="@+id/animateView"
            app:layout_constraintEnd_toEndOf="@+id/animateView"
            app:layout_constraintStart_toStartOf="@+id/animateView"
            app:layout_constraintTop_toTopOf="@+id/animateView"
            tools:src="@drawable/ic_ring_default_silver" />
<!--
        <include
            android:id="@+id/lScanning"
            layout="@layout/layout_scan_watch"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_marginTop="@dimen/dimen_56dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/lytToolbarWithDetails" />-->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bSearchStop"
            style="@style/SecondaryButtonStyle"
            android:layout_width="0dp"
            android:layout_marginStart="@dimen/side_margin"
            android:layout_marginEnd="@dimen/side_margin"
            android:layout_marginBottom="@dimen/bottom_margin"
            android:text="@string/text_stop_searching"
            android:visibility="gone"
            app:backgroundTint="@null"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bSearch"
            style="@style/PrimaryButtonStyle"
            android:layout_width="0dp"
            android:layout_marginStart="@dimen/side_margin"
            android:layout_marginEnd="@dimen/side_margin"
            android:layout_marginBottom="@dimen/bottom_margin"
            android:text="@string/text_search"
            app:backgroundTint="@null"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>