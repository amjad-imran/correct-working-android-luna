<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tvTitle"
            style="@style/Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Stressed" />

        <include
            android:id="@+id/lytUnit"
            layout="@layout/oreo_layout_top_hour_mn_20"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTitle" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/constraintLayout7"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dimen_16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/lytUnit"
            android:background="@drawable/back_white_16"
            android:padding="@dimen/dimen_4dp">

            <ImageView
                android:id="@+id/icTrend"
                android:layout_width="10dp"
                android:layout_height="10dp"
                tools:src="@drawable/ic_arrow_up_with_corner"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />


            <TextView
                android:id="@+id/tvDifference"
                style="@style/Tinny"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="5 %"
                app:layout_constraintBottom_toBottomOf="@+id/icTrend"
                app:layout_constraintStart_toEndOf="@+id/icTrend"
                app:layout_constraintTop_toTopOf="@+id/icTrend" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>