<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tvDateTime"
            style="@style/H6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white_48"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="23 April - 30 May, 2024" />

        <TextView
            android:id="@+id/tvScore"
            style="@style/H2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textSize="28sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvDateTime"
            tools:text="50" />

        <TextView
            android:id="@+id/tvUnit"
            style="@style/H5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:textColor="@color/white_48"
            app:layout_constraintBottom_toBottomOf="@id/tvScore"
            app:layout_constraintStart_toEndOf="@id/tvScore"
            tools:text="bpm - average" />

        <View
            android:id="@+id/viewHighlight"
            android:layout_width="110dp"
            android:layout_height="20dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/back_hm_range"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvUnit" />

        <TextView
            android:id="@+id/tvRangeValue"
            style="@style/Small"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/ic_hm_tick"
            android:drawablePadding="4dp"
            android:padding="4dp"
            android:textColor="#29cc74"
            app:layout_constraintBottom_toBottomOf="@id/viewHighlight"
            app:layout_constraintEnd_toEndOf="@id/viewHighlight"
            app:layout_constraintStart_toStartOf="@id/viewHighlight"
            app:layout_constraintTop_toTopOf="@id/viewHighlight"
            tools:ignore="UseCompatTextViewDrawableXml"
            tools:text="wihtin 56 - 58" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivCircle"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="6dp"
            android:background="#33a3eeff"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/tvOptimalRangeLabel"
            app:layout_constraintEnd_toStartOf="@id/tvOptimalRangeLabel"
            app:layout_constraintTop_toTopOf="@id/tvOptimalRangeLabel"
            app:shapeAppearance="@style/ShapeAppearance.App.CircleImageView"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tvOptimalRangeLabel"
            style="@style/Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white_48"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/viewHighlight"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/viewHighlight"
            tools:text="Optimal range"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tvDesc"
            style="@style/H6"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textColor="@color/white_80"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/viewHighlight"
            tools:text="Your resting HR seems to be higher than previous day. Allow yourself sufficient time for recovery by taking it slow." />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>