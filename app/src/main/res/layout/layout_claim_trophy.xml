<?xml version="1.0" encoding="utf-8"?>
<layout>

    <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/back_claim_trophy">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:alpha="0.6"
        style="@style/Tinny"
        android:text="@string/text_new_trophy_earned"
        android:textSize="10sp"
        android:layout_marginStart="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/ivTrophyImage"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <ImageView
        android:id="@+id/ivTrophyNotification"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:background="@drawable/back_trophy_notification_small"
        app:layout_constraintBottom_toTopOf="@+id/ivTrophyImage"
        app:layout_constraintEnd_toEndOf="@+id/ivTrophyImage"
        app:layout_constraintStart_toEndOf="@+id/ivTrophyImage"
        app:layout_constraintTop_toTopOf="@+id/ivTrophyImage" />

</androidx.constraintlayout.widget.ConstraintLayout>
</layout>