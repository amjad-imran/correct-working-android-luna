    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".ui.home.summary.OSummaryFragment">

        <include
            android:id="@+id/lytHeader"
            layout="@layout/layout_o_summary_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.oreo.ui.custom.TabLayoutCustom
            android:id="@+id/tabLayout"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/lytHeader"
            lineChart:bgBottomColor="@android:color/transparent"
            lineChart:bgColor="@android:color/transparent"
            lineChart:bgLeftColor="@android:color/transparent"
            lineChart:bgRightColor="@android:color/transparent"
            lineChart:bgTopColor="@android:color/transparent"
            lineChart:bottomWith="30dp"
            lineChart:centerLineColor="@color/white_80"
            lineChart:centerLineWidth="3dp"
            lineChart:chartLineColor="@color/sleep_chart_line_color"
            lineChart:chartLineWidth="2dp"
            lineChart:fillColorEnd="@color/sleep_fill_end_color"
            lineChart:fillColorStart="@color/sleep_fill_start_color"
            lineChart:gridColor="@color/white_12"
            lineChart:hCount="11"
            lineChart:innerCircleColor="#e9d4ff"
            lineChart:innerCircleRadius="4dp"
            lineChart:leftWith="0dp"
            lineChart:outCircleColor="#66aa5bff"
            lineChart:outCircleRadius="1dp"
            lineChart:rightWith="0dp"
            lineChart:scaleColor="#ff000000"
            lineChart:scaleLenth="4dp"
            lineChart:scaleNodeColor="#FFFFFF"
            lineChart:scaleNodeRadius="6dp"
            lineChart:showGrid="true"
            lineChart:topWith="40dp"
            lineChart:vCount="2"
            lineChart:xLineColor="#80FFFFFF"
            lineChart:xMax="130"
            lineChart:xMin="0"
            lineChart:xTextColor="#FFFFFF"
            lineChart:xTextSize="12sp"
            lineChart:yLineColor="#00FFFFFF"
            lineChart:yTextSize="12sp"


            />

        <!--<com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayout"
