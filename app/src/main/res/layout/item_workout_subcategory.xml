<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">


    <com.google.android.material.card.MaterialCardView
        android:layout_width="280dp"
        android:layout_height="240dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="14dp"
        app:cardBackgroundColor="#0affffff"
        app:cardCornerRadius="10dp"
        app:strokeColor="#19ffffff"
        app:strokeWidth="1dp">


        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/ivBanner"
                android:layout_width="match_parent"
                android:layout_height="170dp"
                android:layout_marginStart="1dp"
                android:layout_marginEnd="1dp"
                android:scaleType="centerCrop"
                android:src="@drawable/bg_dummy_placeholder"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:ignore="ContentDescription" />

            <include
                android:id="@+id/lytTrackTime"
                layout="@layout/layout_content_track_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="12dp"
                app:layout_constraintEnd_toEndOf="@id/ivBanner"
                app:layout_constraintTop_toTopOf="@id/ivBanner" />

            <include
                android:id="@+id/lytTrackPlayState"
                layout="@layout/layout_content_track_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="12dp"
                android:visibility="gone"
                android:layout_marginBottom="9dp"
                app:layout_constraintBottom_toBottomOf="@id/ivBanner"
                app:layout_constraintStart_toStartOf="@id/ivBanner" />

            <TextView
                android:id="@+id/tvTitle"
                style="@style/Small"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="12dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:layout_marginEnd="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/ivBanner"
                tools:text="High Intensity Workout" />

            <TextView
                android:id="@+id/tvTag1"
                style="@style/Tinny"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/side_margin"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                tools:text="Legs"
                android:textColor="@color/white_48"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvTitle" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imageView1"
                android:layout_width="4dp"
                android:layout_height="4dp"
                android:layout_marginStart="8dp"
                android:background="#aa5bff"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="@id/tvTag1"
                app:layout_constraintStart_toEndOf="@id/tvTag1"
                app:layout_constraintTop_toTopOf="@id/tvTag1"
                app:shapeAppearance="@style/ShapeAppearance.Material3.SmallComponent"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/tvTag2"
                style="@style/Tinny"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:textColor="@color/white_48"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/tvViewsCount"
                app:layout_constraintStart_toEndOf="@id/imageView1"
                app:layout_constraintTop_toBottomOf="@id/tvTitle"
                tools:text="Conditioning" />

            <TextView
                android:id="@+id/tvViewsCount"
                style="@style/Tinny"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="@dimen/side_margin"
                tools:text="250 views"
                android:textColor="@color/white_64"
                app:layout_constraintBottom_toBottomOf="@+id/tvTag2"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/tvTag2" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
</layout>