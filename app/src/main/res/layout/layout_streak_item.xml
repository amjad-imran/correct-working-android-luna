<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tvTitle1"
            style="@style/Small"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textColor="@color/white_64"
            app:layout_constraintEnd_toStartOf="@id/tvTitle2"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:text="@string/text_streak" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivStreak1"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="5dp"
            android:visibility="visible"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTitle1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:srcCompat="@drawable/ic_streak" />

        <TextView
            android:id="@+id/tvCurrentStreakDays"
            style="@style/H3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="@id/ivStreak1"
            app:layout_constraintStart_toEndOf="@id/ivStreak1"
            app:layout_constraintTop_toTopOf="@id/ivStreak1"
            tools:text="32 days" />

        <TextView
            android:id="@+id/tvTitle2"
            style="@style/Small"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textColor="@color/white_64"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/tvTitle1"
            app:layout_constraintTop_toTopOf="parent"
            android:text="@string/text_daily_reward" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivStreak2"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="5dp"
            app:layout_constraintStart_toStartOf="@id/tvTitle2"
            app:layout_constraintTop_toBottomOf="@id/tvTitle2"
            app:srcCompat="@drawable/ic_bitcoin_completed" />

        <TextView
            android:id="@+id/tvDailyReward"
            style="@style/H3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="@id/ivStreak2"
            app:layout_constraintStart_toEndOf="@id/ivStreak2"
            app:layout_constraintTop_toTopOf="@id/ivStreak2"
            tools:text="32 days" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
