<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <View
        android:id="@+id/vBack"
        android:layout_width="0dp"
        android:layout_height="16dp"
        android:background="@drawable/back_progress_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/pbSteps"
        android:layout_width="0dp"
        android:layout_height="4dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:progress="40"
        app:indicatorColor="@color/blood_oxygen_color"
        app:layout_constraintBottom_toBottomOf="@+id/vBack"
        app:layout_constraintEnd_toEndOf="@+id/vBack"
        app:layout_constraintStart_toStartOf="@+id/vBack"
        app:layout_constraintTop_toTopOf="@+id/vBack"
        app:trackColor="@color/progress_track_color"
        app:trackCornerRadius="2dp"
        app:trackThickness="4dp" />


</androidx.constraintlayout.widget.ConstraintLayout>