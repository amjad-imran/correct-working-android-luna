<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/tvTeam1"
        style="@style/H6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        tools:text="CSK"
        android:textSize="12sp"
        app:layout_constraintStart_toEndOf="@id/lytTeam1"
        app:layout_constraintTop_toTopOf="@id/lytTeam1" />
    <TextView
        android:id="@+id/tvWon"
        style="@style/H6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="@string/text_won"
        android:textColor="#29cc74"
        android:layout_marginTop="4dp"
        app:layout_constraintStart_toEndOf="@id/lytTeam1"
        app:layout_constraintBottom_toBottomOf="@id/lytTeam1"
        app:layout_constraintTop_toBottomOf="@id/tvTeam1" />

    <include
        android:id="@+id/lytTeam1"
        layout="@layout/layout_win_circle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/side_margin"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <TextView
        android:id="@+id/tvTeam2"
        style="@style/H6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        tools:text="RCB"
        android:textSize="12sp"
        android:textColor="@color/white_48"
        app:layout_constraintEnd_toStartOf="@id/lytTeam2"
        app:layout_constraintTop_toTopOf="@id/lytTeam2" />
    <TextView
        android:id="@+id/tvLost"
        style="@style/H6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:text="@string/text_lost"
        android:layout_marginTop="4dp"
        android:textColor="@color/white_48"
        app:layout_constraintBottom_toBottomOf="@id/lytTeam2"
        app:layout_constraintEnd_toStartOf="@id/lytTeam2"
        app:layout_constraintTop_toBottomOf="@+id/tvTeam2" />

    <include
        android:id="@+id/lytTeam2"
        layout="@layout/layout_win_circle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/side_margin"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="@dimen/side_margin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        style="@style/H4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/text_vs"
        android:textAllCaps="true"
        android:textColor="@color/accent_color_purple"
        app:layout_constraintBottom_toBottomOf="@id/lytTeam1"
        app:layout_constraintEnd_toStartOf="@id/lytTeam2"
        app:layout_constraintStart_toEndOf="@id/lytTeam1"
        app:layout_constraintTop_toTopOf="@id/lytTeam1" />




    <TextView
        android:id="@+id/bPredictWinner"
        style="@style/PrimaryButtonStyleHighlight2"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginStart="@dimen/side_margin"
        android:layout_marginTop="40dp"
        android:layout_marginEnd="@dimen/side_margin"
        android:layout_marginBottom="@dimen/side_margin"
        android:gravity="center"
        android:text="@string/text_collect_your_reward"
        android:textAllCaps="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:backgroundTint="@null"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/lytTeam1" />

</androidx.constraintlayout.widget.ConstraintLayout>