<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/back_modal_new">

    <TextView
        android:id="@+id/tvLabel"
        style="@style/Small"
        android:layout_width="wrap_content"
        android:layout_marginTop="@dimen/side_margin"
        android:layout_marginStart="@dimen/side_margin"
        android:layout_height="wrap_content"
        android:text="@string/text_sleep_duration"
        android:textColor="@color/white_64"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvHour"
        style="@style/H4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="@dimen/side_margin"
        android:includeFontPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/tvLabel"
        app:layout_constraintTop_toBottomOf="@id/tvLabel"
        tools:text="8" />

    <TextView
        android:id="@+id/tvHourUnit"
        style="@style/H5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:text="@string/text_hr_lower"
        android:textColor="@color/white_64"
        app:layout_constraintBaseline_toBaselineOf="@id/tvHour"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tvHour" />

    <TextView
        android:id="@+id/tvMinute"
        style="@style/H4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:includeFontPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="16dp"
        app:layout_constraintStart_toEndOf="@id/tvHourUnit"
        app:layout_constraintTop_toBottomOf="@+id/tvLabel"
        tools:text="30" />

    <TextView
        android:id="@+id/tvMinuteUnit"
        style="@style/H5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:text="@string/text_mins"
        android:textColor="@color/white_64"
        app:layout_constraintBaseline_toBaselineOf="@+id/tvMinute"
        app:layout_constraintStart_toEndOf="@+id/tvMinute" />
</androidx.constraintlayout.widget.ConstraintLayout>