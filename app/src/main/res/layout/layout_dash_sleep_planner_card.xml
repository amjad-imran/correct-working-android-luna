<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@drawable/back_modal_dialog_new"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imvBack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:minHeight="315dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearance="@style/ShapeAppearanceOverlay.App.CornerSize10dp" />

    <TextView
        android:id="@+id/textView1"
        style="@style/H5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/side_margin"
        android:layout_marginTop="18dp"
        app:layout_constraintStart_toStartOf="@id/imvBack"
        app:layout_constraintTop_toTopOf="@id/imvBack"
        android:text="@string/text_sleep_planner" />

    <ImageView
        android:id="@+id/ivMore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/side_margin"
        android:src="@drawable/ic_sp_frwrd_arrow"
        app:layout_constraintBottom_toBottomOf="@id/textView1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/textView1"
        tools:ignore="ContentDescription" />

    <View
        android:id="@+id/view1"
        android:layout_width="126dp"
        android:layout_height="126dp"
        android:layout_marginTop="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ivMore" />

    <include
        android:id="@+id/lytBedTime"
        layout="@layout/layout_sa_top_view_sub_item"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/side_margin"
        app:layout_constraintBottom_toBottomOf="@id/view1"
        app:layout_constraintStart_toStartOf="parent" />

    <include
        android:id="@+id/lytWakeupTime"
        layout="@layout/layout_sa_top_view_sub_item"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/side_margin"
        app:layout_constraintBottom_toBottomOf="@id/view1"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvMsg"
        style="@style/H6"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/side_margin"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="@dimen/side_margin"
        android:gravity="center_horizontal"
        android:lineSpacingExtra="3sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/view1"
        android:text="Your ideal bedtime for today is 11:20 pm to achieve 100% of sleep goal " />

    <include
        android:id="@+id/divider1"
        layout="@layout/layout_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvMsg" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/side_margin"
        android:layout_marginTop="21dp"
        android:layout_marginBottom="24dp"
        style="@style/H6"
        android:textColor="#88b0ff"
        android:id="@+id/tvSetUpAlarm"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/divider1"
        android:text="@string/text_set_up_alarm" />
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/ivAlarmMore"
        android:src="@drawable/ic_sa_frwrd_arrow"
        android:layout_marginEnd="@dimen/side_margin"
        app:layout_constraintTop_toTopOf="@id/tvSetUpAlarm"
        app:layout_constraintBottom_toBottomOf="@id/tvSetUpAlarm"
        app:layout_constraintEnd_toEndOf="parent"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/gilroy_medium"
        android:textStyle="normal"
        android:textSize="14sp"
        android:id="@+id/tvAlarmTime"
        android:visibility="gone"
        tools:visibility="visible"
        android:layout_marginEnd="12dp"
        app:layout_constraintTop_toTopOf="@id/ivAlarmMore"
        app:layout_constraintEnd_toStartOf="@id/ivAlarmMore"
        app:layout_constraintBottom_toBottomOf="@id/ivAlarmMore"
        android:textColor="#88b0ff"
        android:lineSpacingExtra="6sp"
        tools:text="7:30am"/>

</androidx.constraintlayout.widget.ConstraintLayout>