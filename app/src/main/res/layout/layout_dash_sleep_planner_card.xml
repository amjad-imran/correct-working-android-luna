<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imv"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_dash_card_sp_back"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearance="@style/ShapeAppearanceOverlay.App.CornerSize10dp" />

    <TextView
        android:id="@+id/textView1"
        style="@style/H5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/side_margin"
        android:layout_marginTop="18dp"
        android:text="@string/text_sleep_planner"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/ivMore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/side_margin"
        android:src="@drawable/ic_sp_frwrd_arrow"
        app:layout_constraintBottom_toBottomOf="@id/textView1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/textView1"
        tools:ignore="ContentDescription" />

    <com.oreo.ui.custom.RoundClockViewDash
        android:id="@+id/clock"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="6dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="6dp"
        app:background_image_main="@drawable/image_back_planner_2"
        app:image_dial="@drawable/image_dial_planner"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toStartOf="@id/lytWakeupTime"
        app:layout_constraintStart_toEndOf="@id/lytBedTime"
        app:layout_constraintTop_toBottomOf="@id/ivMore" />

    <TextView
        android:id="@+id/tvDuration"
        style="@style/S28"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/textDuration"
        app:layout_constraintEnd_toEndOf="@+id/clock"
        app:layout_constraintStart_toStartOf="@+id/clock"
        app:layout_constraintTop_toTopOf="@+id/clock"
        app:layout_constraintVertical_chainStyle="packed"
        tools:text="8:04" />

    <TextView
        android:id="@+id/textDuration"
        style="@style/S12"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/gilroy_medium"
        android:gravity="center"
        android:text="@string/text_sleep_nduration"
        android:lineSpacingExtra="3sp"
        android:textColor="#D5B7FF"
        app:layout_constraintBottom_toBottomOf="@+id/clock"
        app:layout_constraintEnd_toEndOf="@+id/clock"
        app:layout_constraintStart_toStartOf="@+id/clock"
        app:layout_constraintTop_toBottomOf="@+id/tvDuration" />

    <include
        android:id="@+id/lytBedTime"
        layout="@layout/layout_sa_top_view_sub_item"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/side_margin"
        app:layout_constraintBottom_toBottomOf="@id/clock"
        app:layout_constraintStart_toStartOf="parent" />

    <include
        android:id="@+id/lytWakeupTime"
        layout="@layout/layout_sa_top_view_sub_item"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/side_margin"
        app:layout_constraintBottom_toBottomOf="@id/clock"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvMsg"
        style="@style/S14"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/side_margin"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="@dimen/side_margin"
        android:alpha="0.72"
        android:gravity="center_horizontal"
        android:lineSpacingExtra="3sp"
        android:paddingBottom="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/clock"
        tools:text="Your ideal bedtime for today is 11:20 pm to achieve 100% of sleep goal " />

    <include
        android:id="@+id/divider1"
        layout="@layout/layout_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/tvMsg"
        tools:visibility="visible" />

    <include
        android:id="@+id/lytSetAlarm"
        layout="@layout/layout_dash_sp_alarm_sub_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/divider1"
        tools:visibility="visible" />

    <include
        android:id="@+id/lytBreathe"
        layout="@layout/layout_dash_sp_sub_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/side_margin"
        android:layout_marginEnd="@dimen/side_margin"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/lytSetAlarm"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>