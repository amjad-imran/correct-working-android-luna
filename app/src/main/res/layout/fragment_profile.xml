<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />

        <variable
            name="viewModel"
            type="com.noisefit.ui.profile.ProfileViewModel" />

    </data>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".ui.settings.profile.ProfileFragment">

        <RelativeLayout
            android:id="@+id/relativeLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical|center_horizontal|center"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.0">

            <ImageButton
                android:id="@+id/backBtn"
                style="@style/ToolbarBackButton"
                android:layout_alignParentStart="true"
                android:layout_centerInParent="true"
                android:layout_gravity="center_vertical"
                android:layout_margin="@dimen/side_margin"
                android:contentDescription="@string/text_back" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/text_view_title"
                style="@style/H4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/my_profile_page_title"
                android:textSize="@dimen/text_18sp"
                tools:ignore="RelativeOverlap" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvEdit"
                style="@style/H5"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_width="54dp"
                android:gravity="end"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerInParent="true"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="24dp"
                android:padding="10dp"
                android:text="@string/edit"
                android:textColor="@color/white_64"
                tools:ignore="RelativeOverlap" />

        </RelativeLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/nestedScrollView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/relativeLayout">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivUserImage"
                    profileImage="@{viewModel.user.imageUrl}"
                    android:layout_width="99dp"
                    android:layout_height="99dp"
                    android:layout_marginTop="@dimen/dimen_40dp"
                    android:scaleType="centerCrop"
                    android:transitionName="profilePic"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:shapeAppearance="@style/ShapeAppearance.App.CircleImageView"
                    app:srcCompat="@drawable/ic_default_profile_image" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tvBuddiesValue"
                    style="@style/H5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_16dp"
                    android:textColor="@color/white"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="@+id/tvBuddiesLabel"
                    app:layout_constraintStart_toStartOf="@+id/tvBuddiesLabel"
                    app:layout_constraintTop_toBottomOf="@+id/ivUserImage"
                    tools:text="08" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tvBuddiesLabel"
                    style="@style/Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_8dp"
                    android:layout_marginEnd="40dp"
                    android:text="@string/buddies"
                    android:textColor="@color/white"
                    android:visibility="gone"
                    app:layout_constraintEnd_toStartOf="@+id/tvBadgeLabel"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvBuddiesValue" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tvBadgeValue"
                    style="@style/H5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_16dp"
                    android:textColor="@color/white"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="@+id/tvBadgeLabel"
                    app:layout_constraintStart_toStartOf="@+id/tvBadgeLabel"
                    app:layout_constraintTop_toBottomOf="@+id/ivUserImage"
                    tools:text="08" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tvBadgeLabel"
                    style="@style/Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_8dp"
                    android:text="@string/badges"
                    android:textColor="@color/white"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toEndOf="@+id/tvBuddiesLabel"
                    app:layout_constraintTop_toBottomOf="@id/tvBadgeValue"
