<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="24dp"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/tvNumber"
        style="@style/S14"
        android:layout_width="16dp"
        android:gravity="end"
        android:layout_height="wrap_content"
        tools:text="1" />

    <TextView
        android:id="@+id/tvContent"
        style="@style/S14"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:lineSpacingExtra="8sp"
        android:textColor="@color/white_64"
        tools:text="Resting Heart Rate (RHR): Heart rate when sleeping, typically 60-100 BPM. A lower RHR often indicates better cardiovascular health. Monitoring your RHR over time can help detect changes in fitness and identify potential health issue." />

</LinearLayout>