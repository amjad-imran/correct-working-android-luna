<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/dimen_18dp"
        android:paddingEnd="@dimen/dimen_18dp"
        android:paddingBottom="@dimen/dimen_18dp"
        android:orientation="vertical">

        <include
            android:id="@+id/lytCountrySearch"
            layout="@layout/row_country_search_layout" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCountries"
            style="@style/ModalStyleNew"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:itemCount="2"
            tools:listitem="@layout/row_country_name_layout" />
    </LinearLayout>
</layout>
