<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:lineChart="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">


            <include
                android:id="@+id/lytTopStressGraph"
                layout="@layout/layout_stress_graph_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                app:layout_constraintTop_toTopOf="parent" />

            <com.oreo.ui.custom.StressCombinedChart
                android:id="@+id/lytStressMidGraph"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:layout_marginStart="26dp"
                android:layout_marginTop="32dp"
                android:layout_marginEnd="26dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/lytTopStressGraph"
                lineChart:bottomWith="30dp"
                lineChart:chartLineColor="#FFFFFF"
                lineChart:chartLineWidth="2dp"
                lineChart:gridColor="#80FFFFFF"
                lineChart:highColor="#ff922d"
                lineChart:lowColor="#12cba9"
                lineChart:mediumColor="#ffe561"
                lineChart:restLineColor="#40FFFFFF"
                lineChart:topWith="50dp"
                lineChart:xMax="100"
                lineChart:xMin="0"
                lineChart:xTextColor="#FFFFFF"
                lineChart:xTextSize="12sp"
                lineChart:yTextSize="12sp" />

            <View
                android:id="@+id/viewOpen"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/back_cicular_36"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/lytStressMidGraph" />

            <ImageView
                android:id="@+id/ivOpen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_o_dropdown"
                app:layout_constraintBottom_toBottomOf="@id/viewOpen"
                app:layout_constraintEnd_toEndOf="@id/viewOpen"
                app:layout_constraintStart_toStartOf="@id/viewOpen"
                app:layout_constraintTop_toTopOf="@id/viewOpen" />

            <TextView
                android:id="@+id/tvCompareHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/side_margin"
                android:layout_marginTop="24dp"
                android:text="@string/text_select_to_compare"
                android:textColor="@color/white_48"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/viewOpen" />

            <include
                android:id="@+id/lytHighMovement"
                layout="@layout/layout_compare_view_item"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/side_margin"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="@dimen/side_margin"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/tvCompareHeader"
                tools:visibility="visible" />

            <include
                android:id="@+id/lytMediumMovement"
                layout="@layout/layout_compare_view_item"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/side_margin"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="@dimen/side_margin"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/lytHighMovement"
                tools:visibility="visible" />

            <include
                android:id="@+id/lytLowMovement"
                layout="@layout/layout_compare_view_item"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/side_margin"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="@dimen/side_margin"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/lytMediumMovement"
                tools:visibility="visible" />

            <include
                android:id="@+id/lytNoMovement"
                layout="@layout/layout_compare_view_item"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/side_margin"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="@dimen/side_margin"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/lytLowMovement"
                tools:visibility="visible" />

            <View
                android:id="@+id/viewClose"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/back_cicular_36"
                android:visibility="visible"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/lytNoMovement" />

            <ImageView
                android:id="@+id/ivClose"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:rotation="180"
                android:src="@drawable/ic_o_dropdown"
                android:visibility="visible"
                app:layout_constraintBottom_toBottomOf="@id/viewClose"
                app:layout_constraintEnd_toEndOf="@id/viewClose"
                app:layout_constraintStart_toStartOf="@id/viewClose"
                app:layout_constraintTop_toTopOf="@id/viewClose" />

            <include
                android:id="@+id/divider1"
                layout="@layout/layout_divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="24dp"
                app:layout_constraintTop_toBottomOf="@id/viewClose" />

            <TextView
                android:id="@+id/tvBannerHeader"
                style="@style/H5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/side_margin"
                android:layout_marginTop="24dp"
                android:text="@string/text_luna_cues"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/divider1" />

            <include
                android:id="@+id/lytStressBanner"
                layout="@layout/layout_stress_banner_item"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/side_margin"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="@dimen/side_margin"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvBannerHeader" />

            <View
                android:id="@+id/divider2"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="24dp"
                android:background="@color/divider_color"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/lytStressBanner" />

            <include
                android:id="@+id/lytStressHeader"
                layout="@layout/layout_stress_header_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/side_margin"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="@dimen/side_margin"
                app:layout_constraintTop_toBottomOf="@id/divider2" />


        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>
</layout>