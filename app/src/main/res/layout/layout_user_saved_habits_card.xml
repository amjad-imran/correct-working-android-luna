<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@drawable/bg_user_saved_habits">

    <ProgressBar
        android:id="@+id/habitProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="@dimen/dimen_16dp"
        android:layout_height="@dimen/dimen_16dp"
        android:indeterminate="false"
        android:max="100"
        android:progress="5"
        android:rotation="270"
        android:layout_marginStart="@dimen/dimen_12dp"
        android:progressDrawable="@drawable/circle_drawable"
        app:layout_constraintBottom_toBottomOf="@+id/tvHabitsLogged"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvHabitsLogged" />

    <TextView
        android:id="@+id/tvHabitsLogged"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginVertical="@dimen/dimen_16dp"
        android:fontFamily="@font/gilroy_medium"
        android:layout_marginStart="@dimen/dimen_4dp"
        tools:text="0/5 Habits Logged"
        android:textColor="@color/white"
        android:textSize="@dimen/dimen_12sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toStartOf="@id/tvCustomize"
        app:layout_constraintStart_toEndOf="@+id/habitProgress" />

    <TextView
        android:id="@+id/tvCustomize"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawableLeft="@drawable/ic_btn_customize"
        android:drawablePadding="@dimen/dimen_4dp"
        android:fontFamily="@font/gilroy_medium"
        android:paddingVertical="@dimen/dimen_4dp"
        android:text="Customize"
        android:textColor="@color/color_B3FFFFFF"
        android:textSize="@dimen/dimen_12sp"
        android:layout_marginEnd="@dimen/dimen_12dp"
        app:layout_constraintBottom_toBottomOf="@+id/tvHabitsLogged"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/tvHabitsLogged"
        app:layout_constraintTop_toTopOf="@+id/tvHabitsLogged" />

    <View
        android:id="@+id/viewDivider"
        android:layout_width="0dp"
        android:layout_height="@dimen/dimen_1dp"
        android:background="#1AFFFFFF"
        android:layout_marginTop="@dimen/dimen_16dp"
        app:layout_constraintTop_toBottomOf="@id/tvHabitsLogged"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvHabits"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@id/viewDivider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvMoreHabits"
        android:layout_width="@dimen/dimen_0dp"
        android:layout_height="wrap_content"
        android:layout_marginVertical="@dimen/dimen_14dp"
        android:fontFamily="@font/gilroy_bold"
        android:textColor="@color/white"
        android:textSize="@dimen/text_12sp"
        android:layout_marginStart="@dimen/dimen_12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tvLifeOS"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rvHabits"
        tools:text="+2 more" />

    <TextView
        android:id="@+id/tvLifeOS"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/synced_with_lifeos"
        android:textColor="@color/color_B3FFFFFF"
        android:textSize="@dimen/text_12sp"
        android:layout_marginEnd="@dimen/dimen_12dp"
        app:layout_constraintStart_toEndOf="@id/tvMoreHabits"
        app:layout_constraintTop_toTopOf="@id/tvMoreHabits"
        app:layout_constraintBottom_toBottomOf="@+id/tvMoreHabits"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>