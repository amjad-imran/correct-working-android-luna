<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_user_saved_habits">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/lytHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp"
        android:paddingVertical="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ProgressBar
            android:id="@+id/habitProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:indeterminate="false"
            android:progressDrawable="@drawable/circle_drawable"
            android:rotation="270"
            app:layout_constraintBottom_toBottomOf="@+id/tvHabitsLogged"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvHabitsLogged" />

        <TextView
            android:id="@+id/tvHabitsLogged"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimen_4dp"
            android:layout_marginEnd="@dimen/dimen_8dp"
            android:fontFamily="@font/gilroy_medium"
            android:textColor="@color/white"
            android:textSize="@dimen/dimen_12sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tvCustomize"
            app:layout_constraintStart_toEndOf="@+id/habitProgress"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="0/5 Habits Logged" />

        <TextView
            android:id="@+id/tvCustomize"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/ic_btn_customize"
            android:drawablePadding="@dimen/dimen_4dp"
            android:fontFamily="@font/gilroy_medium"
            android:text="@string/text_customise"
            android:textColor="@color/color_B3FFFFFF"
            android:textSize="@dimen/dimen_12sp"
            app:layout_constraintBottom_toBottomOf="@+id/tvHabitsLogged"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvHabitsLogged" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <View
        android:id="@+id/viewDivider"
        android:layout_width="0dp"
        android:layout_height="@dimen/dimen_1dp"
        android:background="#1AFFFFFF"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/lytHeader" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvHabits"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/viewDivider" />

    <TextView
        android:id="@+id/tvMoreHabits"
        android:layout_width="@dimen/dimen_0dp"
        android:layout_height="wrap_content"
        android:paddingVertical="@dimen/dimen_14dp"
        android:layout_marginStart="@dimen/dimen_12dp"
        android:fontFamily="@font/gilroy_bold"
        android:textColor="@color/white"
        android:textSize="@dimen/text_12sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tvLifeOS"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rvHabits"
        tools:text="+2 more" />

    <TextView
        android:id="@+id/tvLifeOS"
        style="@style/S12"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/dimen_12dp"
        android:text="@string/synced_with_lifeos"
        android:textColor="@color/color_B3FFFFFF"
        app:layout_constraintBottom_toBottomOf="@+id/tvMoreHabits"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/tvMoreHabits"
        app:layout_constraintTop_toTopOf="@id/tvMoreHabits" />

    <androidx.constraintlayout.widget.Group
        android:id="@+id/lytContentAndFooter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="viewDivider, rvHabits, tvMoreHabits, tvLifeOS" />

</androidx.constraintlayout.widget.ConstraintLayout>