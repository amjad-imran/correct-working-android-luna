<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/tvTeam1"
        style="@style/H6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:layout_constraintEnd_toEndOf="@+id/lytTeam1"
        app:layout_constraintStart_toStartOf="@+id/lytTeam1"
        app:layout_constraintTop_toBottomOf="@+id/lytTeam1"
        tools:text="Bangalore" />

    <TextView
        android:id="@+id/team1YetToBat"
        style="@style/Small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/text_yet_to_bat"
        android:textColor="@color/white_64"
        app:layout_constraintEnd_toEndOf="@+id/tvTeam1"
        app:layout_constraintStart_toStartOf="@+id/tvTeam1"
        app:layout_constraintTop_toBottomOf="@+id/tvTeam1" />

    <LinearLayout
        android:id="@+id/lytTeamAScore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="@+id/lytTeam1"
        app:layout_constraintStart_toStartOf="@+id/lytTeam1"
        app:layout_constraintTop_toBottomOf="@id/tvTeam1">

        <TextView
            android:id="@+id/tvScore"
            style="@style/H6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:visibility="invisible"
            tools:text="123/5" />

        <TextView
            android:id="@+id/tvOver"
            style="@style/H6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:textColor="@color/white_64"
            android:textSize="12sp"
            android:visibility="invisible"
            tools:text="(12.3)" />


    </LinearLayout>

    <include
        android:id="@+id/lytTeam1"
        layout="@layout/layout_ongoing_circle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="50dp"
        android:layout_marginTop="@dimen/dimen_16dp"
        app:layout_constraintEnd_toStartOf="@+id/lytTeam2"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <TextView
        android:id="@+id/tvTeam2"
        style="@style/H6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:layout_constraintEnd_toEndOf="@+id/lytTeam2"
        app:layout_constraintStart_toStartOf="@+id/lytTeam2"
        app:layout_constraintTop_toBottomOf="@+id/lytTeam2"
        tools:text="Rajasthan" />

    <TextView
        android:id="@+id/team2YetToBat"
        style="@style/Small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/text_yet_to_bat"
        android:textColor="@color/white_64"
        app:layout_constraintEnd_toEndOf="@+id/tvTeam2"
        app:layout_constraintStart_toStartOf="@+id/tvTeam2"
        app:layout_constraintTop_toBottomOf="@+id/tvTeam2" />


    <LinearLayout
        android:id="@+id/lytTeamBScore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp"
        app:layout_constraintEnd_toEndOf="@+id/lytTeam2"
        app:layout_constraintStart_toStartOf="@+id/lytTeam2"
        app:layout_constraintTop_toBottomOf="@+id/tvTeam2">

        <TextView
            android:id="@+id/tvScore2"
            style="@style/H6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="145/10"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tvOver2"
            style="@style/H6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:textColor="@color/white_64"
            android:textSize="12sp"
            android:visibility="gone"
            app:layout_constraintStart_toEndOf="@id/tvScore2"
            app:layout_constraintTop_toBottomOf="@+id/tvTeam2"
            tools:text="(12.5)"
            tools:visibility="visible" />

    </LinearLayout>


    <include
        android:id="@+id/lytTeam2"
        layout="@layout/layout_ongoing_circle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_16dp"
        android:layout_marginEnd="50dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/lytTeam1"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvMatchStatus"
        style="@style/H4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="4sp"
        android:text="@string/text_vs_small"
        android:textColor="@color/purple_"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/vDividerRed"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:background="#19ffffff"
        app:layout_constraintBottom_toTopOf="@+id/tvPowered"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/lytTeamAScore" />

    <TextView
        android:id="@+id/tvPowered"
        style="@style/Small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/side_margin"
        android:layout_marginTop="8dp"
        android:text="@string/text_powered_by"
        android:textColor="@color/white_64"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/vDividerRed" />

    <ImageView
        android:id="@+id/ivPowered"
        android:layout_width="wrap_content"
        android:layout_height="10dp"
        android:layout_marginStart="5dp"
        android:adjustViewBounds="true"
        app:layout_constraintBottom_toBottomOf="@+id/tvPowered"
        app:layout_constraintStart_toEndOf="@+id/tvPowered"
        app:layout_constraintTop_toTopOf="@id/tvPowered"
        tools:ignore="ContentDescription" />

    <TextView
        android:id="@+id/tvPredict"
        style="@style/H6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="@dimen/side_margin"
        android:text="@string/text_predicted"
        android:textColor="@color/white_64"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/vDividerRed" />

    <TextView
        android:id="@+id/tvPredictValue"
        style="@style/Small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        android:drawablePadding="4dp"
        android:gravity="center"
        android:textColor="@color/white"
        app:drawableStartCompat="@drawable/ic_pred_people"
        app:layout_constraintBottom_toBottomOf="@id/tvPredict"
        app:layout_constraintEnd_toStartOf="@+id/tvPredict"
        app:layout_constraintTop_toTopOf="@id/tvPredict"
        tools:text="1,23,24" />
</androidx.constraintlayout.widget.ConstraintLayout>