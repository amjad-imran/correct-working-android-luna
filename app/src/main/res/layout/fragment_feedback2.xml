<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <include
            android:id="@+id/layoutToolbar"
            layout="@layout/layout_toolbar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="16dp"
            app:layout_constraintBottom_toTopOf="@+id/bAcceptContinue"
            app:layout_constraintTop_toBottomOf="@+id/layoutToolbar">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <TextView
                    android:id="@+id/tvSatisfactionTitle"
                    style="@style/H5"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dimen_16dp"
                    android:layout_marginTop="@dimen/dimen_24dp"
                    android:layout_marginEnd="@dimen/side_margin"
                    android:text="@string/text_how_satisfied_are_you_with_the_noisefit"
                    android:textColor="@color/white"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:id="@+id/lvAnimFirst"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="@dimen/side_margin"
                    android:layout_marginTop="16dp"
                    android:src="@drawable/ic_star_border"
                    app:layout_constraintEnd_toStartOf="@+id/lvAnimSecond"
                    app:layout_constraintHorizontal_bias="0.0"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvSatisfactionTitle" />

                <ImageView
                    android:id="@+id/lvAnimSecond"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="16dp"
                    android:src="@drawable/ic_star_border"
                    app:layout_constraintBottom_toBottomOf="@+id/lvAnimFirst"
                    app:layout_constraintEnd_toStartOf="@+id/lvAnimThird"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toEndOf="@+id/lvAnimFirst"
                    app:layout_constraintTop_toTopOf="@+id/lvAnimFirst" />

                <ImageView
                    android:id="@+id/lvAnimThird"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="16dp"
                    android:src="@drawable/ic_star_border"
                    app:layout_constraintBottom_toBottomOf="@+id/lvAnimFirst"
                    app:layout_constraintEnd_toStartOf="@+id/lvAnimFourth"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toEndOf="@+id/lvAnimSecond"
                    app:layout_constraintTop_toTopOf="@+id/lvAnimFirst" />

                <ImageView
                    android:id="@+id/lvAnimFourth"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="16dp"
                    android:src="@drawable/ic_star_border"
                    app:layout_constraintBottom_toBottomOf="@+id/lvAnimFirst"
                    app:layout_constraintEnd_toStartOf="@+id/lvAnimFifth"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toEndOf="@+id/lvAnimThird"
                    app:layout_constraintTop_toTopOf="@+id/lvAnimFirst" />

                <ImageView
                    android:id="@+id/lvAnimFifth"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="@dimen/side_margin"
                    android:src="@drawable/ic_star_border"
                    app:layout_constraintBottom_toBottomOf="@+id/lvAnimFirst"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toEndOf="@+id/lvAnimFourth"
                    app:layout_constraintTop_toTopOf="@+id/lvAnimFirst" />

                <include
                    android:id="@+id/divider1"
                    layout="@layout/layout_divider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="30dp"
                    app:layout_constraintTop_toBottomOf="@id/lvAnimFirst" />

                <include
                    android:id="@+id/lytChipView"
                    layout="@layout/layout_feedback_chip_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/divider1" />

                <include
                    android:id="@+id/divider2"
                    layout="@layout/layout_divider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="30dp"
                    app:layout_constraintTop_toBottomOf="@id/lytChipView" />

                <include
                    android:id="@+id/lytProblemDescription"
                    layout="@layout/layout_feedback_problem_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/divider2" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bAcceptContinue"
            style="@style/PrimaryButtonStyle"
            android:layout_width="0dp"
            android:layout_margin="@dimen/dimen_24dp"
            android:text="@string/text_submit"
            android:textAllCaps="false"
            android:visibility="visible"
            app:backgroundTint="@null"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>