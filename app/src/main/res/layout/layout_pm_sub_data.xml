<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/tvTeam1"
        style="@style/H6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"

        android:textColor="@color/white_64"
        android:textSize="12sp"
        app:layout_constraintStart_toEndOf="@id/lytTeam1"
        app:layout_constraintTop_toTopOf="@id/lytTeam1" />

    <TextView
        android:id="@+id/tvScore"
        style="@style/H6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="4dp"

        app:layout_constraintBottom_toBottomOf="@id/lytTeam1"
        app:layout_constraintStart_toEndOf="@id/lytTeam1"
        app:layout_constraintTop_toBottomOf="@id/tvTeam1" />


    <include
        android:id="@+id/lytTeam1"
        layout="@layout/layout_ongoing_circle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/side_margin"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <TextView
        android:id="@+id/tvTeam2"
        style="@style/H6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"

        android:textSize="12sp"
        android:textColor="@color/white_64"
        app:layout_constraintEnd_toStartOf="@id/lytTeam2"
        app:layout_constraintTop_toTopOf="@id/lytTeam2" />

    <TextView
        android:id="@+id/tvScore2"
        style="@style/H6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="8dp"

        app:layout_constraintBottom_toBottomOf="@id/lytTeam2"
        app:layout_constraintEnd_toStartOf="@id/lytTeam2"
        app:layout_constraintTop_toBottomOf="@+id/tvTeam2" />


    <include
        android:id="@+id/lytTeam2"
        layout="@layout/layout_ongoing_circle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/side_margin"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="@dimen/side_margin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/vBack"
        android:layout_width="0dp"
        android:layout_height="16dp"
        android:layout_marginHorizontal="@dimen/side_margin"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/back_progress_16"
        android:visibility="visible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/lytTeam1" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/pbSteps"
        android:layout_width="0dp"
        android:layout_height="4dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        app:indicatorColor="@color/purple_"
        app:layout_constraintBottom_toBottomOf="@+id/vBack"
        app:layout_constraintEnd_toEndOf="@+id/vBack"
        app:layout_constraintStart_toStartOf="@+id/vBack"
        app:layout_constraintTop_toTopOf="@+id/vBack"
        app:trackColor="#41295a"
        app:trackCornerRadius="2dp"
        app:trackThickness="4dp" />


</androidx.constraintlayout.widget.ConstraintLayout>