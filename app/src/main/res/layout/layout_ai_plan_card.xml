<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivWorkoutPlan"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        tools:src="@drawable/image_ai_w_plan"
        app:shapeAppearance="@style/ShapeAppearanceOverlay.App.CornerSize20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/ivBottomIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:src="@drawable/ic_workout_plan"
        app:layout_constraintBottom_toBottomOf="@+id/ivWorkoutPlan"
        app:layout_constraintEnd_toEndOf="parent" />


    <TextView
        android:id="@+id/tvPlanName"
        style="@style/S20"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="12dp"
        tools:text="@string/text_my_workout_plan"
        android:textColor="#A8FFFF"
        app:layout_constraintEnd_toEndOf="@+id/ivWorkoutPlan"
        app:layout_constraintStart_toStartOf="@+id/ivWorkoutPlan"
        app:layout_constraintTop_toTopOf="@+id/ivWorkoutPlan" />

</androidx.constraintlayout.widget.ConstraintLayout>