<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/userImv"
            android:layout_width="@dimen/dimen_24dp"
            android:layout_height="@dimen/dimen_24dp"
            android:scaleType="centerCrop"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearance="@style/ShapeAppearanceOverlay.App.CornerSize50Percent"
            app:strokeColor="@color/white_12"
            app:strokeWidth="1dp" />

        <TableLayout
            android:id="@+id/table"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimen_8dp"
            android:shrinkColumns="0"
            app:layout_constraintEnd_toStartOf="@+id/btnAction"
            app:layout_constraintStart_toEndOf="@+id/userImv"
            app:layout_constraintTop_toTopOf="@+id/userImv">

            <TableRow
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvName"
                    style="@style/Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/white_80"
                    tools:text="Deepak yadav" />

                <ImageView
                    android:id="@+id/imvVerified"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="4dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_verified"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/vCircle"
                    android:layout_width="4dp"
                    android:layout_height="4dp"
                    android:background="@color/white_48"
                    android:visibility="visible"
                    app:shapeAppearance="@style/ShapeAppearance.Material3.SmallComponent"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/tvTime"
                    style="@style/Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:ellipsize="none"
                    android:textColor="@color/white_80"
                    android:visibility="visible"
                    tools:text="Location"
                    tools:visibility="visible" />
            </TableRow>


        </TableLayout>


        <TextView
            android:id="@+id/tvContent"
            style="@style/H6"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="@dimen/dimen_16dp"
            android:ellipsize="end"
            android:maxLines="2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/table"
            app:layout_constraintTop_toBottomOf="@+id/table"
            tools:text="User written caption will come here. “#” tags should have the colour like #ShorRukegaNahi..." />

        <TextView
            android:id="@+id/tvReadMore"
            style="@style/H6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingTop="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp"
            android:text="@string/text_read_more"
            android:textColor="@color/accent_color_purple"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="@+id/tvContent"
            app:layout_constraintTop_toBottomOf="@+id/tvContent"
            tools:visibility="visible" />

        <ImageButton
            android:id="@+id/btnAction"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@android:color/transparent"
            android:padding="16dp"
            android:src="@drawable/ic_horizontal_more"
            app:layout_constraintBottom_toBottomOf="@+id/userImv"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/userImv" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>