<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:clickable="true"
        android:elevation="20dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/imageView113"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_ai_insight"
            app:layout_constraintBottom_toBottomOf="@id/tvInsights"
            app:layout_constraintEnd_toStartOf="@+id/tvInsights"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvInsights" />

        <TextView
            android:id="@+id/tvInsights"
            style="@style/S16"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/gilroy_bold"
            android:text="@string/text_insights"
            app:layout_constraintEnd_toStartOf="@+id/ivBeta"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/imageView113"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/ivBeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_beta_logo_insights_detail"
            app:layout_constraintBottom_toBottomOf="@+id/tvInsights"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tvInsights"
            app:layout_constraintTop_toTopOf="@+id/tvInsights" />

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lottieView"
            android:layout_width="132dp"
            android:layout_height="132dp"
            android:layout_marginTop="32dp"
            app:layout_constraintBottom_toTopOf="@+id/tvLoadingTitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvInsights"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            app:lottie_rawRes="@raw/anim_add_friends" />

        <TextView
            android:id="@+id/tvLoadingTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            style="@style/S16"
            android:layout_marginTop="24dp"
            android:textFontWeight="600"
            android:gravity="center"
            app:layout_constraintVertical_chainStyle="packed"
            android:text="@string/crafting_your_insights"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/tvLoadingDesc"
            app:layout_constraintTop_toBottomOf="@+id/lottieView" />

        <TextView
            android:id="@+id/tvLoadingDesc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/insights_loading_desc"
            android:textColor="@color/white_80"
            android:textSize="@dimen/text_14sp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="44dp"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvLoadingTitle" />

        <include
            layout="@layout/layout_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>