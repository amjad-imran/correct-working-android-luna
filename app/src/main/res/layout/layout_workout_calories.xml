<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:lineChart="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp"
    android:background="@drawable/bg_spinner_add_log_bottom_sheet_circadian">

    <TextView
        android:id="@+id/tvDuration"
        style="@style/S12"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/google_sans_flex_medium"
        android:text="@string/text_duration"
        android:textColor="#A3FFFFFF"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvDurationValue"
        style="@style/S18"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvDuration"
        tools:text="--" />

    <TextView
        android:id="@+id/tvDurationUnit"
        style="@style/S18"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        app:layout_constraintBaseline_toBaselineOf="@+id/tvDurationValue"
        app:layout_constraintStart_toEndOf="@id/tvDurationValue"
        tools:text="min" />

    <include
        android:id="@+id/divider1"
        layout="@layout/layout_line_separator"
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvCaloriesBurn"
        style="@style/S12"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/side_margin"
        android:text="@string/text_calories_burnt"
        android:textColor="#A3FFFFFF"
        app:layout_constraintStart_toEndOf="@+id/divider1"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvCalBurnValue"
        style="@style/S18"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="@id/tvCaloriesBurn"
        app:layout_constraintTop_toBottomOf="@+id/tvCaloriesBurn"
        tools:text="--" />

    <TextView
        android:id="@+id/tvCalBurnUnit"
        style="@style/S18"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        app:layout_constraintBaseline_toBaselineOf="@+id/tvCalBurnValue"
        app:layout_constraintStart_toEndOf="@id/tvCalBurnValue"
        tools:text="kcal" />


</androidx.constraintlayout.widget.ConstraintLayout>
