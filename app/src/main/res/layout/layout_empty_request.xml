<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/ivEmptyImage"
            android:layout_width="106dp"
            android:layout_height="106dp"
            android:padding="8dp"
            android:src="@drawable/ic_friends_navigation"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvEmptyMessage"
            style="@style/H5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/text_no_request_received"
            app:layout_constraintEnd_toEndOf="@id/ivEmptyImage"
            app:layout_constraintStart_toStartOf="@id/ivEmptyImage"
            app:layout_constraintTop_toBottomOf="@id/ivEmptyImage" />

        <TextView
            android:id="@+id/textViewMsg"
            style="@style/Small"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:lineSpacingExtra="6sp"
            android:paddingStart="72dp"
            android:paddingEnd="72dp"
            android:text="@string/text_click_on_add_friend"
            android:textColor="@color/white_80"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvEmptyMessage" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
