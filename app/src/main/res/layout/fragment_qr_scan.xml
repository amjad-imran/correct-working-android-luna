<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".ui.onboarding.otp.OtpCountryFragment">


        <FrameLayout
            android:id="@+id/qrScannerContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#CC000000">

        </FrameLayout>

        <RelativeLayout
            android:id="@+id/aboveContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/app_background">

            <ImageButton
                android:id="@+id/btnBack"
                style="@style/ToolbarBackButton"
                android:layout_margin="@dimen/side_margin" />


            <TextView
                android:id="@+id/textView"
                style="@style/H2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignStart="@+id/btnBack"
                android:layout_marginTop="@dimen/dimen_96dp"
                android:text="@string/text_scan_qr_code" />


            <TextView
                android:id="@+id/tvSubHeading"
                style="@style/H6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/textView"
                android:layout_marginStart="@dimen/side_margin"
                android:layout_marginTop="@dimen/dimen_24dp"
                android:layout_marginEnd="@dimen/side_margin"
                android:layout_marginBottom="@dimen/dimen_24dp"
                android:text="@string/text_please_align_the_qr_code_within_the_scanner_make_sure_your_phone_s_bluetooth_connection_is_active" />
        </RelativeLayout>


        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/aboveContainer"
            android:layout_alignParentBottom="true"
            android:layout_marginTop="@dimen/side_margin"
            android:layout_marginBottom="@dimen/side_margin">


            <ImageView
                android:id="@+id/imvFlash"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_below="@+id/imvScanArea"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"
                android:gravity="center"
                android:src="@drawable/baseline_flashlight_off_white_24dp"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/imvScanArea"
                android:layout_width="240dp"
                android:layout_height="240dp"
                android:layout_centerInParent="true"
                android:background="@drawable/bg_qr_scan" />

        </RelativeLayout>


        <include
            android:id="@+id/progressBar"
            layout="@layout/default_loader"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

    </RelativeLayout>
</layout>