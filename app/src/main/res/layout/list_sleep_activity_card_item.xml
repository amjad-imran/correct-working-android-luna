<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    android:layout_marginTop="24dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintLayout2"
        style="@style/ModalStyleReadinessNew"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/dimen_8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/constraintLayout"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/textView"
            style="@style/H5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimen_16dp"
            android:layout_marginTop="@dimen/dimen_16dp"
            android:singleLine="true"
            android:text="@string/text_sleep_score_o"
            app:layout_constraintEnd_toStartOf="@+id/imageView14"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/imageView14"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="@dimen/dimen_16dp"
            android:adjustViewBounds="true"
            android:alpha="0.6"
            android:visibility="visible"
            android:contentDescription="@null"
            android:src="@drawable/ic_arrow_right_white"
            app:layout_constraintBottom_toBottomOf="@+id/textView"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/textView" />


        <TextView
            android:id="@+id/tvSleepScore"
            style="@style/H2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_18dp"
            app:layout_constraintStart_toStartOf="@+id/textView"
            app:layout_constraintTop_toBottomOf="@+id/textView"
            tools:text="23"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tvAvgThisWeek"
            style="@style/H6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_4dp"
            android:layout_marginBottom="@dimen/dimen_16dp"
            android:text="@string/text_avg_this_week"
            android:textColor="@color/white_50"
            android:textSize="12sp"
            android:visibility="visible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@+id/tvSleepScore"
            app:layout_constraintTop_toBottomOf="@+id/tvSleepScore" />

        <TextView
            android:id="@+id/tvDaysAvg"
            style="@style/H6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_4dp"
            android:text="@string/text_seven_day_avg"
            android:textColor="@color/white_50"
            android:textSize="12sp"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="@+id/tvSleepScore"
            app:layout_constraintTop_toBottomOf="@+id/tvSleepScore"
            tools:visibility="visible" />

        <com.oreo.ui.custom.LineChart
            android:id="@+id/sleepLineChart"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_margin="@dimen/dimen_16dp"
            android:visibility="gone"
            app:alwaysShowCircle="false"
            app:bgBottomColor="@android:color/transparent"
            app:bgColor="@android:color/transparent"
            app:bgLeftColor="@android:color/transparent"
            app:bgRightColor="@android:color/transparent"
            app:bgTopColor="@android:color/transparent"
            app:bottomWith="5dp"
            app:canScroll="false"
            app:centerLineColor="#80ffffff"
            app:centerLineWidth="5dp"
            app:chartLineColor="@color/sleep_chart_line_color"
            app:chartLineWidth="3dp"
            app:fillColorEnd="@color/sleep_fill_end_color"
            app:fillColorStart="@color/sleep_fill_start_color"
            app:gridColor="#80FFFFFF"
            app:hCount="8"
            app:innerCircleColor="#ffffff"
            app:innerCircleRadius="2dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvDaysAvg"
            app:leftWith="4dp"
            app:rightWith="10dp"
            app:scaleColor="#ff000000"
            app:scaleLenth="4dp"
            app:scaleNodeColor="#FFFFFF"
            app:scaleNodeRadius="6dp"
            app:showExtremeLine="false"
            app:showGrid="true"
            app:showSelectedIndicator="false"
            app:showXAxis="false"
            app:startFromRight="true"
            app:topWith="0dp"
            app:vCount="2"
            app:xLineColor="#80FFFFFF"
            app:xMax="100"
            app:xMin="0"
            app:xTextColor="#FFFFFF"
            app:xTextSize="16sp" />


        <include
            android:id="@+id/sleepLine"
            layout="@layout/layout_line_separator"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/dimen_12dp"
            android:visibility="visible"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/sleepLineChart" />

        <ImageView
            android:id="@+id/sleepTrendImv"
            android:layout_width="@dimen/dimen_16dp"
            android:layout_height="@dimen/dimen_16dp"
            android:layout_marginStart="@dimen/dimen_16dp"
            android:layout_marginTop="@dimen/dimen_12dp"
            android:layout_marginBottom="@dimen/dimen_16dp"
            android:src="@drawable/ic_trend_up"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/sleepLine" />

        <TextView
            android:id="@+id/sleepTrendValue"
            style="@style/H6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimen_4dp"
            android:textColor="@color/steps_arc"
            android:textSize="12sp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@+id/sleepTrendImv"
            app:layout_constraintStart_toEndOf="@+id/sleepTrendImv"
            app:layout_constraintTop_toTopOf="@+id/sleepTrendImv" />

        <TextView
            android:id="@+id/tvSleepFromLast"
            style="@style/H6"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimen_4dp"
            android:text="@string/text_from_last_week"
            android:textColor="@color/white_48"
            android:textSize="12sp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@+id/sleepTrendImv"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/sleepTrendValue"
            app:layout_constraintTop_toTopOf="@+id/sleepTrendImv" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintLayout"
        style="@style/ModalStyleReadinessNew"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dimen_8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/constraintLayout2"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/textView1"
            style="@style/H5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimen_16dp"
            android:layout_marginTop="@dimen/dimen_16dp"
            android:singleLine="true"
            android:text="@string/text_activity_score"
            app:layout_constraintEnd_toStartOf="@+id/imageView15"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/imageView15"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="@dimen/dimen_16dp"
            android:adjustViewBounds="true"
            android:alpha="0.6"
            android:visibility="visible"
            android:contentDescription="@null"
            android:src="@drawable/ic_arrow_right_white"
            app:layout_constraintBottom_toBottomOf="@+id/textView1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/textView1" />


        <TextView
            android:id="@+id/tvActivityScore"
            style="@style/H2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_18dp"

            app:layout_constraintStart_toStartOf="@+id/textView1"
            app:layout_constraintTop_toBottomOf="@+id/textView1" />

        <TextView
            android:id="@+id/tvActAvgThisWeek"
            style="@style/H6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_4dp"
            android:layout_marginBottom="@dimen/dimen_16dp"
            android:text="@string/text_avg_this_week"
            android:textColor="@color/white_50"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@+id/tvActivityScore"
            app:layout_constraintTop_toBottomOf="@+id/tvActivityScore" />

        <TextView
            android:id="@+id/tvDaysAvg1"
            style="@style/H6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_4dp"
            android:text="@string/text_seven_day_avg"
            android:textColor="@color/white_64"
            android:textSize="12sp"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="@+id/tvActivityScore"
            app:layout_constraintTop_toBottomOf="@+id/tvActivityScore"
            tools:visibility="visible" />


        <com.oreo.ui.custom.LineChart
            android:id="@+id/activityLineChart"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_margin="@dimen/dimen_16dp"
            android:visibility="gone"
            app:alwaysShowCircle="false"
            app:bgBottomColor="@android:color/transparent"
            app:bgColor="@android:color/transparent"
            app:bgLeftColor="@android:color/transparent"
            app:bgRightColor="@android:color/transparent"
            app:bgTopColor="@android:color/transparent"
            app:bottomWith="5dp"
            app:canScroll="false"
            app:centerLineColor="#80ffffff"
            app:centerLineWidth="5dp"
            app:chartLineColor="@color/activity_chart_line_color"
            app:chartLineWidth="3dp"

            app:fillColorEnd="@color/activity_fill_end_color"
            app:fillColorStart="@color/activity_fill_start_color"
            app:gridColor="#80FFFFFF"
            app:hCount="8"
            app:innerCircleColor="#ffffff"
            app:innerCircleRadius="2dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvDaysAvg1"
            app:leftWith="4dp"
            app:rightWith="10dp"
            app:scaleColor="#ff000000"
            app:scaleLenth="4dp"
            app:scaleNodeColor="#FFFFFF"
            app:scaleNodeRadius="6dp"
            app:showExtremeLine="false"
            app:showGrid="true"
            app:showSelectedIndicator="false"
            app:showXAxis="false"
            app:startFromRight="true"
            app:topWith="0dp"
            app:vCount="2"
            app:xLineColor="#80FFFFFF"
            app:xMax="100"
            app:xMin="0"
            app:xTextColor="#FFFFFF"
            app:xTextSize="16sp" />


        <include
            android:id="@+id/activityLine"
            layout="@layout/layout_line_separator"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/dimen_12dp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/activityLineChart" />

        <ImageView
            android:id="@+id/activityTrendImv"
            android:layout_width="@dimen/dimen_16dp"
            android:layout_height="@dimen/dimen_16dp"
            android:layout_marginStart="@dimen/dimen_16dp"
            android:layout_marginTop="@dimen/dimen_12dp"
            android:layout_marginBottom="@dimen/dimen_16dp"
            android:src="@drawable/ic_trend_up"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/activityLine" />

        <TextView
            android:id="@+id/activityTrendValue"
            style="@style/H6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimen_4dp"
            android:textColor="@color/steps_arc"
            android:textSize="12sp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@+id/activityTrendImv"
            app:layout_constraintStart_toEndOf="@+id/activityTrendImv"
            app:layout_constraintTop_toTopOf="@+id/activityTrendImv"
            tools:text="5%" />

        <TextView
            android:id="@+id/tvActivityFrom"
            style="@style/H6"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimen_4dp"
            android:text="@string/text_from_last_week"
            android:textColor="@color/white_48"
            android:textSize="12sp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@+id/activityTrendImv"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/activityTrendValue"
            app:layout_constraintTop_toTopOf="@+id/activityTrendImv" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>