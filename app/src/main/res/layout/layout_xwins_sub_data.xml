<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">


    <TextView
        android:id="@+id/tvTitle"
        style="@style/H6"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="@color/white_64"
        app:layout_constraintEnd_toEndOf="@+id/pbSteps"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="30 wins away from iPhone 14 Pro" />

    <View
        android:id="@+id/vBack"
        android:layout_width="0dp"
        android:layout_height="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="40dp"
        android:background="@drawable/back_progress_16"
        android:visibility="visible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/pbSteps"
        android:layout_width="0dp"
        android:layout_height="4dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        app:indicatorColor="#aa5bff"
        app:layout_constraintBottom_toBottomOf="@+id/vBack"
        app:layout_constraintEnd_toEndOf="@+id/vBack"
        app:layout_constraintStart_toStartOf="@+id/vBack"
        app:layout_constraintTop_toTopOf="@+id/vBack"
        app:trackColor="#19ffffff"
        app:trackCornerRadius="2dp"
        app:trackThickness="4dp" />

    <TextView
        android:id="@+id/tvMatchesLeft"
        style="@style/Small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/white_64"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/vBack"
        tools:text="Matches left: 20" />

    <TextView
        android:id="@+id/textEligible"
        style="@style/Small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawablePadding="4dp"
        android:fontFamily="@font/google_sans_flex_medium"
        android:gravity="center_vertical"
        android:text="@string/text_eligible"
        android:textColor="@color/white"
        android:visibility="gone"
        app:drawableStartCompat="@drawable/ic_pred_people"
        app:layout_constraintBottom_toBottomOf="@+id/tvEligibleCount"
        app:layout_constraintEnd_toStartOf="@+id/tvEligibleCount"
        app:layout_constraintTop_toTopOf="@+id/tvEligibleCount"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tvEligibleCount"
        style="@style/Small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="8dp"
        android:fontFamily="@font/google_sans_flex_medium"
        android:textColor="@color/white_64"
        android:visibility="gone"
        app:layout_constraintEnd_toStartOf="@+id/ivWinPrize"
        app:layout_constraintTop_toBottomOf="@+id/vBack"
        tools:text="1,99,999"
        tools:visibility="visible" />

    <ImageView
        android:id="@+id/ivWinPrize"
        android:layout_width="50dp"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        app:layout_constraintBottom_toTopOf="@id/vDividerRed"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvTitle"
        tools:ignore="ContentDescription"
        tools:src="@drawable/ic_iphone" />

    <View
        android:id="@+id/vDividerRed"
        android:layout_width="match_parent"
        android:layout_height="1dp"

        android:layout_marginBottom="8dp"
        android:background="#19ffffff"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ivWinPrize" />

    <TextView
        android:id="@+id/tvPowered"
        style="@style/H6"

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:layout_marginTop="@dimen/dimen_16dp"
        android:layout_marginBottom="@dimen/dimen_16dp"
        android:textColor="@color/white_64"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/vDividerRed"
        tools:text="Predict 30 matches correctly for a chance to win an
iPhone 14 pro. Get exciting rewards with every win." />


</androidx.constraintlayout.widget.ConstraintLayout>