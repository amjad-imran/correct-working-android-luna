<?xml version="1.0" encoding="utf-8"?>
<layout>

    <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">


        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.55" />

        <TextView
            android:id="@+id/tvDate"
            style="@style/Small"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Wednesday, 30 Mar 2022" />

        <TextView
            android:id="@+id/tvTotalStepsCount"
            style="@style/H3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:layout_constraintStart_toStartOf="@+id/tvDate"
            app:layout_constraintTop_toBottomOf="@+id/tvDate"
            tools:text="10000" />

        <TextView
            android:id="@+id/tvStatsUnit"
            style="@style/Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="2dp"
            android:text="@string/text_steps"
            android:textColor="@color/very_light_pink"
            app:layout_constraintBottom_toBottomOf="@+id/tvTotalStepsCount"
            app:layout_constraintStart_toEndOf="@+id/tvTotalStepsCount" />

        <TextView
            android:id="@+id/tvDataEnd"
            style="@style/Small"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            app:layout_constraintStart_toStartOf="@+id/guideline2"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Average" />

        <TextView
            android:id="@+id/tvAverageSteps"
            style="@style/H3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:layout_constraintStart_toStartOf="@+id/guideline2"
            app:layout_constraintTop_toBottomOf="@+id/tvDataEnd"
            tools:text="9999" />

        <TextView
            android:id="@+id/tvUnitEnd"
            style="@style/Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="2dp"
            android:text="@string/text_steps"
            android:textColor="@color/very_light_pink"
            app:layout_constraintBottom_toBottomOf="@+id/tvAverageSteps"
            app:layout_constraintStart_toEndOf="@+id/tvAverageSteps" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>