<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:lineChart="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="24dp"
    android:background="@drawable/back_modal_new"
    android:paddingBottom="16dp">

    <TextView
        android:id="@+id/textView64"
        style="@style/H5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:text="@string/text_stress"
        android:textStyle="normal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginEnd="16dp"
        android:adjustViewBounds="true"
        android:alpha="0.6"
        android:contentDescription="@null"
        android:src="@drawable/ic_arrow_right_white"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="@+id/textView64"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/textView64" />

    <com.oreo.ui.custom.StressCombinedChart
        android:id="@+id/graphStress"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toBottomOf="@+id/textView64"
        lineChart:bottomWith="30dp"
        lineChart:leftWith="0dp"
        lineChart:rightWith="0dp"
        lineChart:chartLineColor="#FFFFFF"
        lineChart:chartLineWidth="2dp"
        lineChart:gridColor="#80FFFFFF"
        lineChart:combineTextSize="16sp"
        lineChart:highColor="#ff922d"
        lineChart:layout_constraintEnd_toEndOf="parent"
        lineChart:layout_constraintStart_toStartOf="parent"
        lineChart:lowColor="#12cba9"
        lineChart:mediumColor="#ffe561"
        lineChart:restLineColor="#40FFFFFF"
        lineChart:topWith="40dp"
        lineChart:xMax="100"
        lineChart:xMin="0"
        lineChart:xTextColor="#FFFFFF"
        lineChart:xTextSize="12sp"
        lineChart:yTextSize="12sp" />

    <TextView
        android:id="@+id/tvStressValue"
        style="@style/H28"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/graphStress"
        tools:text="81" />

    <TextView
        android:id="@+id/tvStressStatus"
        style="@style/H6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:textColor="@color/white_80"
        app:layout_constraintBaseline_toBaselineOf="@+id/tvStressValue"
        app:layout_constraintStart_toEndOf="@+id/tvStressValue"
        tools:text="Stressed" />

    <TextView
        android:id="@+id/tvLastUpdate"
        style="@style/Small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:textColor="@color/white_64"
        app:layout_constraintBaseline_toBaselineOf="@+id/tvStressValue"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="Updated 13 min ago" />

</androidx.constraintlayout.widget.ConstraintLayout>