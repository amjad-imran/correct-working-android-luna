<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <ImageView
        android:id="@+id/ivStart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/image_play_breathing"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <TextView
        android:id="@+id/textBreathing"
        style="@style/S24"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/text_breathing"
        app:layout_constraintBottom_toTopOf="@+id/text478"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivStart"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/text478"
        style="@style/S24"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="4-7-8"
        android:textSize="42sp"
        app:layout_constraintBottom_toTopOf="@+id/textView145"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textBreathing" />

    <TextView
        android:id="@+id/textView145"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="64dp"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="@string/text_a_natural_tranquilliser_for_the_nervous_system"
        android:textColor="#8CD8C2F6"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text478" />


</androidx.constraintlayout.widget.ConstraintLayout>