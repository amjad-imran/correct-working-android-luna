<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">


    <ImageView
        android:id="@+id/profileView1"
        android:layout_width="@dimen/dimen_32dp"
        android:layout_height="@dimen/dimen_32dp"
        android:layout_marginStart="@dimen/dimen_16dp"
        android:layout_marginTop="@dimen/dimen_24dp"
        android:layout_marginBottom="@dimen/dimen_8dp"
        android:background="@drawable/back_modal_new_round"
        android:padding="@dimen/dimen_8dp"
        android:src="@drawable/ic_vertical_three_lines"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/oreoStatus"
        android:layout_width="@dimen/dimen_32dp"
        android:layout_height="@dimen/dimen_32dp"
        android:layout_marginTop="@dimen/dimen_24dp"
        android:layout_marginEnd="@dimen/dimen_16dp"
        android:layout_marginBottom="@dimen/dimen_8dp"
        android:background="@drawable/back_modal_new_round"
        android:padding="@dimen/dimen_8dp"
        android:src="@drawable/ic_ring_default_sliver"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/batteryStatus"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:indeterminate="false"
        android:visibility="gone"
        app:indicatorSize="@dimen/dimen_32dp"
        app:layout_constraintBottom_toBottomOf="@+id/oreoStatus"
        app:layout_constraintEnd_toEndOf="@+id/oreoStatus"
        app:layout_constraintStart_toStartOf="@+id/oreoStatus"
        app:layout_constraintTop_toTopOf="@+id/oreoStatus"
        app:trackColor="#1effffff"
        app:trackThickness="1dp" />

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/lottieAnimView"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/oreoStatus"
        app:layout_constraintEnd_toEndOf="@+id/oreoStatus"
        app:layout_constraintStart_toStartOf="@+id/oreoStatus"
        app:layout_constraintTop_toTopOf="@+id/oreoStatus"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        app:lottie_rawRes="@raw/raw_anim_ring_sync" />


    <ImageView
        android:id="@+id/ivExclamation"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_luna_exclamation"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@+id/oreoStatus"
        app:layout_constraintTop_toTopOf="@+id/oreoStatus"
        tools:visibility="visible" />


</androidx.constraintlayout.widget.ConstraintLayout>