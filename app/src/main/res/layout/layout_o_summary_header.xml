<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- <com.google.android.material.progressindicator.LinearProgressIndicator
         android:id="@+id/pbSync"
         android:layout_width="match_parent"
         android:layout_height="1dp"
         android:visibility="gone"
         tools:visibility="visible"
         app:indicatorColor="#e6667ced"
         app:layout_constraintEnd_toEndOf="parent"
         app:layout_constraintStart_toStartOf="parent"
         app:layout_constraintTop_toTopOf="parent"
         app:trackColor="#19ffffff"
         app:trackCornerRadius="1dp"
         app:trackThickness="1dp" />-->


    <ImageView
        android:id="@+id/profileView1"
        android:layout_width="@dimen/dimen_32dp"
        android:layout_height="@dimen/dimen_32dp"
        android:layout_marginStart="@dimen/dimen_16dp"
        android:layout_marginTop="@dimen/dimen_24dp"
        android:layout_marginBottom="@dimen/dimen_8dp"
        android:src="@drawable/ic_vertical_three_lines"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivAppUpdate"
        android:layout_width="6dp"
        android:layout_height="6dp"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="2dp"
        android:background="#ff6782"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@+id/profileView1"
        app:layout_constraintTop_toTopOf="@+id/profileView1"
        app:shapeAppearance="@style/ShapeAppearance.App.CircleImageView"
        tools:visibility="visible" />

    <com.app.shimmertextview.ShimmerTextView
        android:id="@+id/tvHeaderStatus"
        style="@style/H6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="64dp"
        android:layout_marginEnd="64dp"
        android:singleLine="true"
        android:textColor="@color/carolina_blue"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/profileView1"
        app:layout_constraintEnd_toStartOf="@+id/oreoStatus"
        app:layout_constraintStart_toEndOf="@+id/profileView1"
        app:layout_constraintTop_toTopOf="@+id/profileView1"
        app:text_shimmer_base_color="#7095AF"
        app:text_shimmer_colored="true"
        app:text_shimmer_duration="1000"
        app:text_shimmer_highlight_color="#C2D9E6"
        app:text_shimmer_repeat_mode="restart"
        tools:text="Connecting.."
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tvHeaderStatusNonShimmer"
        style="@style/H6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="64dp"
        android:layout_marginEnd="64dp"
        android:singleLine="true"
        android:textColor="#26B3F0"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/profileView1"
        app:layout_constraintEnd_toStartOf="@+id/oreoStatus"
        app:layout_constraintStart_toEndOf="@+id/profileView1"
        app:layout_constraintTop_toTopOf="@+id/profileView1"
        tools:text="Connecting.."
        tools:visibility="visible" />

    <ImageView
        android:id="@+id/oreoStatus"
        android:layout_width="@dimen/dimen_32dp"
        android:layout_height="@dimen/dimen_32dp"
        android:layout_marginTop="@dimen/dimen_24dp"
        android:layout_marginEnd="@dimen/dimen_16dp"
        android:layout_marginBottom="@dimen/dimen_8dp"
        android:background="@drawable/back_modal_new_round"
        android:src="@drawable/ic_ring_default_silver_new"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/batteryStatus"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:indeterminate="false"
        android:visibility="gone"
        app:indicatorSize="@dimen/dimen_32dp"
        app:layout_constraintBottom_toBottomOf="@+id/oreoStatus"
        app:layout_constraintEnd_toEndOf="@+id/oreoStatus"
        app:layout_constraintStart_toStartOf="@+id/oreoStatus"
        app:layout_constraintTop_toTopOf="@+id/oreoStatus"
        app:trackColor="#1effffff"
        app:trackThickness="1dp" />

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/lottieAnimView"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/oreoStatus"
        app:layout_constraintEnd_toEndOf="@+id/oreoStatus"
        app:layout_constraintStart_toStartOf="@+id/oreoStatus"
        app:layout_constraintTop_toTopOf="@+id/oreoStatus"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        app:lottie_rawRes="@raw/raw_anim_ring_sync" />


    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivRingUpdate"
        android:layout_width="6dp"
        android:layout_height="6dp"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="2dp"
        android:background="#ff6782"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@+id/oreoStatus"
        app:layout_constraintTop_toTopOf="@+id/oreoStatus"
        app:shapeAppearance="@style/ShapeAppearance.App.CircleImageView"
        tools:visibility="visible" />

    <ImageView
        android:id="@+id/ivExclamation"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_luna_exclamation"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@+id/oreoStatus"
        app:layout_constraintTop_toTopOf="@+id/oreoStatus"
        tools:visibility="visible" />


</androidx.constraintlayout.widget.ConstraintLayout>