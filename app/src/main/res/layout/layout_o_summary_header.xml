<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">


    <ImageView
        android:id="@+id/profileView1"
        android:layout_width="@dimen/dimen_32dp"
        android:layout_marginStart="@dimen/dimen_16dp"
        android:layout_height="@dimen/dimen_32dp"
        android:layout_marginTop="@dimen/dimen_24dp"
        android:layout_marginBottom="@dimen/dimen_8dp"
        android:background="@drawable/back_modal_new_round"
        android:padding="@dimen/dimen_8dp"
        android:src="@drawable/ic_vertical_three_lines"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/oreoStatus"
        android:layout_width="@dimen/dimen_32dp"
        android:layout_height="@dimen/dimen_32dp"
        android:layout_marginTop="@dimen/dimen_24dp"
        android:layout_marginBottom="@dimen/dimen_8dp"
        android:padding="@dimen/dimen_8dp"
        android:background="@drawable/back_modal_new_round"
        android:src="@drawable/ic_luna_white"
        android:layout_marginEnd="@dimen/dimen_16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/batteryStatus"
        android:layout_width="@dimen/dimen_32dp"
        android:layout_height="@dimen/dimen_32dp"
        android:indeterminate="false"
        app:indicatorSize="@dimen/dimen_32dp"
        app:trackColor="#1effffff"
        app:layout_constraintBottom_toBottomOf="@+id/oreoStatus"
        app:layout_constraintEnd_toEndOf="@+id/oreoStatus"
        app:layout_constraintStart_toStartOf="@+id/oreoStatus"
        app:layout_constraintTop_toTopOf="@+id/oreoStatus"
        app:trackThickness="1dp" />


</androidx.constraintlayout.widget.ConstraintLayout>