<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="MissingDefaultResource">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">


        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivActivity"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_margin="16dp"
            android:background="@drawable/back_modal_new_round"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearance="@style/ShapeAppearance.App.CircleImageView" />

        <ImageView
            android:id="@+id/ivWorkoutImage"
            android:layout_width="32dp"
            android:layout_height="32dp"
            app:layout_constraintBottom_toBottomOf="@+id/ivActivity"
            app:layout_constraintEnd_toEndOf="@+id/ivActivity"
            app:layout_constraintStart_toStartOf="@+id/ivActivity"
            app:layout_constraintTop_toTopOf="@+id/ivActivity"
            tools:src="@drawable/ic_o_workout" />

        <TextView
            android:id="@+id/tvActivityDate"
            style="@style/H5"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="16dp"
            android:layout_marginTop="@dimen/dimen_8dp"
            android:layout_marginEnd="@dimen/dimen_16dp"
            android:ellipsize="end"
            android:singleLine="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/ivActivity"

            app:layout_constraintTop_toTopOf="@+id/ivActivity"
            tools:text="Strength Training" />

        <TextView
            android:id="@+id/tvTime"
            style="@style/H6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="@dimen/dimen_4dp"
            android:textColor="@color/white_80"
            android:textSize="12sp"

            app:layout_constraintStart_toEndOf="@+id/ivActivity"
            app:layout_constraintTop_toBottomOf="@+id/tvActivityDate"
            app:layout_constraintVertical_bias="0.5"
            tools:text="11:33 am - 12:07 pm" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>