<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/imageView25"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/back_modal_chat_border"
        app:layout_constraintBottom_toBottomOf="@+id/chatEtx"
        app:layout_constraintEnd_toEndOf="@+id/btnSendMessage"
        app:layout_constraintStart_toEndOf="@+id/btnNewChat"
        app:layout_constraintTop_toTopOf="@+id/chatEtx" />

    <ImageView
        android:id="@+id/btnNewChat"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:padding="6dp"
        android:src="@drawable/ic_ai_chat_new"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/chatEtx"
        style="@style/S14"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginHorizontal="@dimen/dimen_8dp"
        android:background="@color/transparent"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:hint="@string/text_tell_us_what_s_happening"
        android:imeOptions="actionSend"
        android:lineSpacingExtra="6sp"
        android:singleLine="true"
        android:textColor="@color/white"
        android:textColorHint="#66ffffff"
        app:layout_constraintBottom_toBottomOf="@+id/btnNewChat"
        app:layout_constraintEnd_toStartOf="@+id/btnSendMessage"
        app:layout_constraintStart_toEndOf="@+id/btnNewChat"
        app:layout_constraintTop_toTopOf="@+id/btnNewChat" />

    <ImageView
        android:id="@+id/btnSendMessage"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:padding="6dp"
        android:src="@drawable/ic_ai_send_message"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>