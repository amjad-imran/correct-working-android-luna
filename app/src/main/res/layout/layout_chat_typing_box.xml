<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/back_modal_chat_border">

    <EditText
        android:id="@+id/chatEtx"
        style="@style/S14"
        android:layout_width="0dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:imeOptions="actionSend"
        android:layout_height="40dp"
        android:layout_marginHorizontal="@dimen/dimen_8dp"
        android:background="@color/transparent"
        android:hint="@string/text_tell_us_what_s_happening"
        android:lineSpacingExtra="6sp"
        android:singleLine="true"
        android:textColor="@color/white"
        android:textColorHint="#66ffffff"
        app:layout_constraintBottom_toBottomOf="@+id/btnSend"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btnSend"
        app:layout_constraintTop_toTopOf="@+id/btnSend" />

    <ImageButton
        android:id="@+id/btnSend"
        android:layout_width="@dimen/dimen_40dp"
        android:layout_height="@dimen/dimen_40dp"
        android:layout_margin="@dimen/dimen_8dp"
        android:background="@drawable/back_modal_red_circle"
        android:padding="@dimen/dimen_8dp"
        android:src="@drawable/ic_send_comment"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>