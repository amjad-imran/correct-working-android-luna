<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">


    <ImageView
        android:id="@+id/ivAddAttachment"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:src="@drawable/image_add_attachments_ai"
        app:layout_constraintBottom_toBottomOf="@id/chatEtx"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:id="@+id/imageView47"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/back_chat_message_send"
        app:layout_constraintBottom_toBottomOf="@+id/chatEtx"
        app:layout_constraintEnd_toEndOf="@+id/chatEtx"
        app:layout_constraintStart_toStartOf="@+id/chatEtx"
        app:layout_constraintTop_toTopOf="@+id/lytAttachment" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/lytAttachment"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        tools:visibility="visible"
        android:paddingTop="8dp"
        app:layout_constraintStart_toStartOf="@id/chatEtx"
        app:layout_constraintBottom_toTopOf="@id/chatEtx">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivAttachmentImage"
            android:layout_width="138dp"
            android:layout_height="92dp"
            android:scaleType="centerCrop"
            app:shapeAppearance="@style/ShapeAppearanceOverlay.App.CornerSize10dp"
            tools:src="@drawable/image_ai_m_plan"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:visibility="gone"/>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/lytAttachmentDoc"
            android:layout_width="100dp"
            android:layout_height="92dp"
            android:orientation="vertical"
            android:padding="10dp"
            android:background="@drawable/back_modal_opaque"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:visibility="visible"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvDocType"
                style="@style/S14"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:text="@string/text_pdf"/>

            <TextView
                android:id="@+id/tvDocName"
                style="@style/S14"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#CCFFFFFF"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:maxLines="2"
                android:ellipsize="end"
                tools:text="Report Converted..."/>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <ImageView
            android:id="@+id/ivRemoveAttachment"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="2dp"
            android:src="@drawable/ic_cross_attachment"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>


    <EditText
        android:id="@+id/chatEtx"
        style="@style/S16"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:layout_marginStart="6dp"
        android:background="@color/transparent"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:hint="@string/text_ask_anything"
        android:imeOptions="actionSend"
        android:maxLines="1"
        android:paddingStart="16dp"
        android:paddingEnd="54dp"
        android:singleLine="true"
        android:textColor="@color/white"
        android:textColorHint="#66ffffff"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/ivAddAttachment" />

    <ImageView
        android:id="@+id/btnAudioChat"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:padding="12dp"
        android:src="@drawable/image_ai_mic"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/chatEtx"/>

    <ImageView
        android:id="@+id/btnSend"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:padding="18dp"
        android:visibility="gone"
        android:src="@drawable/ic_ai_send_message_2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/chatEtx"/>

</androidx.constraintlayout.widget.ConstraintLayout>
