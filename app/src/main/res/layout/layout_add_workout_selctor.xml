<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#cc030f1d">

    <TextView
        android:id="@+id/tvLogPeriod"
        style="@style/H5"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:text="@string/text_log_period"
        app:layout_constraintBottom_toBottomOf="@+id/ivLogPeriod"
        app:layout_constraintEnd_toStartOf="@+id/ivLogPeriod"
        app:layout_constraintTop_toTopOf="@+id/ivLogPeriod" />

    <ImageView
        android:id="@+id/ivLogPeriod"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginEnd="4dp"
        android:src="@drawable/iv_log_period_fab"
        android:layout_marginBottom="-12dp"
        app:layout_constraintBottom_toTopOf="@+id/ivRecordSleep"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvAddSleep"
        style="@style/H5"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:gravity="center_vertical|end"
        android:text="@string/text_add_sleep"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/ivRecordSleep"
        app:layout_constraintEnd_toStartOf="@+id/ivRecordSleep"
        app:layout_constraintTop_toTopOf="@+id/ivRecordSleep" />

    <ImageView
        android:id="@+id/ivRecordSleep"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="-12dp"
        android:src="@drawable/ic_add_sleep"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/ivAddWorkoutManual"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvAddWorkout"
        style="@style/H5"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:text="@string/text_add_workout"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/ivAddWorkoutManual"
        app:layout_constraintEnd_toStartOf="@+id/ivAddWorkoutManual"
        app:layout_constraintTop_toTopOf="@+id/ivAddWorkoutManual" />

    <ImageView
        android:id="@+id/ivAddWorkoutManual"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="-12dp"
        android:src="@drawable/ic_add_workout_manual"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/ivRecordWorkout"
        app:layout_constraintEnd_toEndOf="parent" />


    <TextView
        android:id="@+id/tvRecordWorkout"
        style="@style/H5"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:gravity="center_vertical|end"
        android:text="@string/text_record_workout"
        app:layout_constraintBottom_toBottomOf="@+id/ivRecordWorkout"
        app:layout_constraintEnd_toStartOf="@+id/ivRecordWorkout"
        app:layout_constraintTop_toTopOf="@+id/ivRecordWorkout" />

    <ImageView
        android:id="@+id/ivRecordWorkout"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginEnd="4dp"
        android:src="@drawable/ic_add_workout_record"
        app:layout_constraintBottom_toTopOf="@+id/ivWorkoutClose"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/ivAddWorkoutBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/back_add_workout"
        app:layout_constraintBottom_toBottomOf="@+id/ivWorkoutClose"
        app:layout_constraintEnd_toEndOf="@+id/ivWorkoutClose"
        app:layout_constraintStart_toStartOf="@+id/ivWorkoutClose"
        app:layout_constraintTop_toTopOf="@+id/ivWorkoutClose" />

    <ImageView
        android:id="@+id/ivWorkoutClose"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="80dp"
        android:padding="12dp"
        android:src="@drawable/ic_add_workout"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>