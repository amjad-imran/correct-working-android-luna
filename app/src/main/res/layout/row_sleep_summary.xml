<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="66dp"
    android:layout_marginTop="8dp"
    android:background="@drawable/back_modal_new_10">

    <ImageView
        android:id="@+id/ivMain"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvTitle"
        style="@style/S14"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textColor="@color/white_80"
        app:layout_constraintBottom_toBottomOf="@+id/ivMain"
        app:layout_constraintStart_toEndOf="@+id/ivMain"
        app:layout_constraintTop_toTopOf="@+id/ivMain"
        tools:text="REM sleep " />

    <TextView
        android:id="@+id/tvPercent"
        style="@style/S20"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/tvPercentChange"
        app:layout_constraintEnd_toStartOf="@+id/textView125"
        app:layout_constraintTop_toTopOf="@+id/ivState"
        tools:text="40" />

    <TextView
        android:id="@+id/textView125"
        style="@style/S14"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="6dp"
        android:text="%"
        android:textColor="@color/white_60"
        app:layout_constraintBaseline_toBaselineOf="@+id/tvPercent"
        app:layout_constraintEnd_toStartOf="@+id/ivState" />

    <TextView
        android:id="@+id/tvPercentChange"
        style="@style/S10"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="6dp"
        android:textColor="@color/white_60"
        app:layout_constraintBottom_toBottomOf="@+id/ivState"
        app:layout_constraintEnd_toStartOf="@+id/ivState"
        app:layout_constraintTop_toBottomOf="@+id/tvPercent"
        tools:text="20% " />

    <ImageView
        android:id="@+id/ivState"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>