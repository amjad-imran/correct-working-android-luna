<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_height="156dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/mvReceivedEmojiView"
                android:layout_width="152dp"
                android:layout_height="32dp"
                android:layout_gravity="end|bottom"
                android:visibility="gone"
                android:layout_marginStart="@dimen/side_margin"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="@dimen/side_margin"
                app:cardBackgroundColor="#464646"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/ivEmojiStrong"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="@dimen/side_margin"
                        android:src="@drawable/ic_strong_emoji"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:ignore="ContentDescription" />

                    <ImageView
                        android:id="@+id/ivEmojiHeart"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="8dp"
                        android:src="@drawable/ic_heart_emoji"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/ivEmojiStrong"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:ignore="ContentDescription" />

                    <ImageView
                        android:id="@+id/ivEmojiFire"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="8dp"
                        android:src="@drawable/ic_fire_emoji"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/ivEmojiHeart"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:ignore="ContentDescription" />

                    <ImageView
                        android:id="@+id/ivEmoji100"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="8dp"
                        android:src="@drawable/ic_100_emoji"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/ivEmojiFire"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:ignore="ContentDescription" />

                    <TextView
                        android:id="@+id/tvEmojiCount"
                        style="@style/H6"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="@dimen/side_margin"
                        android:textColor="@color/very_light_pink"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/ivEmoji100"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:text="6" />
                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/mvGiveEmojiView"
                android:layout_width="208dp"
                android:layout_height="48dp"
                android:visibility="visible"
                android:layout_gravity="start|bottom"
                android:layout_marginStart="@dimen/side_margin"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="@dimen/side_margin"
                app:cardBackgroundColor="#464646"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/ivGiveEmojiStrong"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="@dimen/side_margin"
                        android:src="@drawable/ic_strong_emoji"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:ignore="ContentDescription" />

                    <ImageView
                        android:id="@+id/ivGiveEmojiHeart"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="@dimen/side_margin"
                        android:src="@drawable/ic_heart_emoji"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/ivGiveEmojiStrong"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:ignore="ContentDescription" />

                    <ImageView
                        android:id="@+id/ivGiveEmojiFire"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="@dimen/side_margin"
                        android:src="@drawable/ic_fire_emoji"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/ivGiveEmojiHeart"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:ignore="ContentDescription" />

                    <ImageView
                        android:id="@+id/ivGiveEmoji100"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="@dimen/side_margin"
                        android:layout_marginEnd="@dimen/side_margin"
                        android:src="@drawable/ic_100_emoji"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/ivGiveEmojiFire"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:ignore="ContentDescription" />


                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/materialCardView"
                android:layout_width="match_parent"
                android:layout_height="104dp"
                android:layout_marginStart="@dimen/side_margin"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="@dimen/side_margin"
                app:cardBackgroundColor="@color/modal_color"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/imageViewProfile"
                        android:layout_width="100dp"
                        android:layout_height="match_parent"
                        android:padding="@dimen/side_margin"
                        android:scaleType="centerCrop"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:shapeAppearance="@style/ShapeAppearance.App.CircleImageView"
                        app:srcCompat="@drawable/ic_default_profile_image"
                        tools:ignore="ContentDescription" />


                    <TextView
                        android:id="@+id/textViewTitle"
                        style="@style/H5"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="16dp"
                        app:layout_constraintBottom_toTopOf="@+id/tvCalories"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/imageViewProfile"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:text="Me" />

                    <TextView
                        android:id="@+id/tvCalories"
                        style="@style/Small"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/side_margin"
                        android:layout_marginTop="16dp"
                        android:layout_marginEnd="16dp"
                        android:layout_marginBottom="4dp"
                        android:text="@string/text_calories"
                        android:textColor="@color/friends_calories_color"
                        app:layout_constraintStart_toEndOf="@+id/imageViewProfile"
                        app:layout_constraintTop_toBottomOf="@+id/textViewTitle" />

                    <TextView
                        android:id="@+id/tvCaloriesValue"
                        style="@style/H5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/side_margin"
                        android:layout_marginTop="4dp"
                        android:layout_marginEnd="16dp"
                        android:layout_marginBottom="16dp"
                        android:textColor="@color/very_light_pink"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/imageViewProfile"
                        app:layout_constraintTop_toBottomOf="@+id/tvCalories"
                        tools:text="3" />

                    <TextView
                        android:id="@+id/tvCaloriesUnit"
                        style="@style/H6"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="16dp"
                        android:textColor="@color/very_light_pink"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/tvCaloriesValue"
                        app:layout_constraintTop_toBottomOf="@+id/tvCalories"
                        tools:text="kcal" />

                    <TextView
                        android:id="@+id/tvSteps"
                        style="@style/Small"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/side_margin"
                        android:layout_marginTop="16dp"
                        android:layout_marginEnd="16dp"
                        android:layout_marginBottom="4dp"
                        android:text="@string/text_steps"
                        android:textColor="@color/friends_steps_color"
                        app:layout_constraintEnd_toStartOf="@+id/tvDistance"
                        app:layout_constraintStart_toEndOf="@+id/tvCalories"
                        app:layout_constraintTop_toBottomOf="@+id/textViewTitle" />

                    <TextView
                        android:id="@+id/tvStepsValue"
                        style="@style/H5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="16dp"
                        android:textColor="@color/white"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="@+id/tvSteps"
                        app:layout_constraintTop_toBottomOf="@+id/tvSteps"
                        tools:text="3" />

                    <TextView
                        android:id="@+id/tvDistance"
                        style="@style/Small"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/side_margin"
                        android:layout_marginTop="16dp"
                        android:layout_marginEnd="16dp"
                        android:layout_marginBottom="4dp"
                        android:text="@string/text_distance"
                        android:textColor="@color/friends_distance_color"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/textViewTitle" />

                    <TextView
                        android:id="@+id/tvDistanceValue"
                        style="@style/H5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="16dp"
                        android:textColor="@color/white"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="@+id/tvDistance"
                        app:layout_constraintTop_toBottomOf="@+id/tvDistance"
                        tools:text="3" />

                    <TextView
                        android:id="@+id/tvDistanceUnit"
                        style="@style/H6"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="16dp"
                        android:textColor="@color/very_light_pink"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/tvDistanceValue"
                        app:layout_constraintTop_toBottomOf="@+id/tvDistance"
                        tools:text="kms" />
                </androidx.constraintlayout.widget.ConstraintLayout>


            </com.google.android.material.card.MaterialCardView>

        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
