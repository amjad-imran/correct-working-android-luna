<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/back_meal_type_selector">

    <TextView
        android:id="@+id/tvBreakfast"
        style="@style/S12"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:fontFamily="@font/gilroy_medium"
        android:gravity="center"
        android:paddingHorizontal="12dp"
        android:text="@string/text_breakfast"
        android:textColor="#969696"
        app:layout_constraintEnd_toStartOf="@+id/tvLunch"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvLunch"
        style="@style/S12"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:fontFamily="@font/gilroy_medium"
        android:gravity="center"
        android:paddingHorizontal="12dp"
        android:text="@string/text_lunch"
        android:textColor="#969696"
        app:layout_constraintEnd_toStartOf="@+id/tvDinner"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/tvBreakfast"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvDinner"
        style="@style/S12"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:fontFamily="@font/gilroy_medium"
        android:gravity="center"
        android:paddingHorizontal="12dp"
        android:text="@string/text_dinner"
        android:textColor="#969696"
        app:layout_constraintEnd_toStartOf="@+id/tvSnack"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/tvLunch"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvSnack"
        style="@style/S12"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:fontFamily="@font/gilroy_medium"
        android:gravity="center"
        android:paddingHorizontal="12dp"
        android:text="@string/text_snack"
        android:textColor="#969696"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/tvDinner"
        app:layout_constraintTop_toTopOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>