<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.oreo.ui.notification.EditNotificationGoalFragment">

    <include
        android:id="@+id/toolbar"
        layout="@layout/layout_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />


    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/shapeableImageView14"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="12dp"
        android:background="#202B38"
        app:layout_constraintBottom_toTopOf="@+id/shapeableImageView13"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:shapeAppearance="@style/ShapeAppearanceOverlay.App.CornerSize20dp" />

    <include
        android:id="@+id/lytHydrationPicker"
        layout="@layout/layout_hydration_picker"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@id/shapeableImageView14"
        app:layout_constraintEnd_toEndOf="@id/shapeableImageView14"
        app:layout_constraintStart_toStartOf="@id/shapeableImageView14"
        app:layout_constraintTop_toTopOf="@id/shapeableImageView14" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/shapeableImageView13"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="20dp"
        android:background="#202F38"
        app:layout_constraintBottom_toTopOf="@+id/btnCancel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/shapeableImageView14"
        app:shapeAppearance="@style/ShapeAppearanceOverlay.App.CornerSize20dp" />

    <include
        android:id="@+id/lytStepsPicker"
        layout="@layout/layout_steps_picker"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@id/shapeableImageView13"
        app:layout_constraintEnd_toEndOf="@id/shapeableImageView13"
        app:layout_constraintStart_toStartOf="@id/shapeableImageView13"
        app:layout_constraintTop_toTopOf="@id/shapeableImageView13" />

    <Button
        android:id="@+id/btnCancel"
        style="@style/SecondaryButtonStyle"
        android:layout_width="0dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="20dp"
        android:text="@string/text_cancel"
        app:backgroundTint="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btnSave"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/btnSave"
        style="@style/PrimaryButtonStyle"
        android:layout_width="0dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        android:text="@string/text_save"
        app:backgroundTint="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/btnCancel" />

    <include
        android:id="@+id/progressBar"
        layout="@layout/default_loader"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>