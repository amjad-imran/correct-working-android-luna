<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/back_circadian_frag"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context="com.oreo.ui.circadianAlignment.CircadianAlignmentFrag">

    <include
        android:id="@+id/toolbar"
        layout="@layout/layout_toolbar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
    android:layout_width="0dp"
    android:layout_height="0dp"
    android:fillViewport="true"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toBottomOf="@+id/toolbar">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

    <View
        android:id="@+id/mainGraph"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        app:layout_constraintTop_toBottomOf="@id/layoutToolbar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <include
        android:id="@+id/lytFocusWindow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        layout="@layout/layout_circadian_focus_window" />

    <include
        android:id="@+id/dividerSleepMidPoint"
        layout="@layout/layout_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="24dp" />

    <include
        android:id="@+id/lytSleepMidPoint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        layout="@layout/layout_circadian_sleep_mid_point" />

    <include
        android:id="@+id/dividerActivityMonitor"
        layout="@layout/layout_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="24dp" />

    <include
        android:id="@+id/lytActivityMonitor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        layout="@layout/layout_circadian_activity_monitor" />

    <include
        android:id="@+id/dividerCorrectiveActivities"
        layout="@layout/layout_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="24dp" />

    <include
        android:id="@+id/lytCorrectiveActivities"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        layout="@layout/layout_circadian_corrective_activities" />

    <include
        android:id="@+id/dividerYourChronotype"
        layout="@layout/layout_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="24dp" />

    <include
        android:id="@+id/lytYourChronotype"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        layout="@layout/layout_your_chronotype_circadian" />

    </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <include
        android:id="@+id/progressBar"
        layout="@layout/default_loader"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

</androidx.constraintlayout.widget.ConstraintLayout>