<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".ui.challengeNew.list.ChallengeListingFragment">

        <TextView
            android:id="@+id/tvUpdatedLast"
            style="@style/Small"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:visibility="gone"
            tools:visibility="visible"
            android:gravity="bottom"
            android:layout_marginHorizontal="@dimen/side_margin"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Updated 2 mins ago" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvTabs"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:layout_marginTop="24dp"
            android:paddingStart="@dimen/side_margin"
            android:paddingEnd="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvUpdatedLast" />

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/vpWatchFace"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/rvTabs" />

        <RelativeLayout
            android:id="@+id/lytPullToRefresh"
            android:layout_width="match_parent"
            android:background="#AA000000"
            android:visibility="gone"
            android:layout_height="match_parent">

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/lottieAnimViewPullToRefresh"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="100dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:lottie_autoPlay="true"
                app:lottie_rawRes="@raw/anim_pull_to_refresh" />

        </RelativeLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>