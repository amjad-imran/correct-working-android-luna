<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_lifeos_ques_onboarding"
    tools:context="com.oreo.ui.lifeos.LifeOsDashFragment">

    <include
        android:id="@+id/lytToolbar"
        layout="@layout/toolbar_life_os"
        android:layout_width="match_parent"
        android:layout_height="56dp" />

    <ScrollView
        android:id="@+id/svMain"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/lytToolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include
                android:id="@+id/lytHeader"
                android:layout_marginTop="40dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                layout="@layout/layout_life_os_header"/>


            <include
                android:id="@+id/lytDashInsights"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                layout="@layout/layout_dash_insights"/>

            <include
                android:id="@+id/lytDashWhatsNew"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                layout="@layout/layout_ai_dash_whats_new"/>




        </LinearLayout>
    </ScrollView>


</androidx.constraintlayout.widget.ConstraintLayout>