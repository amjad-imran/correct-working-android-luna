<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        tools:context=".ui.summary.graph.GraphFragment">

        <include
            android:id="@+id/hrLineSeparator"
            layout="@layout/layout_line_separator"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/llHrGraph"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="16dp"
            android:layout_marginStart="24dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/gilroy_medium"
                android:text="@string/text_average_heart_rate"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_hr_gradient" />

                    <TextView
                        android:id="@+id/tvHrAvg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/gilroy_medium"
                        android:paddingStart="5dp"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        tools:text="105" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llHrMin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_marginEnd="20dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:alpha="0.55"
                        android:fontFamily="@font/gilroy_medium"
                        android:text="Min"
                        android:textColor="@color/white"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvHrMin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/gilroy_medium"
                        android:text="-"
                        android:textColor="@color/white"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="20dp"
                    android:layout_toStartOf="@id/llHrMin"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:alpha="0.55"
                        android:fontFamily="@font/gilroy_medium"
                        android:text="Max"
                        android:textColor="@color/white"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvHrMax"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/gilroy_medium"
                        android:text="-"
                        android:textColor="@color/white"
                        android:textSize="12sp" />
                </LinearLayout>
            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="-13dp"
                android:background="@drawable/center_flat_back"
                android:orientation="vertical"
                android:padding="16dp">

                <com.github.mikephil.charting.charts.CandleStickChart
                    android:id="@+id/candleChart"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:visibility="visible" />

                <TextView
                    android:id="@+id/tvHrStartTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/candleChart"
                    android:fontFamily="@font/gilroy_medium"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    tools:text="3.00am" />

                <TextView
                    android:id="@+id/tvHrEndTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/candleChart"
                    android:layout_alignParentEnd="true"
                    android:layout_marginEnd="@dimen/dimen_16dp"
                    android:fontFamily="@font/gilroy_medium"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    tools:text="3.00am" />
            </RelativeLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llHrZones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginVertical="16dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/gilroy_medium"
                android:text="@string/text_heart_rate_zones"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">

                <TextView
                    android:id="@+id/tv11"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.55"
                    android:fontFamily="@font/gilroy_medium"
                    android:text="@string/text_extreme_workout"
                    android:textColor="@color/white"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvExtreme"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:fontFamily="@font/gilroy_medium"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    tools:text="12 min" />

                <ProgressBar
                    android:id="@+id/pbExtreme"
                    style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="5dp"
                    android:layout_below="@id/tv11"
                    android:layout_marginTop="3dp"
                    android:background="@drawable/back_gray_custom_hz_progress"
                    android:max="100"
                    android:progress="20"
                    android:progressDrawable="@drawable/back_aerobic_zone_custom_progress" />


            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">

                <TextView
                    android:id="@+id/tv1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.55"
                    android:fontFamily="@font/gilroy_medium"
                    android:text="@string/text_aerobic"
                    android:textColor="@color/white"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvAerobic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:fontFamily="@font/gilroy_medium"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    tools:text="12 min" />

                <ProgressBar
                    android:id="@+id/pbAerobic"
                    style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="5dp"
                    android:layout_below="@id/tv1"
                    android:layout_marginTop="3dp"
                    android:background="@drawable/back_gray_custom_hz_progress"
                    android:max="100"
                    android:progress="20"
                    android:progressDrawable="@drawable/back_aerobic_zone_custom_progress" />


            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">

                <TextView
                    android:id="@+id/tv2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.55"
                    android:fontFamily="@font/gilroy_medium"
                    android:text="@string/text_anaerobic"
                    android:textColor="@color/white"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvAnaerobic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:fontFamily="@font/gilroy_medium"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    tools:text="12 min" />

                <ProgressBar
                    android:id="@+id/pbAnaerobic"
                    style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="5dp"
                    android:layout_below="@id/tv2"
                    android:layout_marginTop="3dp"
                    android:background="@drawable/back_gray_custom_hz_progress"
                    android:max="100"
                    android:progress="20"
                    android:progressDrawable="@drawable/back_anaerobic_zone_custom_progress" />


            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">

                <TextView
                    android:id="@+id/tv3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.55"
                    android:fontFamily="@font/gilroy_medium"
                    android:text="@string/text_fat_burn"
                    android:textColor="@color/white"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvFatBurn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:fontFamily="@font/gilroy_medium"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    tools:text="12 min" />

                <ProgressBar
                    android:id="@+id/pbFatBurn"
                    style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="5dp"
                    android:layout_below="@id/tv3"
                    android:layout_marginTop="3dp"
                    android:background="@drawable/back_gray_custom_hz_progress"
                    android:max="100"
                    android:progress="20"
                    android:progressDrawable="@drawable/back_fat_burn_zone_custom_progress" />


            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">

                <TextView
                    android:id="@+id/tv4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.55"
                    android:fontFamily="@font/gilroy_medium"
                    android:text="@string/text_warm_up"
                    android:textColor="@color/white"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvWarmup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:fontFamily="@font/gilroy_medium"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    tools:text="12 min" />

                <ProgressBar
                    android:id="@+id/pbWarmup"
                    style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="5dp"
                    android:layout_below="@id/tv4"
                    android:layout_marginTop="3dp"
                    android:background="@drawable/back_gray_custom_hz_progress"
                    android:max="100"
                    android:progress="20"
                    android:progressDrawable="@drawable/back_warm_up_zone_custom_progress" />


            </RelativeLayout>

        </LinearLayout>

        <include
            android:id="@+id/caloriesLineSeparator"
            layout="@layout/layout_line_separator"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/llCalorieGraph"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="16dp"
            android:layout_marginStart="24dp"
            android:orientation="vertical"
            android:visibility="gone">


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/gilroy_medium"
                android:text="Calories"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_calorie_gradient" />

                    <TextView
                        android:id="@+id/tvCalorie"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/gilroy_medium"
                        android:paddingStart="5dp"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        tools:text="105" />
                </LinearLayout>

            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="-13dp"
                android:background="@drawable/center_flat_back"
                android:orientation="vertical"
                android:padding="16dp">

                <com.noisefit_commans.utils.RoundedBarChart
                    android:id="@+id/barChartCalorie"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:visibility="visible" />

                <TextView
                    android:id="@+id/tvCalorieStartTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:fontFamily="@font/gilroy_medium"
                    android:paddingStart="16dp"
                    android:textColor="@color/white"
                    android:textSize="12sp" />
            </RelativeLayout>
        </LinearLayout>


    </LinearLayout>
</layout>