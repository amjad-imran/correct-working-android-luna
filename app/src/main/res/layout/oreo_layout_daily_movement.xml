<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:lineChart="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:background="@color/black">

        <TextView
            android:id="@+id/tvTitle"
            style="@style/H5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/side_margin"
            android:layout_marginTop="24dp"
            android:text="@string/text_daytime_movement"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/bInfo"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="@dimen/side_margin"
            android:background="@drawable/circle_black"
            android:gravity="center"
            android:visibility="invisible"
            android:src="@drawable/ic_info_oreo"
            app:layout_constraintBottom_toBottomOf="@id/tvTitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvTitle"
            tools:ignore="ContentDescription" />


        <com.oreo.ui.custom.CandleChart
            android:id="@+id/candleChart"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginStart="@dimen/dimen_16dp"
            android:layout_marginTop="@dimen/dimen_24dp"
            android:layout_marginEnd="@dimen/dimen_16dp"
            app:layout_constraintBottom_toTopOf="@id/lytDMGStatus"
            app:layout_constraintTop_toBottomOf="@+id/tvTitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            lineChart:bgBottomColor="@android:color/transparent"
            lineChart:bgColor="@android:color/transparent"
            lineChart:bgLeftColor="@android:color/transparent"
            lineChart:bgRightColor="@android:color/transparent"
            lineChart:bgTopColor="@android:color/transparent"
            lineChart:bottomWith="30dp"
            lineChart:centerLineColor="#80ffffff"
            lineChart:centerLineWidth="5dp"
            lineChart:chartLineColor="#C4A9F5"
            lineChart:chartLineWidth="2dp"
            lineChart:gridColor="#80FFFFFF"
            lineChart:hCount="11"
            lineChart:innerCircleColor="#ffffff"
            lineChart:innerCircleRadius="4dp"
            lineChart:leftWith="0dp"
            lineChart:lineNormalColor="#7B63A7"
            lineChart:lineSelectColor="#B18DF2"
            lineChart:rightWith="0dp"
            lineChart:scaleColor="#ff000000"
            lineChart:scaleNodeColor="#FFFFFF"
            lineChart:scaleNodeRadius="6dp"
            lineChart:showAvgValue="false"
            lineChart:showGrid="false"
            lineChart:topWith="0dp"
            lineChart:vCount="2"
            lineChart:xLineColor="#80FFFFFF"
            lineChart:xMax="100"
            lineChart:xMin="0"
            lineChart:xTextColor="#a3ffffff"
            lineChart:xTextSize="12sp"
            lineChart:yLineColor="#00FFFFFF"
            lineChart:yTextColor="@android:color/transparent"
            lineChart:yTextSize="12sp" />


        <include
            android:id="@+id/lytDMGStatus"
            layout="@layout/oreo_layout_d_m_graph_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/candleChart" />


        <include
            android:id="@+id/lytDMHigh"
            layout="@layout/oreo_item_daily_movement"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/lytDMGStatus" />

        <include
            android:id="@+id/lytDMMed"
            layout="@layout/oreo_item_daily_movement"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/lytDMHigh" />

        <include
            android:id="@+id/lytDMLow"
            layout="@layout/oreo_item_daily_movement"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/lytDMMed" />

        <include
            android:id="@+id/lytDMInactive"
            layout="@layout/oreo_item_daily_movement"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/lytDMLow" />


    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
