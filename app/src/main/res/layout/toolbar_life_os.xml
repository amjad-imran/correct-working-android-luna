<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/view1"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/back_modal_new_round"
        android:padding="10dp"
        android:layout_marginStart="16dp"
        android:src="@drawable/ic_ai_insight"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/image_life_os_logo"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <ImageView
        android:id="@+id/imageView114"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_marginEnd="16dp"
        android:src="@drawable/back_modal_new_round"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/ivNewChat"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/ivNewChat"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:padding="10dp"
        android:src="@drawable/ic_ai_new"
        app:layout_constraintBottom_toBottomOf="@+id/imageView114"
        app:layout_constraintEnd_toStartOf="@+id/ivHistory"
        app:layout_constraintTop_toTopOf="@+id/imageView114" />

    <ImageView
        android:id="@+id/ivHistory"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginEnd="16dp"
        android:padding="10dp"
        android:src="@drawable/ic_ai_history_2"
        app:layout_constraintBottom_toBottomOf="@+id/imageView114"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/imageView114" />


</androidx.constraintlayout.widget.ConstraintLayout>