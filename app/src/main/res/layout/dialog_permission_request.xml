<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/background_dialog"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/gilroy_medium"
        android:gravity="center"
        android:text="@string/text_permission_required"
        android:textColor="@color/md_theme_dark_text_color_h2"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/tvPermissionText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:fontFamily="@font/gilroy_medium"
        android:textColor="@color/md_theme_dark_text_color_h2"
        android:textSize="14sp"
        tools:text="@string/text_new_features" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/bContinue"
        style="@style/PrimaryButtonStyle"
        android:layout_width="match_parent"
        android:layout_marginTop="24dp"
        android:text="@string/text_continue"
        app:backgroundTint="@null" />

</LinearLayout>