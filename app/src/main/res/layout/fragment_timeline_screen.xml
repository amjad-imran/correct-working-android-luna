<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:lineChart="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.oreo.ui.timelineScreen.TimelineScreenFragment">

    <ImageView
        android:id="@+id/imageBg"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:background="@drawable/back_timeline_screen" />

    <include
        android:id="@+id/lytToolbar"
        layout="@layout/oreo_layout_toolbar_with_2_icons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.oreo.ui.custom.TabLayoutCustom
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/lytToolbar"
        lineChart:bgBottomColor="@android:color/transparent"
        lineChart:bgColor="@android:color/transparent"
        lineChart:bgLeftColor="@android:color/transparent"
        lineChart:bgRightColor="@android:color/transparent"
        lineChart:bgTopColor="@android:color/transparent"
        lineChart:bottomWith="30dp"
        lineChart:centerLineColor="@color/white_80"
        lineChart:centerLineWidth="3dp"
        lineChart:chartLineColor="@color/sleep_chart_line_color"
        lineChart:chartLineWidth="2dp"
        lineChart:fillColorEnd="@color/sleep_fill_end_color"
        lineChart:fillColorStart="@color/sleep_fill_start_color"
        lineChart:gridColor="@color/white_12"
        lineChart:hCount="11"
        lineChart:innerCircleColor="#e9d4ff"
        lineChart:innerCircleRadius="4dp"
        lineChart:leftWith="0dp"
        lineChart:outCircleColor="#66aa5bff"
        lineChart:outCircleRadius="1dp"
        lineChart:rightWith="0dp"
        lineChart:scaleColor="#ff000000"
        lineChart:scaleLenth="4dp"
        lineChart:scaleNodeColor="#FFFFFF"
        lineChart:scaleNodeRadius="6dp"
        lineChart:showGrid="true"
        lineChart:topWith="40dp"
        lineChart:vCount="2"
        lineChart:xLineColor="#80FFFFFF"
        lineChart:xMax="130"
        lineChart:xMin="0"
        lineChart:xTextColor="#FFFFFF"
        lineChart:xTextSize="16sp"
        lineChart:yLineColor="#00FFFFFF"
        lineChart:yTextSize="12sp" />

    <include
        android:id="@+id/lytSetupHabits"
        layout="@layout/layout_setup_habits_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:visibility="gone"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tabLayout" />

    <include
        android:id="@+id/lytSavedHabits"
        layout="@layout/layout_user_saved_habits_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:visibility="gone"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/lytSetupHabits" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPagerTimeline"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/lytSavedHabits" />

    <ImageView
        android:id="@+id/ivAddLogFab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:src="@drawable/ic_add_log_fab_timeline"
        lineChart:layout_constraintBottom_toBottomOf="parent"
        lineChart:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>