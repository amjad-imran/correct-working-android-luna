<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".ui.watchface.WatchFaceUpdateFragment">

        <include
            android:id="@+id/toolbar"
            layout="@layout/layout_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.0" />

        <TextView
            android:id="@+id/tvFeedBack"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="@+id/toolbar"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/layoutMain"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginBottom="@dimen/dimen_16dp"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@+id/bUpdateWatchFace"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/toolbar"
            tools:visibility="visible">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/ivWatchFace"
                    android:layout_width="128dp"
                    android:layout_height="148dp"
                    android:layout_marginStart="@dimen/side_margin"
                    android:layout_marginTop="24dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <com.varunest.sparkbutton.SparkButton
                    android:id="@+id/ivFavourite"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    app:layout_constraintBottom_toBottomOf="@+id/ivFavouriteBack"
                    app:layout_constraintEnd_toEndOf="@+id/ivFavouriteBack"
                    app:layout_constraintStart_toStartOf="@+id/ivFavouriteBack"
                    app:layout_constraintTop_toTopOf="@+id/ivFavouriteBack"
                    app:sparkbutton_activeImage="@drawable/ic_favourite_active"
                    app:sparkbutton_iconSize="22dp"
                    app:sparkbutton_inActiveImage="@drawable/ic_favourite_default"
                    app:sparkbutton_primaryColor="@color/darker_gray"
                    app:sparkbutton_secondaryColor="@color/colorRed2" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivFavouriteBack"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="28dp"
                    android:background="@drawable/back_modal_new_round"
                    app:layout_constraintBottom_toBottomOf="@+id/ivWatchFace"
                    app:layout_constraintStart_toEndOf="@+id/ivWatchFace"
                    app:shapeAppearance="@style/ShapeAppearance.App.CircleImageView" />

                <ImageView
                    android:id="@+id/imageView25"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginStart="28dp"
                    android:adjustViewBounds="true"
                    android:src="@drawable/ic_downloads"
                    android:visibility="gone"
                    app:layout_constraintStart_toEndOf="@+id/ivWatchFace"
                    app:layout_constraintTop_toTopOf="@+id/ivWatchFace"
                    tools:visibility="visible" />

                <ImageView
                    android:id="@+id/imageView26"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginStart="28dp"
                    android:layout_marginTop="36dp"
                    android:adjustViewBounds="true"
                    android:src="@drawable/ic_downloads"
                    app:layout_constraintStart_toEndOf="@+id/ivWatchFace"
                    app:layout_constraintTop_toBottomOf="@+id/imageView25" />

                <TextView
                    android:id="@+id/tvCurrentInUse"
                    style="@style/Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:textColor="@color/very_light_pink"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="@+id/imageView25"
                    app:layout_constraintStart_toEndOf="@+id/imageView25"
                    app:layout_constraintTop_toTopOf="@+id/imageView25"
                    tools:text="1000 +"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/textInUse"
                    style="@style/Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/text_user_currently_using"
                    android:visibility="gone"
                    app:layout_constraintStart_toStartOf="@+id/imageView25"
                    app:layout_constraintTop_toBottomOf="@+id/imageView25"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/tvWatchFaceDownloads"
                    style="@style/Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:textColor="@color/very_light_pink"
                    app:layout_constraintBottom_toBottomOf="@+id/imageView26"
                    app:layout_constraintStart_toEndOf="@+id/imageView26"
                    app:layout_constraintTop_toTopOf="@+id/imageView26"
                    tools:text="4000 +" />

                <TextView
                    style="@style/Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/text_total_downloads"
                    app:layout_constraintStart_toStartOf="@+id/imageView26"
                    app:layout_constraintTop_toBottomOf="@+id/imageView26" />

                <View
                    android:id="@+id/view7"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="32dp"
                    android:background="#434343"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/ivWatchFace" />

                <TextView
                    android:id="@+id/textView18"
                    style="@style/H5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:layout_marginTop="24dp"
                    android:text="@string/text_about"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/view7" />

                <TextView
                    android:id="@+id/tvAbout"
                    style="@style/Small"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="24dp"
                    android:alpha="0.6"
                    android:lineSpacingExtra="2sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/textView18"
                    tools:text="I have detailed below the most cost effective forms of internet marketing to advertising your business using your company website. HTPcompany.com provides marketing, Internet advertising." />

                <View
                    android:id="@+id/view8"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="24dp"
                    android:background="#434343"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvAbout" />

                <TextView
                    android:id="@+id/textView19"
                    style="@style/H5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:layout_marginTop="24dp"
                    android:text="@string/text_similar_watchfaces"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/view8" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvSimilarWatchFace"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="@dimen/dimen_24dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/textView19" />
            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.core.widget.NestedScrollView>


        <com.google.android.material.button.MaterialButton
            android:id="@+id/bUpdateWatchFace"
            style="@style/PrimaryButtonStyle"
            android:layout_marginStart="@dimen/side_margin"
            android:layout_marginEnd="@dimen/side_margin"
            android:layout_marginBottom="@dimen/dimen_24dp"
            android:text="@string/text_update_watchface"
            android:visibility="gone"
            app:backgroundTint="@null"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:visibility="visible" />

        <include
            android:id="@+id/progressBar"
            layout="@layout/default_loader"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>