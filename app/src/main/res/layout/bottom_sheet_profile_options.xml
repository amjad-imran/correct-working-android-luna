<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent">

        <androidx.constraintlayout.widget.ConstraintLayout
            style="@style/ModalStyleDialogNew"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimen_12dp"
            android:layout_marginTop="@dimen/dimen_12dp"
            android:layout_marginEnd="@dimen/dimen_12dp"
            android:layout_marginBottom="@dimen/dimen_12dp"
            android:paddingBottom="@dimen/dimen_24dp">

            <com.google.android.material.divider.MaterialDivider
                android:id="@+id/divider"
                android:layout_width="@dimen/dimen_80dp"
                android:layout_height="2dp"
                android:layout_marginTop="@dimen/dimen_4dp"
                android:background="#29000000"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />


            <TextView
                android:id="@+id/tvEditMyProfile"
                style="@style/H5"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginStart="@dimen/side_margin"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="@dimen/side_margin"
                android:background="@drawable/back_modal_new"
                android:drawablePadding="8dp"
                android:gravity="center|start"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/text_edit_my_profile"
                app:drawableEndCompat="@drawable/ic_arrow_long_right"
                app:drawableStartCompat="@drawable/ic_edit_dt"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/divider" />
            <TextView
                android:id="@+id/tvGuidelines"
                style="@style/H5"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginStart="@dimen/side_margin"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="@dimen/side_margin"
                android:background="@drawable/back_modal_new"
                android:drawablePadding="8dp"
                android:gravity="center|start"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/text_view_community_guidelines"
                android:visibility="gone"
                app:drawableEndCompat="@drawable/ic_arrow_long_right"
                app:drawableStartCompat="@drawable/ic_guidelines_feeds"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvEditMyProfile"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/tvComputeNow"
                style="@style/H5"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginStart="@dimen/side_margin"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="@dimen/side_margin"
                android:background="@drawable/back_modal_new"
                android:drawablePadding="8dp"
                android:gravity="center|start"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/text_compete_now"
                android:visibility="gone"
                app:drawableEndCompat="@drawable/ic_arrow_long_right"
                app:drawableStartCompat="@drawable/ic_my_badges_dt"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvGuidelines"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/tvRemoveFriend"
                style="@style/H5"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginStart="@dimen/side_margin"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="@dimen/side_margin"
                android:background="@drawable/back_modal_new"
                android:drawablePadding="8dp"
                android:gravity="center|start"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/text_remove_friend"
                android:visibility="gone"
                app:drawableEndCompat="@drawable/ic_arrow_long_right"
                app:drawableStartCompat="@drawable/ic_remove_f"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvComputeNow"
                tools:visibility="visible" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </RelativeLayout>
</layout>