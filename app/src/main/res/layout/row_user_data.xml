<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="1dp">
        <TextView
            android:id="@+id/tvActivityName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Small"
            android:gravity="center_horizontal"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:text="TextView" />

        <ImageView
            android:id="@+id/activityIconImageView"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginTop="@dimen/dimen_4dp"
            app:layout_constraintEnd_toStartOf="@+id/activityNameTextView"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvActivityName"
            android:src="@drawable/ic_act_stress"
            tools:ignore="ContentDescription" />

        <TextView
            android:id="@+id/activityNameTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            style="@style/H6"
            android:gravity="center_horizontal"
            tools:text="TextView"
            app:layout_constraintBottom_toBottomOf="@+id/activityIconImageView"
            app:layout_constraintStart_toEndOf="@+id/activityIconImageView"
            app:layout_constraintTop_toTopOf="@+id/activityIconImageView" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>