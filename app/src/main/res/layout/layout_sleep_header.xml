<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/container"
        style="@style/ModalStyleNew"
        android:layout_marginTop="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/dimen_16dp">


        <TextView
            android:id="@+id/textView5"
            style="@style/H5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/text_sleep"
            android:textColor="@android:color/white"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvTime"
            style="@style/Tinny"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_4dp"
            android:textColor="@color/white_50"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView5"
            tools:text="5 mins ago" />


        <ImageView
            android:id="@+id/imageView7"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_sleep"
            app:layout_constraintBottom_toBottomOf="@+id/tvSleepHour"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvSleepHour" />

        <TextView
            android:id="@+id/tvSleepHour"
            style="@style/H2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimen_4dp"
            android:layout_marginTop="@dimen/dimen_24dp"
            app:layout_constraintStart_toEndOf="@+id/imageView7"
            app:layout_constraintTop_toBottomOf="@+id/tvTime"
            tools:text="8" />

        <TextView
            android:id="@+id/textHour"
            style="@style/Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="@dimen/dimen_2dp"
            android:text="hrs"
            android:textColor="@color/very_light_pink"
            app:layout_constraintBottom_toBottomOf="@+id/tvSleepHour"
            app:layout_constraintStart_toEndOf="@+id/tvSleepHour" />

        <TextView
            android:id="@+id/tvSleepMinute"
            style="@style/H2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="10dp"
            app:layout_constraintBottom_toBottomOf="@+id/tvSleepHour"
            app:layout_constraintStart_toEndOf="@+id/textHour"
            tools:text="32" />

        <TextView
            android:id="@+id/textMins"
            style="@style/Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="@dimen/dimen_2dp"
            android:text="@string/text_mins"
            android:textColor="@color/very_light_pink"
            app:layout_constraintBottom_toBottomOf="@+id/tvSleepMinute"
            app:layout_constraintStart_toEndOf="@+id/tvSleepMinute" />


        <ImageView
            android:id="@+id/imageView14"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:adjustViewBounds="true"
            android:alpha="0.5"
            android:contentDescription="@null"
            android:src="@drawable/ic_arrow_right_duotone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <TextView
            android:id="@+id/tvNoData"
            style="@style/Small"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:text="@string/text_no_data_recorded"
            android:textColor="@color/white_80"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@+id/imageView7"
            app:layout_constraintEnd_toStartOf="@+id/tvAvg"
            app:layout_constraintStart_toEndOf="@+id/imageView7"
            app:layout_constraintTop_toTopOf="@+id/imageView7"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tvAvg"
            style="@style/Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white_80"
            app:layout_constraintBottom_toBottomOf="@+id/tvSleepHour"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="All day average" />
    </androidx.constraintlayout.widget.ConstraintLayout>


</layout>