<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="32dp">

        <include
            android:id="@+id/include19"
            layout="@layout/layout_line_separator"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <include
            android:id="@+id/lytLike"
            layout="@layout/layout_post_like"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/side_margin"
            android:layout_marginTop="32dp"
            android:layout_marginEnd="@dimen/side_margin"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:visibility="visible" />


        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/profileImv"
            android:layout_width="@dimen/dimen_48dp"
            android:layout_height="@dimen/dimen_48dp"
            android:layout_marginStart="@dimen/dimen_16dp"
            android:layout_marginTop="32dp"
            android:scaleType="centerCrop"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/lytLike"
            app:shapeAppearance="@style/ShapeAppearance.App.CircleImageView"
            app:strokeColor="@color/white_12"
            app:strokeWidth="1dp" />

        <TableLayout
            android:id="@+id/tableName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimen_16dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintEnd_toStartOf="@+id/btnAction"
            app:layout_constraintStart_toEndOf="@+id/profileImv"
            app:layout_constraintTop_toTopOf="@+id/profileImv">

            <TableRow
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical">

                <TextView
                    android:id="@+id/tvName"
                    style="@style/H5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    tools:text="Deepak yadav" />

                <ImageView
                    android:id="@+id/imvVerified"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="2dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_verified"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </TableRow>


        </TableLayout>

        <TextView
            android:id="@+id/tvTime"
            style="@style/Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white_80"
            app:layout_constraintBottom_toBottomOf="@+id/profileImv"
            app:layout_constraintStart_toStartOf="@+id/tableName"
            app:layout_constraintTop_toBottomOf="@+id/tableName"
            tools:text="10 hours ago" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/vCircle"
            android:layout_width="4dp"
            android:layout_height="4dp"
            android:layout_marginStart="8dp"
            android:background="@color/white_48"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/tvTime"
            app:layout_constraintStart_toEndOf="@id/tvTime"
            app:layout_constraintTop_toTopOf="@+id/tvTime"
            app:shapeAppearance="@style/ShapeAppearance.Material3.SmallComponent"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tvLocation"
            style="@style/Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/white_80"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@+id/tvTime"
            app:layout_constraintStart_toEndOf="@id/vCircle"
            app:layout_constraintTop_toTopOf="@+id/tvTime"
            tools:text="Location"
            tools:visibility="visible" />

        <ImageButton
            android:id="@+id/btnAction"
            android:layout_width="@dimen/dimen_24dp"
            android:layout_height="@dimen/dimen_24dp"
            android:layout_marginEnd="@dimen/dimen_16dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_horizontal_more"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@+id/profileImv"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/profileImv"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tvContent"
            style="@style/H6"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimen_16dp"
            android:layout_marginTop="@dimen/dimen_24dp"
            android:layout_marginEnd="@dimen/dimen_16dp"
            android:ellipsize="end"
            android:maxLines="10"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/profileImv"
            tools:text="User written caption will come here. “#” tags should have the colour like #ShorRukegaNahi..." />

        <TextView
            android:id="@+id/tvReadMore"
            style="@style/H6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingTop="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp"
            android:text="@string/text_read_more"
            android:textColor="@color/accent_color_purple"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="@+id/tvContent"
            app:layout_constraintTop_toBottomOf="@+id/tvContent"
            tools:visibility="visible" />


        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/contentImv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimen_16dp"
            android:layout_marginTop="@dimen/dimen_24dp"
            android:layout_marginEnd="@dimen/dimen_16dp"
            android:adjustViewBounds="true"
            android:padding="1dp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvReadMore"
            app:shapeAppearance="@style/ShapeAppearanceOverlay.App.CornerSize10dp"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.CornerSize10dp"
            app:strokeColor="#19ffffff"
            app:strokeWidth="1dp"
            tools:visibility="visible" />

        <include
            android:id="@+id/lytSvPlayer"
            layout="@layout/layout_feed_player"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/side_margin"
            android:layout_marginTop="@dimen/dimen_24dp"
            android:layout_marginEnd="@dimen/side_margin"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@+id/contentImv" />


        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivEmoji"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="@dimen/dimen_16dp"
            android:background="@drawable/back_modal_new_round"
            android:scaleType="centerCrop"

            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/lytSvPlayer"
            app:shapeAppearance="@style/ShapeAppearance.App.CircleImageView" />

        <ImageView
            android:id="@+id/ivEmojiImage"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:src="@drawable/ic_post_emoji"
            app:layout_constraintBottom_toBottomOf="@+id/ivEmoji"
            app:layout_constraintEnd_toEndOf="@+id/ivEmoji"
            app:layout_constraintStart_toStartOf="@+id/ivEmoji"
            app:layout_constraintTop_toTopOf="@+id/ivEmoji" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivComments"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="@dimen/dimen_8dp"
            android:layout_marginTop="@dimen/dimen_16dp"
            android:background="@drawable/back_modal_new_round"
            android:scaleType="centerCrop"
            app:layout_constraintStart_toEndOf="@+id/ivEmoji"
            app:layout_constraintTop_toBottomOf="@+id/lytSvPlayer"
            app:shapeAppearance="@style/ShapeAppearance.App.CircleImageView" />

        <ImageView
            android:id="@+id/ivCommentsImage"
            android:layout_width="@dimen/dimen_20dp"
            android:layout_height="@dimen/dimen_20dp"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:src="@drawable/ic_post_comment"
            app:layout_constraintBottom_toBottomOf="@+id/ivComments"
            app:layout_constraintEnd_toEndOf="@+id/ivComments"
            app:layout_constraintStart_toStartOf="@+id/ivComments"
            app:layout_constraintTop_toTopOf="@+id/ivComments" />

        <TextView
            android:id="@+id/tvComments"
            style="@style/H6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/dimen_16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:textColor="@color/white_64"
            app:layout_constraintBottom_toBottomOf="@+id/ivEmoji"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/ivEmoji"
            tools:text="View 7 Comments" />

        <LinearLayout
            android:id="@+id/emojiView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_16dp"
            app:layout_constraintStart_toStartOf="@+id/ivEmoji"
            app:layout_constraintTop_toBottomOf="@+id/ivEmoji">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imageViewCircle1"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="#101010"
                android:scaleType="fitCenter"
                app:contentPadding="4dp"
                app:shapeAppearance="@style/ShapeAppearance.App.CircleImageView"
                app:strokeColor="#19ffffff"
                app:strokeWidth="1dp" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imageViewCircle2"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="-6dp"
                android:background="#101010"
                android:scaleType="fitCenter"
                app:contentPadding="4dp"
                app:shapeAppearance="@style/ShapeAppearance.App.CircleImageView"
                app:strokeColor="#19ffffff"
                app:strokeWidth="1dp" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imageViewCircle3"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="-6dp"
                android:background="#101010"
                android:scaleType="fitCenter"
                app:contentPadding="4dp"
                app:shapeAppearance="@style/ShapeAppearance.App.CircleImageView"
                app:strokeColor="#19ffffff"
                app:strokeWidth="1dp" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imageViewCircle4"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="-6dp"
                android:background="#101010"
                android:scaleType="fitCenter"
                app:contentPadding="4dp"
                app:shapeAppearance="@style/ShapeAppearance.App.CircleImageView"
                app:strokeColor="#19ffffff"
                app:strokeWidth="1dp" />
        </LinearLayout>


        <TextView
            android:id="@+id/tvLikeCount"
            style="@style/H6"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimen_8dp"
            android:layout_marginEnd="@dimen/dimen_16dp"
            android:maxLines="2"
            android:paddingTop="@dimen/dimen_8dp"
            android:paddingBottom="@dimen/dimen_8dp"
            app:layout_constraintBottom_toBottomOf="@+id/emojiView"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/emojiView"
            app:layout_constraintTop_toTopOf="@+id/emojiView"
            tools:text="80100" />

        <include
            android:id="@+id/include18"
            layout="@layout/layout_line_separator"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_margin="@dimen/dimen_16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/emojiView" />

        <include
            android:id="@+id/lytComment"
            layout="@layout/layout_original_post_comment"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/include18"
            app:layout_constraintStart_toStartOf="@+id/include18"
            app:layout_constraintTop_toBottomOf="@+id/include18" />


    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>