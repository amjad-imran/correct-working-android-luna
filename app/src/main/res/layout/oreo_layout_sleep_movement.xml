<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTitle"
            style="@style/H5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/side_margin"
            android:layout_marginTop="31dp"
            android:layout_marginEnd="@dimen/side_margin"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Heart Rate" />

        <ImageView
            android:id="@+id/bInfo"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="@dimen/side_margin"
            android:background="@drawable/circle_black"
            android:gravity="center"
            android:src="@drawable/ic_info_oreo"
            app:layout_constraintBottom_toBottomOf="@id/tvTitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvTitle"
            tools:ignore="ContentDescription" />

        <TextView
            android:id="@+id/tvSubtitle1"
            style="@style/H6"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/white_80"
            android:textSize="12sp"
            app:layout_constraintEnd_toStartOf="@+id/divider1"
            app:layout_constraintStart_toStartOf="@id/tvTitle"
            app:layout_constraintTop_toTopOf="@id/divider1"
            tools:text="Lowest heart rate" />

        <include
            android:id="@+id/lytSubtitleValue1"
            layout="@layout/oreo_layout_view_with_bpm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:layout_constraintBottom_toBottomOf="@id/divider1"
            app:layout_constraintStart_toStartOf="@id/tvSubtitle1" />

        <include
            android:id="@+id/divider1"
            layout="@layout/layout_divider"
            android:layout_width="1dp"
            android:layout_height="56dp"
            android:layout_marginTop="11dp"
            android:layout_marginBottom="32dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTitle" />

        <TextView
            android:id="@+id/tvSubtitle2"
            style="@style/H6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/white_80"
            android:textSize="12sp"
            app:layout_constraintStart_toEndOf="@+id/divider1"
            app:layout_constraintTop_toTopOf="@id/divider1"
            tools:text="Lowest heart rate" />

        <include
            android:id="@+id/lytSubtitleValue2"
            layout="@layout/oreo_layout_view_with_bpm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:layout_constraintBottom_toBottomOf="@id/divider1"
            app:layout_constraintStart_toStartOf="@id/tvSubtitle2" />


        <com.oreo.ui.custom.SleepLineChart
            android:id="@+id/lineChart"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimen_200dp"
            android:visibility="gone"
            app:bgBottomColor="@android:color/transparent"
            app:bgColor="@android:color/transparent"
            app:bgLeftColor="@android:color/transparent"

            app:bgRightColor="@android:color/transparent"
            app:bgTopColor="@android:color/transparent"
            app:bottomWith="20dp"
            app:centerLineColor="#80ffffff"
            app:centerLineWidth="5dp"
            app:chartLineWidth="2dp"
            app:gridColor="#80FFFFFF"

            app:innerCircleColor="#ffffff"
            app:showSelectedIndicator="true"

            app:innerCircleRadius="4dp"

            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/lytSubtitleValue1"
            app:leftWith="@dimen/dimen_16dp"

            app:lineNormalColor="#fff"
            app:rightWith="32dp"
            app:scaleColor="#ff000000"
            app:scaleNodeColor="#FFFFFF"
            app:scaleNodeRadius="6dp"
            app:showGrid="false"
            app:topWith="20dp"
            app:vCount="2"
            app:xLineColor="@color/white_12"
            app:xMax="100"
            app:xMin="0"
            app:xTextColor="#FFFFFF"
            app:xTextSize="10sp"
            app:yLineColor="#00FFFFFF"
            app:yTextColor="@color/white_64"
            app:yTextSize="10sp"
            tools:visibility="visible" />


        <com.github.mikephil.charting.charts.CombinedChart
            android:id="@+id/candleChart"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginStart="@dimen/side_margin"
            android:layout_marginEnd="@dimen/side_margin"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/lineChart"
            tools:visibility="visible" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>