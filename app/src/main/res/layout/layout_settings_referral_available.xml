<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_ref_1">

    <ImageView
        android:id="@+id/ivMain"
        android:layout_width="92dp"
        android:layout_height="92dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:src="@drawable/ic_default_profile_image" />

    <TextView
        android:id="@+id/textView134"
        style="@style/S16"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="24dp"
        android:lineSpacingExtra="3.4sp"
        android:textColor="#ba343c"
        app:layout_constraintBottom_toTopOf="@+id/tvRefer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/ivMain"
        app:layout_constraintTop_toTopOf="@+id/ivMain"
        app:layout_constraintVertical_chainStyle="spread_inside"
        tools:text="Win Bose Soundlink Micro worth INR 10,000" />

    <TextView
        android:id="@+id/tvRefer"
        style="@style/S14"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/back_my_referral_red"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:text="@string/text_refer_now"
        app:layout_constraintBottom_toBottomOf="@+id/ivMain"
        app:layout_constraintStart_toEndOf="@+id/ivMain"
        app:layout_constraintTop_toBottomOf="@+id/textView134" />


</androidx.constraintlayout.widget.ConstraintLayout>