<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/tvHeader"
        style="@style/H5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/text_cycle_history"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvOvulation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/text_ovulation"
        android:textColor="@color/white_64"
        app:layout_constraintBottom_toBottomOf="@id/tvHeader"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvHeader" />

    <TextView
        android:id="@+id/tvPeriod"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:text="@string/text_period"
        android:textColor="@color/white_64"
        app:layout_constraintBottom_toBottomOf="@id/tvHeader"
        app:layout_constraintEnd_toStartOf="@id/ivOvulation"
        app:layout_constraintTop_toTopOf="@id/tvHeader" />

    <ImageView
        android:id="@+id/ivPeriod"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/circle"
        android:backgroundTint="#ff7fc4"
        app:layout_constraintBottom_toBottomOf="@id/tvPeriod"
        app:layout_constraintEnd_toStartOf="@id/tvPeriod"
        app:layout_constraintTop_toTopOf="@id/tvPeriod" />

    <ImageView
        android:id="@+id/ivOvulation"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/circle"
        android:backgroundTint="#00c4c4"
        app:layout_constraintBottom_toBottomOf="@id/tvOvulation"
        app:layout_constraintEnd_toStartOf="@id/tvOvulation"
        app:layout_constraintTop_toTopOf="@id/tvOvulation" />

    <include
        android:id="@+id/lytCycleList"
        layout="@layout/layout_cycle_history_list_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/side_margin"
        app:layout_constraintTop_toBottomOf="@id/tvHeader" />

</androidx.constraintlayout.widget.ConstraintLayout>