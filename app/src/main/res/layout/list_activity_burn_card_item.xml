<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/ModalStyleTransparentOreo"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="24dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imv"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:adjustViewBounds="true"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_activity_card_bg1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearance="@style/ShapeAppearanceOverlay.App.CornerSize10dp" />

    <TextView
        android:id="@+id/textView"
        style="@style/H5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/dimen_16dp"
        android:text="@string/text_activity_o"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/imageView14"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginEnd="@dimen/dimen_16dp"
        android:adjustViewBounds="true"
        android:alpha="0.6"
        android:contentDescription="@null"
        android:src="@drawable/ic_arrow_right_white"
        app:layout_constraintBottom_toBottomOf="@+id/textView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/textView" />

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/lottieAnimationView"
        android:layout_width="196dp"
        android:layout_height="120dp"
        android:layout_marginTop="@dimen/dimen_8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView"
        app:lottie_imageAssetsFolder="images" />

    <TextView
        android:id="@+id/tvValue"
        style="@style/H32"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="58dp"
        app:layout_constraintEnd_toEndOf="@+id/lottieAnimationView"
        app:layout_constraintStart_toStartOf="@+id/lottieAnimationView"
        app:layout_constraintTop_toTopOf="@+id/lottieAnimationView" />

    <TextView
        android:id="@+id/tvStatus"
        style="@style/H5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_8dp"

        android:textColor="@color/white"
        app:layout_constraintEnd_toEndOf="@+id/lottieAnimationView"
        app:layout_constraintStart_toStartOf="@+id/lottieAnimationView"
        app:layout_constraintTop_toBottomOf="@+id/tvValue" />

    <FrameLayout
        android:id="@+id/lytDesc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dimen_24dp"
        android:layout_marginTop="@dimen/_24sdp"
        android:layout_marginEnd="@dimen/_24sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvStatus">

        <com.app.shimmertextview.ShimmerTextView
            android:id="@+id/tvShimmer"
            style="@style/S16"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="16sp"
            android:visibility="gone"
            tools:visibility="visible"
            app:text_shimmer_base_color="#7095AF"
            app:text_shimmer_colored="true"
            app:text_shimmer_duration="3000"
            app:text_shimmer_highlight_color="#C2D9E6"
            app:text_shimmer_repeat_mode="restart"
            android:text="@string/text_getting_more_insights" />

        <TextView
            android:id="@+id/tvTodayDesc"
            style="@style/Small"
            android:layout_width="match_parent"
            android:fontFamily="@font/gilroy_medium"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:lineSpacingExtra="8sp"
            android:textColor="@color/white"
            android:visibility="gone"
            tools:visibility="visible" />

    </FrameLayout>

    <include
        android:id="@+id/line"
        layout="@layout/layout_line_separator"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/dimen_16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/lytDesc" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/pbSteps"
        android:layout_width="0dp"
        android:layout_height="4dp"
        android:layout_marginStart="@dimen/dimen_16dp"
        android:layout_marginTop="19dp"
        android:layout_marginEnd="@dimen/dimen_16dp"
        app:trackColor="#3dffffff"
        app:layout_constraintEnd_toEndOf="parent"
        app:trackCornerRadius="2dp"
        app:trackThickness="4dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/line" />

    <TextView
        android:id="@+id/tvActiveCalorieText"
        style="@style/H6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dimen_16dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="@dimen/dimen_16dp"
        android:text="@string/text_goal_progress"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/pbSteps" />

    <TextView
        android:id="@+id/tvCalories"
        style="@style/H6"
        android:layout_width="wrap_content"

        android:layout_height="wrap_content"
        android:textColor="@color/white"
        app:layout_constraintBottom_toBottomOf="@+id/tvActiveCalorieText"
        app:layout_constraintEnd_toStartOf="@+id/tvTotalCalories"

        app:layout_constraintTop_toTopOf="@+id/tvActiveCalorieText"
        tools:text="500" />

    <TextView
        android:id="@+id/tvTotalCalories"
        style="@style/H6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/dimen_16dp"
        android:textColor="@color/white_64"
        app:layout_constraintBottom_toBottomOf="@+id/tvActiveCalorieText"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvActiveCalorieText"
        tools:text="/ 500" />


</androidx.constraintlayout.widget.ConstraintLayout>