<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingHorizontal="16dp"
    android:paddingVertical="8dp">

    <ImageView
        android:id="@+id/ivBack"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/back_modal_new_round"
        android:padding="10dp"
        android:src="@drawable/ic_back_ai"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/imageView113"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_ai_insight"
        app:layout_constraintBottom_toBottomOf="@+id/ivBack"
        app:layout_constraintEnd_toStartOf="@+id/textView207"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/ivBack" />

    <TextView
        android:id="@+id/textView207"
        style="@style/S16"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:fontFamily="@font/gilroy_bold"
        android:text="@string/text_insights"
        app:layout_constraintBottom_toBottomOf="@+id/imageView113"
        app:layout_constraintEnd_toStartOf="@+id/ivBeta"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/imageView113"
        app:layout_constraintTop_toTopOf="@+id/imageView113" />

    <ImageView
        android:id="@+id/ivBeta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_beta_logo_insights_detail"
        app:layout_constraintBottom_toBottomOf="@+id/imageView113"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/textView207"
        app:layout_constraintTop_toTopOf="@+id/imageView113" />

    <ImageView
        android:id="@+id/ivNewChat"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/back_modal_new_round"
        android:padding="10dp"
        android:src="@drawable/ic_ai_new"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>