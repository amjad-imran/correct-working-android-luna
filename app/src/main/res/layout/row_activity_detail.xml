<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:paddingEnd="10dp"
        android:paddingStart="1dp">

        <TextView
            android:id="@+id/tvTitle"
            style="@style/H5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/bright_lime"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="TextContrastCheck"
            tools:text="Total Time" />
        <TextView
            android:id="@+id/tvValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            tools:text="0:00:34"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTitle"
            style="@style/H2"/>

        <TextView
            android:id="@+id/tvUnitValue"
            style="@style/H6"
            android:textColor="@color/very_light_pink"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="2dp"
            app:layout_constraintBottom_toBottomOf="@id/tvValue"
            app:layout_constraintStart_toEndOf="@id/tvValue"
            tools:text="0:00:34" />


    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>