<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <me.dkzwm.widget.srl.SmoothRefreshLayout
            android:id="@+id/swipeToRefresh"
            android:layout_above="@id/lytJoin"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <com.noisefit.ui.custom.swipeHeader.srl.extra.header.ClassicHeader
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">


                    <com.airbnb.lottie.LottieAnimationView
                        android:id="@+id/animationView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scaleType="fitXY"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:lottie_autoPlay="true"
                        app:lottie_loop="true" />

                    <ProgressBar
                        android:id="@+id/progressBar2"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginTop="8dp"
                        app:layout_constraintBottom_toTopOf="@+id/textSyncingData"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_bias="0.5"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintVertical_chainStyle="packed" />

                    <TextView
                        android:id="@+id/textSyncingData"
                        style="@style/Small"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/gilroy_medium"
                        android:text="@string/text_syncing_your_data"
                        android:textColor="@android:color/white"
                        android:visibility="gone"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/progressBar2" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.noisefit.ui.custom.swipeHeader.srl.extra.header.ClassicHeader>

            <androidx.coordinatorlayout.widget.CoordinatorLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">


                <com.google.android.material.appbar.AppBarLayout
                    android:id="@+id/appbar"
                    android:layout_width="match_parent"
                    android:layout_height="214dp"
                    android:fitsSystemWindows="true">

                    <com.google.android.material.appbar.SubtitleCollapsingToolbarLayout
                        android:id="@+id/toolbarLayout"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:fitsSystemWindows="true"
                        android:minHeight="56dp"
                        app:collapsedSubtitleTextAppearance="@style/hGone"
                        app:collapsedSubtitleTextColor="@android:color/transparent"
                        app:collapsedTitleTextAppearance="@style/H4"
                        app:collapsedTitleTextColor="@android:color/white"
                        app:contentScrim="@android:color/black"
                        app:expandedSubtitleTextAppearance="@style/H6"
                        app:expandedSubtitleTextColor="#CCFFFFFF"
                        app:expandedTitleMarginStart="@dimen/side_margin"
                        app:expandedTitleTextAppearance="@style/H4"
                        app:expandedTitleTextColor="@android:color/white"
                        app:layout_scrollFlags="scroll|exitUntilCollapsed"
                        app:subtitleMaxLines="2"
                        app:title=""
                        app:titleMaxLines="2"
                        app:toolbarId="@+id/toolbar">

                        <ImageView
                            android:id="@+id/ivChallengeBanner"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <androidx.appcompat.widget.Toolbar
                            android:id="@+id/toolbar"
                            android:layout_width="match_parent"
                            android:layout_height="?attr/actionBarSize"
                            android:paddingEnd="56dp"
                            android:theme="@style/ToolbarTextTheme"
                            app:layout_collapseMode="pin" />

                        <ImageView
                            android:id="@+id/ivShare"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:layout_gravity="end"
                            android:padding="12dp"
                            android:src="@drawable/ic_toolbar_share"
                            android:visibility="gone"
                            app:layout_collapseMode="pin" />


                    </com.google.android.material.appbar.SubtitleCollapsingToolbarLayout>

                </com.google.android.material.appbar.AppBarLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_behavior="@string/appbar_scrolling_view_behavior">

                    <include
                        android:id="@+id/lytContentScrolling"
                        layout="@layout/content_scrolling"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        tools:visibility="visible" />

                </FrameLayout>


                <include
                    android:id="@+id/progressBar"
                    layout="@layout/default_loader"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />


            </androidx.coordinatorlayout.widget.CoordinatorLayout>

        </me.dkzwm.widget.srl.SmoothRefreshLayout>

        <RelativeLayout
            android:id="@+id/lytJoin"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_alignParentBottom="true"
            android:background="@drawable/join_challenge_grad"
            android:gravity="center"
            android:visibility="gone"
            tools:visibility="visible">


            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/vJoin"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginStart="@dimen/side_margin"
                android:layout_marginEnd="@dimen/side_margin"
                app:lottie_autoPlay="true"
                app:lottie_repeatCount="0" />

            <TextView
                android:id="@+id/bJoinChallenge"
                style="@style/PrimaryButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginStart="@dimen/side_margin"
                android:layout_marginEnd="@dimen/side_margin"
                android:gravity="center"
                android:text="@string/text_join_challenge"
                android:textAllCaps="false"
                app:backgroundTint="@null" />
        </RelativeLayout>

        <LinearLayout
            android:id="@+id/lytJoinAnim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#F2000000"
            android:gravity="center"
            android:visibility="gone">

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/animChallengeJoined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:lottie_autoPlay="true" />
        </LinearLayout>

    </RelativeLayout>


</layout>