<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
xmlns:tools="http://schemas.android.com/tools">

<RelativeLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/list"
        style="@style/ModalStyleDialog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dimen_12dp"
        android:layout_marginTop="@dimen/dimen_12dp"
        android:layout_marginEnd="@dimen/dimen_12dp"
        android:layout_marginBottom="@dimen/dimen_12dp"
        tools:context="com.oreo.ui.timelineScreen.habits.ModifyingEntriesBottomSheet"
        tools:listitem="@layout/fragment_privacy_bottom_dialog_list_dialog_item">

        <View
            android:layout_width="80dp"
            android:layout_height="2dp"
            android:layout_marginTop="4dp"
            android:alpha="0.5"
            android:background="@drawable/back_bottom_sheet_drag"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvTitle"
            style="@style/H4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textAlignment="center"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginTop="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Modifying Entries" />


        <TextView
            android:id="@+id/tvDesc"
            style="@style/S14"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:lineHeight="20sp"
            app:layout_constraintWidth_percent=".7"
            android:textAlignment="center"
            android:layout_marginTop="8dp"
            android:background="@android:color/transparent"
            android:lineSpacingExtra="6sp"
            android:textColor="#EAEAEA"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvTitle"
            tools:text="Are you sure you want to unpair your ColorFit Ultra from NoiseFit?" />

        <Button
            android:id="@+id/btnGotIt"
            style="@style/PrimaryButtonStyle"
            android:layout_width="0dp"
            android:layout_marginTop="@dimen/dimen_40dp"
            android:layout_marginHorizontal="@dimen/dimen_24dp"
            android:layout_marginBottom="@dimen/dimen_24dp"
            android:text="@string/text_got_it"
            app:backgroundTint="@null"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvDesc" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</RelativeLayout>
</layout>