<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/textView1"
            style="@style/H5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/side_margin"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:text="@string/text_impact_on_scores" />

        <ImageView
            android:id="@+id/imageView1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/side_margin"
            android:src="@drawable/ic_nap_s_score"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/divider2" />

        <TextView
            android:id="@+id/textView2"
            style="@style/H6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/text_sleep_score"
            android:textColor="@color/white_64"
            app:layout_constraintStart_toStartOf="@id/imageView1"
            app:layout_constraintTop_toBottomOf="@id/imageView1" />

        <TextView
            android:id="@+id/tvOldSScore"
            style="@style/H1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:textColor="@color/white_12_70"
            android:textSize="32sp"
            app:layout_constraintStart_toStartOf="@id/imageView1"
            app:layout_constraintTop_toBottomOf="@id/textView2"
            tools:text="81" />

        <ImageView
            android:id="@+id/ivArrow1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:src="@drawable/ic_nap_forward_arrow"
            app:layout_constraintBottom_toBottomOf="@id/tvOldSScore"
            app:layout_constraintStart_toEndOf="@id/tvOldSScore"
            app:layout_constraintTop_toTopOf="@id/tvOldSScore" />

        <TextView
            android:id="@+id/tvNewSScore"
            style="@style/H1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginTop="24dp"
            android:textColor="@color/white_12_70"
            android:textSize="32sp"
            app:layout_constraintStart_toEndOf="@id/ivArrow1"
            app:layout_constraintTop_toBottomOf="@id/textView2"
            tools:text="84" />

        <TextView
            android:id="@+id/tvDiffSScore"
            style="@style/H6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            app:layout_constraintStart_toEndOf="@id/tvNewSScore"
            app:layout_constraintTop_toTopOf="@id/tvNewSScore"
            tools:text="+4"
            tools:textColor="@color/steps_arc" />

        <include
            android:id="@+id/divider2"
            layout="@layout/layout_divider"
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_marginTop="24dp"
            app:layout_constraintBottom_toBottomOf="@id/tvNewSScore"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textView1" />

        <ImageView
            android:id="@+id/imageView2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/side_margin"
            android:src="@drawable/ic_nap_r_score"
            app:layout_constraintStart_toEndOf="@id/divider2"
            app:layout_constraintTop_toTopOf="@id/divider2" />

        <TextView
            android:id="@+id/textView3"
            style="@style/H6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/text_readiness_score"
            android:textColor="@color/white_64"
            app:layout_constraintStart_toStartOf="@id/imageView2"
            app:layout_constraintTop_toBottomOf="@id/imageView2" />

        <TextView
            android:id="@+id/tvOldRScore"
            style="@style/H1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:textColor="@color/white_12_70"
            android:textSize="32sp"
            app:layout_constraintStart_toStartOf="@id/imageView2"
            app:layout_constraintTop_toBottomOf="@id/textView3"
            tools:text="81" />

        <ImageView
            android:id="@+id/ivArrow2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:src="@drawable/ic_nap_forward_arrow"
            app:layout_constraintBottom_toBottomOf="@id/tvOldRScore"
            app:layout_constraintStart_toEndOf="@id/tvOldRScore"
            app:layout_constraintTop_toTopOf="@id/tvOldRScore" />

        <TextView
            android:id="@+id/tvNewRScore"
            style="@style/H1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginTop="24dp"
            android:textColor="@color/white_12_70"
            android:textSize="32sp"
            app:layout_constraintStart_toEndOf="@id/ivArrow2"
            app:layout_constraintTop_toBottomOf="@id/textView3"
            tools:text="84" />

        <TextView
            android:id="@+id/tvDiffRScore"
            style="@style/H6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            app:layout_constraintStart_toEndOf="@id/tvNewRScore"
            app:layout_constraintTop_toTopOf="@id/tvNewRScore"
            tools:text="+4"
            tools:textColor="@color/steps_arc" />

        <include
            layout="@layout/layout_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvNewSScore" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>