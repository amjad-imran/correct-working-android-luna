<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:background="@drawable/ic_npl_quiz_back_frame"
        android:layout_height="wrap_content">

        <include
            android:id="@+id/lytTimer"
            layout="@layout/layout_super_over"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <include
            android:id="@+id/lytAnimOnly"
            layout="@layout/layout_quiz_lottie_only"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/lytTimer" />
        <include
            android:id="@+id/lytDone"
            layout="@layout/layout_quiz_with_done"
            android:layout_width="match_parent"
            android:layout_height="368dp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/lytAnimOnly" />
        <include
            android:id="@+id/lytNextQuiz"
            layout="@layout/layout_next_quiz"
            android:layout_width="match_parent"
            android:layout_height="368dp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/lytDone" />


        <include
            android:id="@+id/lytWithOptions"
            layout="@layout/layout_quiz_with_options"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_height="wrap_content"
            android:layout_width="match_parent"
            android:visibility="visible"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/lytNextQuiz" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>