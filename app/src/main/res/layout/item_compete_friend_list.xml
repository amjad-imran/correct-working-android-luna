<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        style="@style/ModalStyleNew"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginStart="@dimen/side_margin"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="@dimen/side_margin">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivFriendProfile"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="@dimen/side_margin"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearance="@style/ShapeAppearance.App.CircleImageView"
            app:srcCompat="@drawable/ic_default_profile_image"
            tools:ignore="ContentDescription" />

        <TextView
            android:id="@+id/tvFriendName"
            style="@style/H6"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/side_margin"
            android:layout_marginEnd="@dimen/dimen_16dp"
            android:maxLines="1"
            android:textColor="@color/white"
            app:layout_constraintEnd_toStartOf="@+id/tvRequestStatus"
            app:layout_constraintStart_toEndOf="@id/ivFriendProfile"
            app:layout_constraintTop_toTopOf="@id/ivFriendProfile"
            tools:text="Ayush Tiwari" />

        <TextView
            android:id="@+id/tvInterestName"
            style="@style/Small"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/side_margin"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="@dimen/dimen_16dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:lineSpacingExtra="4sp"
            android:textColor="@color/white_80"
            app:layout_constraintBottom_toBottomOf="@id/ivFriendProfile"
            app:layout_constraintEnd_toStartOf="@+id/tvRequestStatus"
            app:layout_constraintStart_toEndOf="@id/ivFriendProfile"
            app:layout_constraintTop_toBottomOf="@+id/tvFriendName"
            tools:text="Workout, Cycling" />

        <TextView
            android:id="@+id/tvRequestStatus"
            style="@style/Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/side_margin"
            android:layout_marginEnd="@dimen/side_margin"
            android:enabled="false"
            android:textColor="@color/accent_color_purple"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Pending" />


    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>