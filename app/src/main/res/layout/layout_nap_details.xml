<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/textView1"
            style="@style/H5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/side_margin"
            android:text="@string/text_nap_details"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvHour"
            style="@style/H2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/side_margin"
            android:layout_marginTop="24dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textView1"
            tools:text="8" />

        <TextView
            android:id="@+id/tvHourUnit"
            style="@style/H5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="@string/text_hr_lower"
            android:textColor="@color/white_64"
            app:layout_constraintBaseline_toBaselineOf="@id/tvHour"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tvHour" />

        <TextView
            android:id="@+id/tvMinute"
            style="@style/H2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="24dp"
            app:layout_constraintStart_toEndOf="@id/tvHourUnit"
            app:layout_constraintTop_toBottomOf="@+id/textView1"
            tools:text="30" />

        <TextView
            android:id="@+id/tvMinuteUnit"
            style="@style/H5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="@string/text_mins"
            android:textColor="@color/white_64"
            app:layout_constraintBaseline_toBaselineOf="@+id/tvMinute"
            app:layout_constraintStart_toEndOf="@+id/tvMinute" />

<!--        <com.google.android.material.progressindicator.LinearProgressIndicator-->
<!--            android:id="@+id/pbSteps"-->
<!--            android:layout_width="match_parent"-->
<!--            android:layout_height="4dp"-->
<!--            android:layout_marginStart="@dimen/side_margin"-->
<!--            android:layout_marginTop="10dp"-->
<!--            android:layout_marginEnd="@dimen/side_margin"-->
<!--            android:layout_marginBottom="16dp"-->
<!--            app:indicatorColor="#c5a8ed"-->
<!--            app:layout_constraintBottom_toBottomOf="parent"-->
<!--            app:layout_constraintEnd_toEndOf="parent"-->
<!--            app:layout_constraintStart_toStartOf="parent"-->
<!--            app:layout_constraintTop_toBottomOf="@+id/tvHour"-->
<!--            app:trackColor="#0affffff"-->
<!--            app:trackCornerRadius="2dp"-->
<!--            app:trackThickness="4dp"-->
<!--            tools:progress="10" />-->
        <View
            android:id="@+id/view"
            android:layout_width="@dimen/dimen_4dp"
            android:layout_height="@dimen/dimen_4dp"
            android:layout_marginStart="@dimen/dimen_16dp"
            android:background="@drawable/circle_gray"
            app:layout_constraintBottom_toBottomOf="@+id/napPrg"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/napPrg" />

        <View
            android:id="@+id/view2"
            android:layout_width="@dimen/dimen_4dp"
            android:layout_height="@dimen/dimen_4dp"
            android:layout_marginEnd="@dimen/dimen_16dp"
            android:background="@drawable/circle_gray"
            app:layout_constraintBottom_toBottomOf="@+id/napPrg"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/napPrg" />

        <FrameLayout
            android:id="@+id/napPrg"
            android:layout_width="0dp"
            android:layout_height="8dp"
            android:layout_marginStart="@dimen/dimen_4dp"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="@dimen/dimen_4dp"
            app:layout_constraintEnd_toStartOf="@+id/view2"
            app:layout_constraintStart_toEndOf="@+id/view"
            app:layout_constraintTop_toBottomOf="@+id/tvMinute" />

        <TextView
            android:id="@+id/tvNapStart"
            style="@style/H6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimen_16dp"
            android:layout_marginTop="8dp"
            android:textColor="@color/white_12_50"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/napPrg"
            tools:text="4:15 pm" />

        <TextView
            android:id="@+id/tvNapEnd"
            style="@style/H6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="@dimen/dimen_16dp"
            android:textColor="@color/white_12_50"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/napPrg"
            tools:text="4:15 pm" />

        <include
            layout="@layout/layout_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvNapStart" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>