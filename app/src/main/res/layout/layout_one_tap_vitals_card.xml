<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="24dp"
    android:background="@drawable/back_modal_transparent_oreo"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/tvTitle"
        style="@style/S14"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="14dp"
        android:text="@string/text_one_tap_vitals"
        android:textColor="@android:color/white"
        app:layout_constraintEnd_toStartOf="@+id/ivArrow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginEnd="8dp" />

    <ImageView
        android:id="@+id/ivArrow"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="16dp"
        android:src="@drawable/ic_arrow_right_cal"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/tvTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvTitle"
        tools:ignore="ContentDescription" />

    <LinearLayout
        android:id="@+id/lytCollapsed"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="6dp"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitle">

        <LinearLayout
            android:id="@+id/itemHR"
            android:layout_width="0dp"
            android:layout_height="142dp"
            android:layout_marginHorizontal="6dp"
            android:layout_weight="1"
            android:background="@drawable/back_modal_v2_10"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvHrTitle"
                style="@style/S10"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center_horizontal"
                android:singleLine="true"
                android:text="@string/text_heart_rate" />

            <include
                android:id="@+id/lytHrValue"
                layout="@layout/item_value_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp" />

            <TextView
                android:id="@+id/tvHrAgo"
                style="@style/S10"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#A3FFFFFF"
                tools:text="3 min ago" />

            <ImageView
                android:id="@+id/ivHrIcon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginTop="14dp"
                android:src="@drawable/ic_hr_measure"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/tvHrMeasure"
                style="@style/S10"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/text_measure"
                android:textColor="#E6FFFFFF" />

            <include layout="@layout/include_one_tap_measuring_tile" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/itemStress"
            android:layout_width="0dp"
            android:layout_height="142dp"
            android:layout_marginHorizontal="6dp"
            android:layout_weight="1"
            android:background="@drawable/back_modal_v2_10"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvStressTitle"
                style="@style/S10"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center_horizontal"
                android:singleLine="true"
                android:text="@string/text_stress" />

            <include
                android:id="@+id/lytStressValue"
                layout="@layout/item_value_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp" />

            <TextView
                android:id="@+id/tvStressAgo"
                style="@style/S10"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#A3FFFFFF"
                tools:text="3 min ago" />

            <ImageView
                android:id="@+id/ivStressIcon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginTop="14dp"
                android:src="@drawable/ic_stress_measure"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/tvStressMeasure"
                style="@style/S10"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/text_measure"
                android:textColor="#E6FFFFFF" />

            <include layout="@layout/include_one_tap_measuring_tile" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/itemSpO2"
            android:layout_width="0dp"
            android:layout_height="142dp"
            android:layout_marginHorizontal="6dp"
            android:layout_weight="1"
            android:background="@drawable/back_modal_v2_10"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvSpO2Title"
                style="@style/S10"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center_horizontal"
                android:singleLine="true"
                android:text="SpO2" />


            <include
                android:id="@+id/lytSpO2Value"
                layout="@layout/item_value_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp" />

            <TextView
                android:id="@+id/tvSpO2Ago"
                style="@style/S10"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#A3FFFFFF"
                tools:text="3 min ago" />

            <ImageView
                android:id="@+id/ivSpO2Icon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginTop="14dp"
                android:src="@drawable/ic_spo2_measure"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/tvSpO2Measure"
                style="@style/S10"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/text_measure"
                android:textColor="#E6FFFFFF" />

            <include layout="@layout/include_one_tap_measuring_tile" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/itemSkinTemp"
            android:layout_width="0dp"
            android:layout_height="142dp"
            android:layout_marginHorizontal="6dp"
            android:layout_weight="1"
            android:background="@drawable/back_modal_v2_10"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvSkinTitle"
                style="@style/S10"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center_horizontal"
                android:singleLine="true"
                android:text="@string/text_skin_temp" />

            <include
                android:id="@+id/lytSkinValue"
                layout="@layout/item_value_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp" />

            <TextView
                android:id="@+id/tvSkinAgo"
                style="@style/S10"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#A3FFFFFF"
                tools:text="3 min ago" />

            <ImageView
                android:id="@+id/ivSkinIcon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginTop="14dp"
                android:src="@drawable/ic_temp_measure"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/tvSkinMeasure"
                style="@style/S10"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/text_measure"
                android:textColor="#E6FFFFFF" />

            <include layout="@layout/include_one_tap_measuring_tile" />
        </LinearLayout>

    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>
