<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:lineChart="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.oreo.ui.custom.female.PeriodTempLineChart
            android:id="@+id/vGraph"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="24dp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            lineChart:bgBottomColor="@android:color/transparent"
            lineChart:bgColor="@android:color/transparent"
            lineChart:bgLeftColor="@android:color/transparent"
            lineChart:bgRightColor="@android:color/transparent"
            lineChart:bgTopColor="@android:color/transparent"
            lineChart:bottomWith="30dp"
            lineChart:centerLineColor="@color/white_80"
            lineChart:centerLineWidth="3dp"
            lineChart:chartLineColor="#808da0"
            lineChart:chartLineWidth="2dp"
            lineChart:gridColor="@color/white_12"
            lineChart:hCount="11"
            lineChart:innerCircleColor="#e9d4ff"
            lineChart:innerCircleRadius="3dp"
            lineChart:leftWith="0dp"
            lineChart:outCircleColor="#66aa5bff"
            lineChart:outCircleRadius="1dp"
            lineChart:scaleColor="#ff000000"
            lineChart:scaleLenth="4dp"
            lineChart:scaleNodeColor="#FFFFFF"
            lineChart:scaleNodeRadius="6dp"
            lineChart:showGrid="true"
            lineChart:topWith="30dp"
            lineChart:vCount="2"
            lineChart:rightWith="30dp"
            lineChart:xLineColor="#80FFFFFF"
            lineChart:xMax="0"
            lineChart:xMin="0"
            lineChart:xTextColor="#FFFFFF"
            lineChart:xTextSize="12sp"
            lineChart:xTextSize2="10sp"
            lineChart:yLineColor="#00FFFFFF"
            lineChart:yTextSize="10sp"
            tools:visibility="visible" />


        <include
            android:id="@+id/lytLegendView"
            layout="@layout/fmh_skin_temp_legend_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="40dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="40dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/vGraph" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>