<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".ui.summary.graph.SleepBlogDetailFragment">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="300dp">

                    <ImageView
                        android:id="@+id/ivMain"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitXY" />

                    <TextView
                        android:id="@+id/tvSubTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentBottom="true"
                        android:layout_marginBottom="20dp"
                        style="@style/Small"
                        android:paddingHorizontal="16dp" />

                    <TextView
                        android:id="@+id/tvTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_above="@id/tvSubTitle"
                        android:layout_marginBottom="16dp"
                        style="@style/H3"
                        android:paddingHorizontal="16dp"/>

                </RelativeLayout>

                <TextView
                    android:id="@+id/tvDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Small"
                    android:textSize="@dimen/text_14sp"
                    android:lineSpacingExtra="@dimen/dimen_8dp"
                    android:textColor="@color/text_color_update"
                    android:padding="16dp"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvList"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    tools:ignore="RtlSymmetry"
                    tools:listitem="@layout/row_sleep_blog_detail" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <ImageButton
            android:id="@+id/bBack"
            style="@style/ToolbarBackButton"
            android:layout_margin="@dimen/side_margin"
            android:layout_alignParentTop="true"
            android:adjustViewBounds="true"
            android:contentDescription="@string/text_back_button" />
    </RelativeLayout>
</layout>