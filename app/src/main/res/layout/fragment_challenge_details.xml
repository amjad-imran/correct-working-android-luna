<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            tools:context=".ui.challengeNew.detail.ChallengeDetailsFragment">

            <!--<include
                android:id="@+id/lytChallengeTop"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                layout="@layout/layout_challenge_top"/>-->

            <include
                android:id="@+id/lytChallengeDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                layout="@layout/layout_challenge_details"/>

            <include
                android:id="@+id/lytProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                layout="@layout/layout_challenge_progress"/>

            <include
                android:id="@+id/lytAboutChallenge"
                layout="@layout/layout_about_challenge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp" />


            <include
                android:id="@+id/lytRewards"
                layout="@layout/layout_challenge_rewards"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/include27" />

            <include
                android:id="@+id/lytShareChallenge"
                layout="@layout/layout_share_challenge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/include28" />


            <TextView
                android:id="@+id/tvLeaveChallenge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/H5"
                android:layout_gravity="center_horizontal"
                android:padding="16dp"
                android:textAllCaps="false"
                android:gravity="center_horizontal"
                android:text="@string/leave_challenge"/>


            <Button
                android:id="@+id/bJoinChallenge"
                style="@style/PrimaryButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginStart="@dimen/side_margin"
                android:layout_marginEnd="@dimen/side_margin"
                android:layout_marginTop="40dp"
                android:layout_marginBottom="40dp"
                android:textStyle="bold"
                android:text="@string/text_join_challenge"
                android:textSize="12sp"
                android:textAllCaps="false"
                app:backgroundTint="@null"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />


        </LinearLayout>
    </ScrollView>

</layout>