<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tvHour"
            style="@style/H3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="8" />

        <TextView
            android:id="@+id/tvUnitHr"
            style="@style/Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:text="@string/text_hr"
            app:layout_constraintBaseline_toBaselineOf="@id/tvHour"
            app:layout_constraintStart_toEndOf="@id/tvHour" />

        <TextView
            android:id="@+id/tvMin"
            style="@style/H3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            app:layout_constraintStart_toEndOf="@id/tvUnitHr"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="8" />

        <TextView
            android:id="@+id/tvUnitMin"
            style="@style/Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:text="@string/text_min"
            app:layout_constraintBaseline_toBaselineOf="@id/tvMin"
            app:layout_constraintStart_toEndOf="@id/tvMin" />

        <View
            android:id="@+id/viewHighlight"
            android:layout_width="50dp"
            android:layout_height="20dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/back_hm_range"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvHour" />

        <TextView
            android:id="@+id/tvPercent"
            style="@style/Small"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/ic_trends_green_arrow"
            android:drawablePadding="4dp"
            android:padding="4dp"
            android:textColor="#29cc74"
            app:layout_constraintBottom_toBottomOf="@id/viewHighlight"
            app:layout_constraintEnd_toEndOf="@id/viewHighlight"
            app:layout_constraintStart_toStartOf="@id/viewHighlight"
            app:layout_constraintTop_toTopOf="@id/viewHighlight"
            tools:ignore="UseCompatTextViewDrawableXml"
            tools:text="115%" />

        <TextView
            android:id="@+id/tvDesc"
            style="@style/Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/white_60"
            app:layout_constraintBottom_toBottomOf="@id/viewHighlight"
            app:layout_constraintStart_toEndOf="@id/viewHighlight"
            app:layout_constraintTop_toTopOf="@id/viewHighlight"
            tools:text="avg hours" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>