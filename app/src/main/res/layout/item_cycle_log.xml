<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <!--<View
            android:id="@+id/viewStroke"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginEnd="@dimen/side_margin"
            android:background="@drawable/back_modal_round_white_2"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:visibility="gone" />-->

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivItem"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:padding="2dp"
            android:scaleType="centerCrop"
            android:layout_marginEnd="@dimen/side_margin"
            android:src="@drawable/circle_black"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearance="@style/ShapeAppearance.App.CircleImageView"
            app:strokeColor="#2effffff"
            app:strokeWidth="1dp"
            tools:ignore="ContentDescription" />

        <ImageView
            android:id="@+id/ivTick"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="@id/ivItem"
            app:layout_constraintTop_toTopOf="@id/ivItem"
            tools:ignore="ContentDescription"
            android:src="@drawable/ic_cycle_tick"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tvTitle"
            style="@style/Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:layout_constraintEnd_toEndOf="@id/ivItem"
            app:layout_constraintStart_toStartOf="@id/ivItem"
            app:layout_constraintTop_toBottomOf="@id/ivItem"
            tools:text="None" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>