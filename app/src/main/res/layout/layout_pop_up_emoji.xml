<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="144dp"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tvHoldText"
        style="@style/H5"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_48dp"
        android:gravity="center|bottom"
        android:layout_marginTop="@dimen/dimen_8dp"
        android:text="@string/text_tap_and_hold_to_react"
        android:textColor="@color/white" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/emojiContainer"
        style="@style/ModalStyleSolid"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dimen_16dp"
        android:layout_marginTop="@dimen/dimen_8dp"
        android:layout_marginEnd="@dimen/dimen_8dp"
        android:padding="@dimen/dimen_8dp">

        <ImageView
            android:id="@+id/ivGiveEmojiStrong"
            android:layout_width="@dimen/dimen_32dp"
            android:layout_height="@dimen/dimen_32dp"
            android:layout_marginStart="@dimen/dimen_8dp"
            android:src="@drawable/ic_strong_emoji"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="ContentDescription" />

        <ImageView
            android:id="@+id/ivGiveEmojiHeart"
            android:layout_width="@dimen/dimen_32dp"
            android:layout_height="@dimen/dimen_32dp"
            android:layout_marginStart="@dimen/dimen_8dp"

            android:src="@drawable/ic_heart_emoji"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ivGiveEmojiStrong"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="ContentDescription" />

        <ImageView
            android:id="@+id/ivGiveEmojiFire"
            android:layout_width="@dimen/dimen_32dp"
            android:layout_height="@dimen/dimen_32dp"
            android:layout_marginStart="@dimen/dimen_8dp"
            android:src="@drawable/ic_fire_emoji"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ivGiveEmojiHeart"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="ContentDescription" />

        <ImageView
            android:id="@+id/ivGiveEmoji100"
            android:layout_width="@dimen/dimen_32dp"
            android:layout_height="@dimen/dimen_32dp"
            android:layout_marginStart="@dimen/dimen_8dp"
            android:layout_marginEnd="@dimen/dimen_8dp"
            android:src="@drawable/ic_100_emoji"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ivGiveEmojiFire"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="ContentDescription" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <include
        android:id="@+id/lytFriendList"
        layout="@layout/item_friend_view"
        android:layout_width="match_parent"
        android:layout_height="104dp"
        android:layout_below="@+id/emojiContainer"
        android:layout_marginStart="@dimen/side_margin"
        android:layout_marginTop="@dimen/dimen_8dp"
        android:layout_marginEnd="@dimen/side_margin"
        android:layout_marginBottom="@dimen/dimen_8dp" />


</RelativeLayout>