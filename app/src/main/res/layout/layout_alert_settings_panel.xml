<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:background="@drawable/bg_lifeos_gradient_border"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ring disconnected. Changes stay local and sync after reconnect."
        android:textColor="#9BA3AF"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/back_modal_new_black"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_my_reminder"
                app:tint="@android:color/white" />

            <TextView
                style="@style/H6"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="ALERT SETTINGS"
                android:textAllCaps="true" />

            <TextView
                android:id="@+id/tvExportAlertLogs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/back_modal_new_black"
                android:paddingStart="12dp"
                android:paddingTop="8dp"
                android:paddingEnd="12dp"
                android:paddingBottom="8dp"
                android:text="Export Logs"
                android:textAllCaps="true"
                android:textColor="#4ADE80"
                android:textSize="11sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="20dp"
            android:background="#22FFFFFF" />

        <TextView
            android:id="@+id/tvAlertBanner"
            style="@style/S12"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/back_modal_new_black"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp"
            android:textColor="#4ADE80"
            android:visibility="gone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="High HR Alert (Resting)"
            android:textAllCaps="true"
            android:textColor="#8F8F93"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/layoutWorkoutHeartRateRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etRestingHeartRate"
                style="@style/S16_GoogleSansFlex"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/back_modal_new_black"
                android:gravity="center_vertical"
                android:imeOptions="actionDone"
                android:inputType="number"
                android:maxLength="3"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@android:color/white"
                android:textColorHint="#6B7280" />

            <TextView
                style="@style/S12"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="BPM"
                android:textColor="#8F8F93" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchRestingHeartRate"
                style="@style/CustomSwitch3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvWorkoutHeartRateSupportNote"
            style="@style/S12"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Workout heart-rate alerts are not exposed by this SDK on Luna Ring."
            android:textColor="#7C838C"
            android:visibility="gone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="High HR Alert (Workout)"
            android:textAllCaps="true"
            android:textColor="#8F8F93"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etWorkoutHeartRate"
                style="@style/S16_GoogleSansFlex"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/back_modal_new_black"
                android:gravity="center_vertical"
                android:imeOptions="actionDone"
                android:inputType="number"
                android:maxLength="3"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@android:color/white"
                android:textColorHint="#6B7280" />

            <TextView
                style="@style/S12"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="BPM"
                android:textColor="#8F8F93" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchWorkoutHeartRate"
                style="@style/CustomSwitch3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Low HR Alert"
            android:textAllCaps="true"
            android:textColor="#8F8F93"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etLowHeartRate"
                style="@style/S16_GoogleSansFlex"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/back_modal_new_black"
                android:gravity="center_vertical"
                android:imeOptions="actionDone"
                android:inputType="number"
                android:maxLength="3"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@android:color/white"
                android:textColorHint="#6B7280" />

            <TextView
                style="@style/S12"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="BPM"
                android:textColor="#8F8F93" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchLowHeartRate"
                style="@style/CustomSwitch3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutStressAlert"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="High Stress Index Alert"
                android:textAllCaps="true"
                android:textColor="#8F8F93"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/etStressAlert"
                    style="@style/S16_GoogleSansFlex"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/back_modal_new_black"
                    android:gravity="center_vertical"
                    android:imeOptions="actionDone"
                    android:inputType="number"
                    android:maxLength="3"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="@android:color/white"
                    android:textColorHint="#6B7280" />

                <TextView
                    style="@style/S12"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="INDEX"
                    android:textColor="#8F8F93" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchStressAlert"
                    style="@style/CustomSwitch3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvStressAlertNote"
                style="@style/S12"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Uses the screenless HRV/stress warning flow on this device."
                android:textColor="#7C838C" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Low SpO2 Alert"
            android:textAllCaps="true"
            android:textColor="#8F8F93"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etSpo2Alert"
                style="@style/S16_GoogleSansFlex"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/back_modal_new_black"
                android:gravity="center_vertical"
                android:imeOptions="actionDone"
                android:inputType="number"
                android:maxLength="3"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@android:color/white"
                android:textColorHint="#6B7280" />

            <TextView
                style="@style/S12"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="%"
                android:textColor="#8F8F93" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchSpo2Alert"
                style="@style/CustomSwitch3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Bedtime Reminder Alert"
            android:textAllCaps="true"
            android:textColor="#8F8F93"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvBedtimeReminderTime"
                style="@style/S16_GoogleSansFlex"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/back_modal_new_black"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="10:00 PM" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchBedtimeReminder"
                style="@style/CustomSwitch3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutWearDetection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical">

            <TextView
                style="@style/H6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Wear Detection"
                android:textAllCaps="true"
                android:textColor="#8F8F93" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvWearDetectionStatus"
                    style="@style/S14_GoogleSansFlex"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/back_modal_new_black"
                    android:gravity="center_vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="Tap refresh to query wear status." />

                <TextView
                    android:id="@+id/tvRefreshWearDetection"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:background="@drawable/back_modal_new_black"
                    android:paddingStart="12dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="8dp"
                    android:text="Refresh"
                    android:textAllCaps="true"
                    android:textColor="#4ADE80"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/S12"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Wear status can be polled manually on supported screenless devices."
            android:textColor="#7C838C" />

        <TextView
            android:id="@+id/tvWearDetectionMeta"
            style="@style/S12"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#7C838C" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/H6"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Relaxation Prompt"
                android:textAllCaps="true"
                android:textColor="#8F8F93" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchRelaxationPrompt"
                style="@style/CustomSwitch3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Sedentary Reminder"
            android:textAllCaps="true"
            android:textColor="#8F8F93"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvSedentaryStartTime"
                style="@style/S14_GoogleSansFlex"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/back_modal_new_black"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="09:00 AM" />

            <TextView
                style="@style/S12"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:text="to"
                android:textColor="#8F8F93" />

            <TextView
                android:id="@+id/tvSedentaryEndTime"
                style="@style/S14_GoogleSansFlex"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/back_modal_new_black"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="06:00 PM" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchSedentaryReminder"
                style="@style/CustomSwitch3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etSedentaryInterval"
                style="@style/S16_GoogleSansFlex"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/back_modal_new_black"
                android:gravity="center_vertical"
                android:imeOptions="actionDone"
                android:inputType="number"
                android:maxLength="4"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@android:color/white"
                android:textColorHint="#6B7280" />

            <TextView
                style="@style/S12"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="minutes"
                android:textColor="#8F8F93" />
        </LinearLayout>

        <TextView
            style="@style/S12"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Interval must be a multiple of 60 minutes."
            android:textColor="#7C838C" />

        <TextView
            style="@style/H6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Recent Alerts"
            android:textAllCaps="true"
            android:textColor="#8F8F93" />

        <TextView
            android:id="@+id/tvRecentAlertsEmpty"
            style="@style/S12"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/back_modal_new_black"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp"
            android:text="No mirrored alert events yet."
            android:textColor="#7C838C" />

        <LinearLayout
            android:id="@+id/llRecentAlertsList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical" />
    </LinearLayout>

</LinearLayout>
