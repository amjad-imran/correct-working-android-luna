        tools:visibility="visible"
        android:layout_marginEnd="8dp"
        android:padding="8dp"
        android:src="@drawable/ic_thumbs_down_v2"
        app:layout_constraintBottom_toBottomOf="@+id/ivBack"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/ivBack" />-->


    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toTopOf="@id/lytChatBox"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivBack">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">


            <TextView
                android:id="@+id/tvTime"
                style="@style/S12"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="true"
                android:layout_marginTop="12dp"
                android:drawablePadding="2dp"
                android:textColor="#CCFFFFFF"
                app:drawableStartCompat="@drawable/ic_clock_ai_time"
                tools:text="4 hrs ago" />


            <TextView
                android:id="@+id/tvTitle"
                style="@style/S20"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/google_sans_flex_bold"
                android:lineSpacingExtra="4sp"
                android:lineHeight="28sp"
                tools:text="Your circadian rhythm shifted by 45 minutes later this week." />


            <!--Bio marker - research pending from backend-->

            <TextView
                android:id="@+id/tvMessage"
                style="@style/S16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#B7B7B7"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="3sp"
                android:lineHeight="20sp"
                tools:text="@tools:sample/lorem/random" />

            <FrameLayout
                android:id="@+id/chartContainer"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="16dp" >

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/fallbackImg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:adjustViewBounds="true"
                    android:scaleType="fitXY"
                    app:shapeAppearance="@style/ShapeAppearanceOverlay.App.CornerSize10dp" />

            </FrameLayout>

            <TextView
                style="@style/S14"
                android:textStyle="bold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/text_lifeos_suggests" />

            <TextView
                android:id="@+id/tvLifeOsSuggestedQues"
                style="@style/S16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#B7B7B7"
                android:lineSpacingExtra="3sp"
                android:lineHeight="20sp"
                android:layout_marginTop="4dp"
                tools:text="Morning light exposure or a caffeine cut-off by 3 PM to re-align." />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp">

                <ImageView
                    android:id="@+id/imageView125"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/ic_dig_deeper" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="4dp"
                    style="@style/S14"
                    android:textStyle="bold"
                    android:text="@string/text_dig_deeper"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/imageView125"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvRelatedSuggestedQues"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include
        android:id="@+id/lytChatBox"
        layout="@layout/layout_ai_chat_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
