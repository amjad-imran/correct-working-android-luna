<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <include
            android:id="@+id/lytStressed"
            layout="@layout/item_stress_internal_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/side_margin"
            android:layout_marginTop="26dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <include
            android:id="@+id/lytFocussed"
            layout="@layout/item_stress_internal_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="26dp"
            app:layout_constraintStart_toEndOf="@id/seperator1"
            app:layout_constraintTop_toTopOf="parent" />

        <include
            android:id="@+id/lytCalm"
            layout="@layout/item_stress_internal_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="26dp"
            app:layout_constraintStart_toEndOf="@id/seperator2"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/seperator1"
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:background="@color/white_12"
            app:layout_constraintBottom_toBottomOf="@id/lytStressed"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/seperator2"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/lytStressed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/lytStressed" />

        <View
            android:id="@+id/seperator2"
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:background="@color/white_12"
            app:layout_constraintBottom_toBottomOf="@id/lytStressed"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/seperator1"
            app:layout_constraintTop_toTopOf="@id/lytStressed" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>