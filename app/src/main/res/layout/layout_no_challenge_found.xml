<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/imageViewNoChallenge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_no_challenges"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.4"
            android:contentDescription="@string/text_no_upcoming_challenges_title" />

        <TextView
            android:id="@+id/textViewTitle"
            style="@style/H5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/side_margin"
            tools:text="No Upcoming Challenges"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/imageViewNoChallenge" />

        <TextView
            android:id="@+id/textViewMsg"
            style="@style/Small"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:paddingStart="72dp"
            android:paddingEnd="72dp"
            android:lineSpacingExtra="6sp"
            tools:text="Join any upcoming challenges and compete with other Noisemakers to win amazing rewards."
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textViewTitle"
            />


        <RelativeLayout
            android:id="@+id/lytJoin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="62dp"
            android:layout_marginEnd="62dp"
            android:gravity="center"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textViewMsg"
            app:layout_constraintVertical_bias="0.63"
            tools:visibility="visible">



            <TextView
                android:id="@+id/bJoinChallenge"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center"
                style="@style/PrimaryButtonStyle"
                android:text="@string/text_join_a_challenge"
                android:textAllCaps="false"
                app:backgroundTint="@null" />
        </RelativeLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>