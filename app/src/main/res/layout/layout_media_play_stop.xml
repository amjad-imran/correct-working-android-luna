<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    xmlns:tools="http://schemas.android.com/tools">

    <TextView
        android:id="@+id/tvDescOther"
        style="@style/H6"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="6sp"
        tools:visibility="visible"
        android:textColor="@color/very_light_pink"
        tools:text="NoiseFit app requires Camera permission on your phone to to scan the QR code" />


    <com.google.android.material.button.MaterialButton
        android:id="@+id/bGoToSettings"
        style="@style/PrimaryButtonStyle"
        android:layout_width="match_parent"
        android:layout_marginTop="24dp"
        android:text="@string/text_go_to_settings"
        android:visibility="visible"
        app:backgroundTint="@null"/>

</LinearLayout>