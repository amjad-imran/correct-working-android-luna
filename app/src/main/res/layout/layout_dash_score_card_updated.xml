<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <View
            android:id="@+id/view1"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:background="@drawable/back_modal_npl"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvWinsTitle"
            style="@style/H6"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/textwins"
            android:gravity="center"
            android:textColor="@color/white_64"
            android:textSize="12sp"
            app:layout_constraintEnd_toStartOf="@+id/divider1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/view1" />

        <TextView
            android:id="@+id/tvWinsValue"
            style="@style/H3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:layout_constraintBottom_toBottomOf="@id/view1"
            app:layout_constraintEnd_toEndOf="@id/tvWinsTitle"
            app:layout_constraintStart_toStartOf="@id/tvWinsTitle"
            app:layout_constraintTop_toBottomOf="@id/tvWinsTitle"
            tools:text="20" />

        <include
            android:id="@+id/divider1"
            layout="@layout/layout_divider"
            android:layout_width="1dp"
            android:layout_height="42dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvLoseTitle"
            style="@style/H6"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:text="@string/text_losses"
            android:gravity="center"
            app:layout_constraintStart_toEndOf="@id/divider1"
            android:textColor="@color/white_64"
            app:layout_constraintEnd_toEndOf="parent"
            android:textSize="12sp"
            app:layout_constraintTop_toTopOf="@id/view1" />

        <TextView
            android:id="@+id/tvLoseValue"
            style="@style/H3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:layout_constraintBottom_toBottomOf="@id/view1"
            app:layout_constraintEnd_toEndOf="@id/tvLoseTitle"
            app:layout_constraintStart_toStartOf="@id/tvLoseTitle"
            app:layout_constraintTop_toBottomOf="@id/tvLoseTitle"
            tools:text="2" />




    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>