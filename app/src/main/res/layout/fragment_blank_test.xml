<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D0D"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ══════════════════════════════════════ -->
        <!-- HEADER -->
        <!-- ══════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="FALCON NEW FEATURE DASHBOARD"
                android:textSize="11sp"
                android:letterSpacing="0.15"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />

            <TextView
                android:id="@+id/tvChargingStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CHARGING"
                android:textSize="10sp"
                android:textColor="#4ADE80"
                android:letterSpacing="0.1" />
        </LinearLayout>

        <!-- ══════════════════════════════════════ -->
        <!-- BATTERY STATUS CARD -->
        <!-- ══════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_lifeos_gradient_border"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BATTERY STATUS"
                android:textSize="10sp"
                android:letterSpacing="0.15"
                android:textColor="#888888"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvRemainingBatteryTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="85%"
                android:textSize="52sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:lineSpacingExtra="-4dp" />

            <ProgressBar
                android:id="@+id/batteryProgressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:progress="85"
                android:progressTint="#4ADE80"
                android:progressBackgroundTint="#2A2A2A"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Remaining pill -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="#1A1A1A"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:layout_marginEnd="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⏱"
                        android:textSize="14sp"
                        android:layout_marginEnd="6dp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="REMAINING"
                            android:textSize="8sp"
                            android:letterSpacing="0.1"
                            android:textColor="#555555" />

                        <TextView
                            android:id="@+id/tvSleepDuration"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="20 min"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#CCCCCC" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Fully charged pill -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="#1A1A1A"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚡"
                        android:textSize="14sp"
                        android:layout_marginEnd="6dp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="FULLY CHARGED AT"
                            android:textSize="8sp"
                            android:letterSpacing="0.1"
                            android:textColor="#555555" />

                        <TextView
                            android:id="@+id/tvFullyChargedTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="10:45 AM"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#4ADE80" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ══════════════════════════════════════ -->
        <!-- FITNESS AGE CARD -->
        <!-- ══════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_lifeos_gradient_border"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FITNESS AGE"
                android:textSize="10sp"
                android:letterSpacing="0.15"
                android:textColor="#888888"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom">

                <TextView
                    android:id="@+id/tvExtra2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="25"
                    android:textSize="40sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" YEARS"
                    android:textSize="14sp"
                    android:textColor="#888888"
                    android:paddingBottom="8dp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-5 YR BIOLOGICAL"
                android:textSize="11sp"
                android:textColor="#4ADE80"
                android:layout_marginTop="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="UPDATED 5 HRS AGO"
                android:textSize="10sp"
                android:textColor="#555555" />
        </LinearLayout>

        <!-- ══════════════════════════════════════ -->
        <!-- RESPIRATORY CARD -->
        <!-- ══════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_lifeos_gradient_border"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RESPIRATORY"
                android:textSize="10sp"
                android:letterSpacing="0.15"
                android:textColor="#888888"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/tvRespRate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="🌬 14"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" BPM"
                    android:textSize="12sp"
                    android:textColor="#888888"
                    android:paddingBottom="6dp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:background="#111111" />
        </LinearLayout>

        <!-- ══════════════════════════════════════ -->
        <!-- NAP DETECTION CARD -->
        <!-- ══════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_lifeos_gradient_border"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="NAP DETECTION"
                android:textSize="12sp"
                android:letterSpacing="0.1"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ADD METRIC →"
                android:textSize="10sp"
                android:textColor="#888888"
                android:letterSpacing="0.05" />
        </LinearLayout>

        <!-- ══════════════════════════════════════ -->
        <!-- WORKOUT CARD — chip grid per field    -->
        <!-- ══════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_lifeos_gradient_border"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="WORKOUT"
                    android:textSize="10sp"
                    android:letterSpacing="0.15"
                    android:textColor="#888888" />

                <TextView
                    android:id="@+id/tvWorkoutType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="RUNNING"
                    android:textSize="10sp"
                    android:textColor="#4ADE80"
                    android:letterSpacing="0.1" />
            </LinearLayout>

            <!-- ROW 1: id | isSynced | isAccepted -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="8dp">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical"
                    android:background="#1A1A1A" android:padding="10dp" android:layout_marginEnd="6dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="ID" android:textSize="8sp" android:letterSpacing="0.1" android:textColor="#555555" />
                    <TextView android:id="@+id/tvWorkoutId" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" tools:text="--"
                        android:textSize="14sp" android:textStyle="bold" android:textColor="#FFFFFF"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical"
                    android:background="#1A1A1A" android:padding="10dp" android:layout_marginEnd="6dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="IS SYNCED" android:textSize="8sp" android:letterSpacing="0.1" android:textColor="#555555" />
                    <TextView android:id="@+id/tvWorkoutIsSynced" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" tools:text="--"
                        android:textSize="14sp" android:textStyle="bold" android:textColor="#FFFFFF"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical"
                    android:background="#1A1A1A" android:padding="10dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="ACCEPTED" android:textSize="8sp" android:letterSpacing="0.1" android:textColor="#555555" />
                    <TextView android:id="@+id/tvWorkoutIsAccepted" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" tools:text="--"
                        android:textSize="14sp" android:textStyle="bold" android:textColor="#FFFFFF"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ROW 2: duration | durationSeconds | type -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="8dp">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical"
                    android:background="#1A1A1A" android:padding="10dp" android:layout_marginEnd="6dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="DURATION" android:textSize="8sp" android:letterSpacing="0.1" android:textColor="#555555" />
                    <TextView android:id="@+id/tvWorkoutDuration" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" tools:text="--"
                        android:textSize="14sp" android:textStyle="bold" android:textColor="#FFFFFF"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical"
                    android:background="#1A1A1A" android:padding="10dp" android:layout_marginEnd="6dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="DURATION (S)" android:textSize="8sp" android:letterSpacing="0.1" android:textColor="#555555" />
                    <TextView android:id="@+id/tvWorkoutDurationSeconds" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" tools:text="--"
                        android:textSize="14sp" android:textStyle="bold" android:textColor="#FFFFFF"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical"
                    android:background="#1A1A1A" android:padding="10dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="TYPE" android:textSize="8sp" android:letterSpacing="0.1" android:textColor="#555555" />
                    <TextView android:id="@+id/tvWorkoutType2" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" tools:text="--"
                        android:textSize="14sp" android:textStyle="bold" android:textColor="#FFFFFF"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ROW 3: intensity | calories | steps -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="8dp">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical"
                    android:background="#1A1A1A" android:padding="10dp" android:layout_marginEnd="6dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="INTENSITY" android:textSize="8sp" android:letterSpacing="0.1" android:textColor="#555555" />
                    <TextView android:id="@+id/tvWorkoutIntensity" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" tools:text="--"
                        android:textSize="14sp" android:textStyle="bold" android:textColor="#FFFFFF"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical"
                    android:background="#1A1A1A" android:padding="10dp" android:layout_marginEnd="6dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="CALORIES" android:textSize="8sp" android:letterSpacing="0.1" android:textColor="#555555" />
                    <TextView android:id="@+id/tvWorkoutCalories" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" tools:text="--"
                        android:textSize="14sp" android:textStyle="bold" android:textColor="#FFFFFF"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical"
                    android:background="#1A1A1A" android:padding="10dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="STEPS" android:textSize="8sp" android:letterSpacing="0.1" android:textColor="#555555" />
                    <TextView android:id="@+id/tvWorkoutSteps" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" tools:text="--"
                        android:textSize="14sp" android:textStyle="bold" android:textColor="#FFFFFF"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ROW 4: startTime | endTime -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="8dp">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical"
                    android:background="#1A1A1A" android:padding="10dp" android:layout_marginEnd="6dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="START TIME" android:textSize="8sp" android:letterSpacing="0.1" android:textColor="#555555" />
                    <TextView android:id="@+id/tvWorkoutStartTime" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" tools:text="--"
                        android:textSize="12sp" android:textStyle="bold" android:textColor="#FFFFFF"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical"
                    android:background="#1A1A1A" android:padding="10dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="END TIME" android:textSize="8sp" android:letterSpacing="0.1" android:textColor="#555555" />
                    <TextView android:id="@+id/tvWorkoutEndTime" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" tools:text="--"
                        android:textSize="12sp" android:textStyle="bold" android:textColor="#FFFFFF"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ROW 5: cadence | distance | recoveryTime -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="8dp">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical"
                    android:background="#1A1A1A" android:padding="10dp" android:layout_marginEnd="6dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="CADENCE" android:textSize="8sp" android:letterSpacing="0.1" android:textColor="#555555" />
                    <TextView android:id="@+id/tvWorkoutCadence" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" tools:text="--"
                        android:textSize="14sp" android:textStyle="bold" android:textColor="#FFFFFF"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical"
                    android:background="#1A1A1A" android:padding="10dp" android:layout_marginEnd="6dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="DISTANCE" android:textSize="8sp" android:letterSpacing="0.1" android:textColor="#555555" />
                    <TextView android:id="@+id/tvWorkoutDistance" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" tools:text="--"
                        android:textSize="14sp" android:textStyle="bold" android:textColor="#FFFFFF"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical"
                    android:background="#1A1A1A" android:padding="10dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="RECOVERY" android:textSize="8sp" android:letterSpacing="0.1" android:textColor="#555555" />
                    <TextView android:id="@+id/tvWorkoutRecovery" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" tools:text="--"
                        android:textSize="14sp" android:textStyle="bold" android:textColor="#FFFFFF"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ROW 6: fitnessAge | energyConsumption | date -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="8dp">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical"
                    android:background="#1A1A1A" android:padding="10dp" android:layout_marginEnd="6dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="FITNESS AGE" android:textSize="8sp" android:letterSpacing="0.1" android:textColor="#555555" />
                    <TextView android:id="@+id/tvWorkoutFitnessAge" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" tools:text="--"
                        android:textSize="14sp" android:textStyle="bold" android:textColor="#4ADE80"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical"
                    android:background="#1A1A1A" android:padding="10dp" android:layout_marginEnd="6dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="ENERGY" android:textSize="8sp" android:letterSpacing="0.1" android:textColor="#555555" />
                    <TextView android:id="@+id/tvWorkoutEnergyConsumption" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" tools:text="--"
                        android:textSize="14sp" android:textStyle="bold" android:textColor="#4ADE80"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical"
                    android:background="#1A1A1A" android:padding="10dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="DATE" android:textSize="8sp" android:letterSpacing="0.1" android:textColor="#555555" />
                    <TextView android:id="@+id/tvWorkoutDate" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" tools:text="--"
                        android:textSize="12sp" android:textStyle="bold" android:textColor="#FFFFFF"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Full-width: HR DATA -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="#1A1A1A"
                android:padding="10dp" android:layout_marginBottom="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="HR DATA" android:textSize="8sp" android:letterSpacing="0.1" android:textColor="#555555" />
                <TextView android:id="@+id/tvWorkoutHrData" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" tools:text="--"
                    android:textSize="12sp" android:textStyle="bold" android:textColor="#FFFFFF"
                    android:fontFamily="monospace" android:maxLines="3" android:ellipsize="end"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Full-width: INTENSITY LIST -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="#1A1A1A" android:padding="10dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
