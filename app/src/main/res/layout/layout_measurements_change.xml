<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools">

    <TextView
        android:id="@+id/tvTitle"
        style="@style/S14"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#99FFFFFF"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Weight" />

    <TextView
        android:id="@+id/tvCurrentValue"
        style="@style/S16"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textColor="#B3FFFFFF"
        android:textSize="32sp"
        app:layout_constraintEnd_toEndOf="@+id/tvCurrentDate"
        app:layout_constraintStart_toStartOf="@+id/tvCurrentDate"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"
        tools:text="49" />

    <TextView
        android:id="@+id/tvCurrentDate"
        style="@style/S12"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="#99FFFFFF"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvCurrentValue"
        tools:text="24th Jan 25" />

    <ImageView
        android:id="@+id/imageView64"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:src="@drawable/ic_g_fit_change"
        app:layout_constraintBottom_toBottomOf="@+id/tvCurrentDate"
        app:layout_constraintStart_toEndOf="@+id/tvCurrentDate"
        app:layout_constraintTop_toTopOf="@+id/tvCurrentValue" />

    <TextView
        android:id="@+id/tvChangedValue"
        style="@style/S16"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:textColor="#B3FFFFFF"
        android:textSize="32sp"
        app:layout_constraintBottom_toTopOf="@+id/tvChangedDate"
        app:layout_constraintEnd_toEndOf="@+id/tvChangedDate"
        app:layout_constraintStart_toStartOf="@+id/tvChangedDate"
        tools:text="49" />

    <TextView
        android:id="@+id/tvChangedDate"
        style="@style/S12"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:textColor="#99FFFFFF"
        app:layout_constraintBaseline_toBaselineOf="@+id/tvCurrentDate"
        app:layout_constraintStart_toEndOf="@+id/imageView64"
        tools:text="24th Jan 25" />


</androidx.constraintlayout.widget.ConstraintLayout>