<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent">


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/list"
            style="@style/ModalStyleDialog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimen_12dp"
            android:layout_marginTop="@dimen/dimen_12dp"
            android:layout_marginEnd="@dimen/dimen_12dp"
            android:layout_marginBottom="@dimen/dimen_12dp"
            tools:listitem="@layout/fragment_privacy_bottom_dialog_list_dialog_item">

            <View
                android:layout_width="80dp"
                android:layout_height="2dp"
                android:layout_marginTop="4dp"
                android:alpha="0.5"
                android:background="@drawable/back_bottom_sheet_drag"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />


            <ImageView
                android:id="@+id/oreoStatus"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginTop="50dp"
                android:background="@drawable/back_modal_new_round"
                android:src="@drawable/ic_ring_default_silver_new"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/batteryStatus"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:indeterminate="false"
                app:indicatorSize="64dp"
                app:layout_constraintBottom_toBottomOf="@+id/oreoStatus"
                app:layout_constraintEnd_toEndOf="@+id/oreoStatus"
                app:layout_constraintStart_toStartOf="@+id/oreoStatus"
                app:layout_constraintTop_toTopOf="@+id/oreoStatus"
                app:trackColor="#1effffff"
                app:trackThickness="1dp" />


            <TextView
                android:id="@+id/textView90"
                style="@style/H4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="32dp"
                android:gravity="center"
                android:text="@string/text_time_to_charge_your_ring"
                android:textColor="#eeeeee"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/oreoStatus" />

            <TextView
                android:id="@+id/textRingConnecteMessage"
                style="@style/H6"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="32dp"
                android:gravity="center"
                android:text="@string/text_ring_not_in_range"
                android:textColor="#8a8c8e"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textView90" />


            <ImageView
                android:id="@+id/ivConnectSuccess"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginTop="50dp"
                android:src="@drawable/iv_connected_successfully"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textRingConnecteMessage"
                tools:visibility="visible" />


            <TextView
                android:id="@+id/textConnectSuccess"
                style="@style/H4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center_horizontal"
                android:text="@string/text_connected_successfully"
                android:textColor="@color/white"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ivConnectSuccess"
                tools:visibility="visible" />

            <Button
                android:id="@+id/btnAllow"
                style="@style/PrimaryButtonStyle"
                android:layout_width="0dp"
                android:layout_marginStart="24dp"
                android:layout_marginTop="@dimen/dimen_24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginBottom="@dimen/dimen_24dp"
                android:text="@string/text_done"
                app:backgroundTint="@null"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textConnectSuccess" />

            <androidx.constraintlayout.widget.Group
                android:id="@+id/groupConnected"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:constraint_referenced_ids="ivConnectSuccess,textConnectSuccess" />

            <androidx.constraintlayout.widget.Group
                android:id="@+id/groupConnecting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="oreoStatus,lottieAnimView,textView90,textRingConnecteMessage" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </RelativeLayout>
</layout>
