<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="132dp">

        <View
            android:id="@+id/vLeft"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginStart="47dp"
            android:layout_marginBottom="1dp"
            android:layout_marginTop="1dp"
            android:background="@color/white_30"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/vRight"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="47dp"
            android:layout_marginBottom="1dp"
            android:layout_marginTop="1dp"
            android:background="@color/white_30"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/vCenter"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginEnd="1dp"
            android:layout_marginStart="1dp"
            android:background="@color/white_30"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/vRight"
            app:layout_constraintStart_toEndOf="@id/vLeft"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/vBottom"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/white_30"
            android:layout_marginStart="1dp"
            android:layout_marginEnd="1dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <ImageView
            android:id="@+id/imageView1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_default_timer_chips"
            app:layout_constraintBottom_toBottomOf="@id/vBottom"
            app:layout_constraintEnd_toEndOf="@id/vRight"
            app:layout_constraintStart_toStartOf="@id/vLeft"
            app:layout_constraintTop_toTopOf="@id/vCenter"
            tools:ignore="ContentDescription" />

        <ImageView
            android:id="@+id/ivSuperOver"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_super_over"
            app:layout_constraintBottom_toBottomOf="@id/vCenter"
            app:layout_constraintEnd_toEndOf="@id/vRight"
            app:layout_constraintStart_toStartOf="@id/vLeft"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="ContentDescription" />

        <TextView
            style="@style/H6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/gilroy_bold"
            android:id="@+id/tvTimer"
            app:layout_constraintBottom_toBottomOf="@id/imageView1"
            app:layout_constraintEnd_toEndOf="@id/imageView1"
            app:layout_constraintStart_toStartOf="@id/imageView1"
            app:layout_constraintTop_toTopOf="@id/imageView1"
            tools:text="10" />

        </androidx.constraintlayout.widget.ConstraintLayout>
</layout>