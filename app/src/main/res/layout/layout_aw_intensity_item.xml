<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <View
            android:id="@+id/viewIntensity"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/back_modal_transparent_oreo"
            app:layout_constraintBottom_toBottomOf="@+id/lytItem"
            app:layout_constraintEnd_toEndOf="@+id/lytItem"
            app:layout_constraintStart_toStartOf="@+id/lytItem"
            app:layout_constraintTop_toTopOf="@+id/lytItem" />

        <include
            android:id="@+id/lytItem"
            android:layout_margin="@dimen/dimen_16dp"
            layout="@layout/layout_aw_start_end_time_sub_item"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvEasyTitle"
            style="@style/Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginTop="24dp"
            android:text="@string/text_easy"

            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/viewIntensity" />

        <TextView
            android:id="@+id/tvEasyDesc"
            style="@style/Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="@string/text_light_exercise"
            android:textColor="@color/white_64"

            app:layout_constraintBottom_toBottomOf="@id/tvEasyTitle"
            app:layout_constraintStart_toEndOf="@id/tvEasyTitle"
            app:layout_constraintTop_toTopOf="@id/tvEasyTitle" />

        <TextView
            android:id="@+id/tvModerateTitle"
            style="@style/Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginTop="4dp"
            android:text="@string/text_moderate"

            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvEasyTitle" />

        <TextView
            android:id="@+id/tvModerateDesc"
            style="@style/Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="@string/text_intermediate_exercise"
            android:textColor="@color/white_64"

            app:layout_constraintBottom_toBottomOf="@id/tvModerateTitle"
            app:layout_constraintStart_toEndOf="@id/tvModerateTitle"
            app:layout_constraintTop_toTopOf="@id/tvModerateTitle" />

        <TextView
            android:id="@+id/tvHardTitle"
            style="@style/Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginBottom="@dimen/dimen_8dp"
            android:layout_marginTop="4dp"
            android:text="@string/text_hard"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvModerateTitle" />

        <TextView
            android:id="@+id/tvHardDesc"
            style="@style/Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginStart="4dp"
            android:text="@string/text_advanced_level_vigorous_exercise"
            android:textColor="@color/white_64"

            app:layout_constraintBottom_toBottomOf="@id/tvHardTitle"
            app:layout_constraintStart_toEndOf="@id/tvHardTitle"
            app:layout_constraintTop_toTopOf="@id/tvHardTitle" />


    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>