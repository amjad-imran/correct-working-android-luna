<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:lineChart="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <include
            android:id="@+id/lytTopView"
            layout="@layout/layout_stress_internal_top_view"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvMsg"
            style="@style/Small"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/side_margin"
            android:layout_marginTop="26dp"
            android:layout_marginEnd="@dimen/side_margin"
            android:textColor="@color/white_64"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/lytTopView"
            tools:text="You have spent an average of 1 hr 19 min in the high stress zone today, which is above your typical average on any Tuesday (50 min)." />


        <com.oreo.ui.custom.StressAreaChart
            android:id="@+id/stressChart"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            tools:visibility="visible"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvMsg"
            lineChart:bgBottomColor="@android:color/transparent"
            lineChart:bgColor="@android:color/transparent"
            lineChart:bgLeftColor="@android:color/transparent"
            lineChart:bgRightColor="@android:color/transparent"
            lineChart:bgTopColor="@android:color/transparent"
            lineChart:bottomWith="30dp"
            lineChart:centerLineColor="#ffffff"
            lineChart:chartLineColor="#ffda55"
            lineChart:fillColorEnd="#00ffd230"
            lineChart:fillColorStart="#80d6a700"
            lineChart:gridColor="@color/white_12"
            lineChart:hCount="7"
            lineChart:innerCircleColor="#ffffff"
            lineChart:innerCircleRadius="4dp"
            lineChart:leftWith="0dp"
            lineChart:outCircleColor="#ffeeb2"
            lineChart:outCircleRadius="1dp"
            lineChart:rightWith="20dp"
            lineChart:scaleColor="#ff000000"
            lineChart:scaleLenth="4dp"
            lineChart:scaleNodeColor="#FFFFFF"
            lineChart:scaleNodeRadius="6dp"
            lineChart:showAvgValue="true"
            lineChart:showGrid="true"
            lineChart:topWith="16dp"
            lineChart:vCount="2"
            lineChart:xLineColor="#80FFFFFF"
            lineChart:xMax="130"
            lineChart:xMin="0"
            lineChart:xTextColor="#FFFFFF"
            lineChart:xTextSize="12sp"
            lineChart:xTextSize2="12sp"
            lineChart:yLineColor="#00FFFFFF"
            lineChart:yTextSize="12sp" />

        <include
            android:id="@+id/progressBar1"
            layout="@layout/default_loader"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>