<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="features"
            type="com.noisefit_commans.data.model.DeviceFeatures" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        tools:context=".ui.dashboard.feature.stock.StocksFragment">


        <include
            android:id="@+id/lytToolbar"
            layout="@layout/layout_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.noisefit_commans.ui.custom.SettingsRow
            android:id="@+id/llAppNotification"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="visible"
            app:hideTopLine="false"
            app:image="@drawable/ic_notification_bell_white"
            app:status="Disabled"
            app:text="@string/text_app_notifications" />

        <com.noisefit_commans.ui.custom.SettingsRow
            android:id="@+id/llSmartNotifications"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:image="@drawable/ic_smart_notification"
            android:visibility="gone"
            app:text="@string/text_smart_notifications"
            tools:visibility="visible" />

        <com.noisefit_commans.ui.custom.SettingsRow
            android:id="@+id/llSmsAlert"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="visible"
            app:hideTopLine="false"
            app:image="@drawable/ic_message"
            app:status="Disabled"
            app:text="@string/text_sms_alert" />


        <com.noisefit_commans.ui.custom.SettingsRow
            android:id="@+id/llMyReminder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="visible"
            app:hideTopLine="false"
            app:image="@drawable/ic_my_reminders"
            app:setFeatureVisibility="@{features.reminder}"
            app:text="@string/text_my_reminders" />


        <include
            android:id="@+id/progressBar"
            layout="@layout/default_loader"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />


    </LinearLayout>
</layout>