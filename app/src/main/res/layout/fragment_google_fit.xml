<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".ui.dashboard.feature.stock.StocksFragment">


        <include
            android:id="@+id/lytToolbarWithDetails"
            layout="@layout/layout_toolbar_with_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <include
            android:id="@+id/lytFeatureTile"
            layout="@layout/row_feature_status_tile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/lytToolbarWithDetails" />


        <include
            android:id="@+id/lytGoogleFitDisclosure"
            layout="@layout/layout_google_fit_disclosure"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/lytFeatureTile" />


        <!--        <com.google.android.material.button.MaterialButton-->
        <!--            android:id="@+id/bRequestData"-->
        <!--            style="@style/PrimaryButtonStyle"-->
        <!--            android:layout_width="0dp"-->
        <!--            android:layout_marginStart="@dimen/side_margin"-->
        <!--            android:layout_marginEnd="@dimen/side_margin"-->
        <!--            android:text="Request Data"-->
        <!--            app:backgroundTint="@null"-->
        <!--            app:layout_constraintBottom_toTopOf="@id/bConnect"-->
        <!--            app:layout_constraintEnd_toEndOf="parent"-->
        <!--            app:layout_constraintStart_toStartOf="parent" />-->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/bConnect"
            style="@style/PrimaryButtonStyle"
            android:layout_width="0dp"
            android:layout_marginStart="@dimen/side_margin"
            android:layout_marginEnd="@dimen/side_margin"
            android:layout_marginBottom="@dimen/bottom_margin"
            android:text="@string/text_connect"
            app:backgroundTint="@null"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <include
            android:id="@+id/lytGoogleFitEnable"
            layout="@layout/layout_google_fit_enable"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="32dp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/lytToolbarWithDetails"
            app:layout_constraintBottom_toBottomOf="parent"
            tools:visibility="visible" />
        <include
            android:id="@+id/progressBar"
            layout="@layout/default_loader"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />



    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>