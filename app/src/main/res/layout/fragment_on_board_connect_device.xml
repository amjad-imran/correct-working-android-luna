<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <TextView
            android:id="@+id/tvTitle"
            style="@style/H2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/side_margin"
            android:layout_marginTop="88dp"
            android:layout_marginEnd="@dimen/side_margin"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="@string/text_connect_your_device"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvSubTitle"
            style="@style/Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/side_margin"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="@dimen/side_margin"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="@string/text_select_your_device_to_connect"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTitle" />

        <TextView
            android:id="@+id/tvSmartwatch"
            style="@style/Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/side_margin"
            android:layout_marginTop="32dp"
            android:layout_marginEnd="@dimen/side_margin"
            android:background="@drawable/back_modal_new"
            android:drawablePadding="16dp"
            android:ellipsize="end"
            android:gravity="center|start"
            android:paddingStart="@dimen/side_margin"
            android:paddingTop="16dp"
            android:paddingEnd="0dp"
            android:paddingBottom="16dp"
            android:singleLine="true"
            android:text="@string/text_smartwatch"
            app:drawableStartCompat="@drawable/ic_my_device"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvSubTitle" />

        <TextView
            android:id="@+id/tvOreo"
            style="@style/Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/side_margin"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="@dimen/side_margin"
            android:background="@drawable/back_modal_new"
            android:drawablePadding="16dp"
            android:ellipsize="end"
            android:gravity="center|start"
            android:paddingStart="@dimen/side_margin"
            android:paddingTop="16dp"
            android:paddingEnd="0dp"
            android:paddingBottom="16dp"
            android:singleLine="true"
            android:text="@string/text_smart_ring"
            app:drawableStartCompat="@drawable/ic_my_device"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvSmartwatch" />


    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>