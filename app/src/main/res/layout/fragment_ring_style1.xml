<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/back_post_imag_gradient"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        tools:context=".ui.feeds.create.styles.health.RingStyle1Fragment">

        <com.hookedonplay.decoviewlib.DecoView
            android:id="@+id/dynamicArcView"
            android:layout_width="124dp"
            android:layout_height="124dp"
            android:layout_marginEnd="@dimen/side_margin"
            app:layout_constraintBottom_toBottomOf="@+id/imageView20"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/textSteps" />

        <TextView
            android:id="@+id/textCalories"
            style="@style/Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/side_margin"
            android:layout_marginBottom="8dp"
            android:text="@string/text_calories"
            android:textColor="@color/white"
            app:layout_constraintBottom_toTopOf="@+id/imageView20"
            app:layout_constraintStart_toStartOf="parent" />

        <ImageView
            android:id="@+id/imageView20"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginBottom="24dp"
            android:src="@drawable/ic_calories"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@+id/textCalories" />

        <TextView
            android:id="@+id/tvCalorieCurrent"
            style="@style/H5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textColor="@color/calories_arc"
            app:layout_constraintBottom_toBottomOf="@+id/imageView20"
            app:layout_constraintStart_toEndOf="@+id/imageView20"
            app:layout_constraintTop_toTopOf="@+id/imageView20"
            tools:text="2500" />

        <TextView
            android:id="@+id/tvCalorieGoal"
            style="@style/Tinny"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white_80"
            app:layout_constraintBaseline_toBaselineOf="@id/tvCalorieCurrent"
            app:layout_constraintBottom_toBottomOf="@+id/tvCalorieCurrent"
            app:layout_constraintStart_toEndOf="@+id/tvCalorieCurrent"
            tools:text="/2500" />

        <TextView
            android:id="@+id/textSteps"
            style="@style/Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/text_steps"
            android:textColor="@color/white"
            app:layout_constraintBottom_toTopOf="@+id/imageView6"
            app:layout_constraintStart_toStartOf="@+id/textDistance" />

        <TextView
            android:id="@+id/tvStepCurrent"
            style="@style/H5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textColor="@color/steps_arc"
            app:layout_constraintBottom_toBottomOf="@+id/imageView6"
            app:layout_constraintStart_toEndOf="@+id/imageView6"
            app:layout_constraintTop_toTopOf="@+id/imageView6"
            tools:text="2500" />


        <ImageView
            android:id="@+id/imageView6"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="20dp"
            android:src="@drawable/ic_steps"
            app:layout_constraintBottom_toTopOf="@+id/textDistance"
            app:layout_constraintStart_toStartOf="@+id/textSteps" />

        <TextView
            android:id="@+id/tvStepGoal"
            style="@style/Tinny"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white_80"
            app:layout_constraintBaseline_toBaselineOf="@id/tvStepCurrent"
            app:layout_constraintBottom_toBottomOf="@+id/tvStepCurrent"
            app:layout_constraintStart_toEndOf="@+id/tvStepCurrent"
            tools:text="/2500" />

        <TextView
            android:id="@+id/textDistance"
            style="@style/Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/distance"
            android:textColor="@color/white"
            app:layout_constraintBottom_toTopOf="@+id/imageView19"
            app:layout_constraintStart_toStartOf="@+id/textCalories" />

        <TextView
            android:id="@+id/tvDistanceCurrent"
            style="@style/H5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textColor="@color/distance_arc"
            app:layout_constraintBottom_toBottomOf="@+id/imageView19"
            app:layout_constraintStart_toEndOf="@+id/imageView19"
            app:layout_constraintTop_toTopOf="@+id/imageView19"
            tools:text="2500" />

        <ImageView
            android:id="@+id/imageView19"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginBottom="20dp"
            android:src="@drawable/ic_distance"
            app:layout_constraintBottom_toTopOf="@+id/textCalories"
            app:layout_constraintStart_toStartOf="@+id/textDistance" />

        <TextView
            android:id="@+id/tvDistanceGoal"
            style="@style/Tinny"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white_80"
            app:layout_constraintBaseline_toBaselineOf="@id/tvDistanceCurrent"
            app:layout_constraintBottom_toBottomOf="@+id/tvDistanceCurrent"
            app:layout_constraintStart_toEndOf="@+id/tvDistanceCurrent"
            tools:text="/2500" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>