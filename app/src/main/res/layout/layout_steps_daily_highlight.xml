<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/back_modal_new">

        <TextView
            android:id="@+id/textView11"
            style="@style/H5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/side_margin"
            android:layout_marginTop="16dp"
            tools:text="Daily Highlights"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvMessage"
            style="@style/H6"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/side_margin"
            android:lineSpacingExtra="6sp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="@dimen/side_margin"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView11"
            tools:text="Your total step count today is more than yesterday" />

        <TextView
            android:id="@+id/tvTotalStepsCount"
            style="@style/H2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/side_margin"
            android:layout_marginTop="12dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvMessage"
            tools:text="10000" />

        <TextView
            android:id="@+id/tvUnitTodayDaily"
            style="@style/Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="Steps"
            android:layout_marginBottom="2dp"
            android:textColor="@color/very_light_pink"
            app:layout_constraintBottom_toBottomOf="@+id/tvTotalStepsCount"
            app:layout_constraintStart_toEndOf="@+id/tvTotalStepsCount" />

        <include
            android:id="@+id/layoutProgress1"
            layout="@layout/layout_oreo_goals_progress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/side_margin"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="@dimen/side_margin"
            app:layout_constraintEnd_toStartOf="@+id/textView13"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvTotalStepsCount" />

        <TextView
            android:id="@+id/textView13"
            style="@style/Small"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/side_margin"
            tools:text="Today"
            android:textSize="12sp"
            android:textColor="@color/very_light_pink"
            app:layout_constraintBottom_toBottomOf="@+id/layoutProgress1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/layoutProgress1" />


        <TextView
            android:id="@+id/tvCount2"
            style="@style/H2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/side_margin"
            android:layout_marginTop="20dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layoutProgress1"
            tools:text="10000" />

        <include
            android:id="@+id/layoutProgress2"
            layout="@layout/layout_oreo_goals_progress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="@dimen/side_margin"
            android:layout_marginBottom="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tvData2Title"
            app:layout_constraintStart_toStartOf="@+id/tvCount2"
            app:layout_constraintTop_toBottomOf="@+id/tvCount2" />

        <TextView
            android:id="@+id/tvData2Title"
            style="@style/Small"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            tools:text="Today"
            android:textSize="12sp"
            android:layout_marginEnd="@dimen/side_margin"
            android:textColor="@color/very_light_pink"
            app:layout_constraintBottom_toBottomOf="@+id/layoutProgress2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/layoutProgress2" />

        <TextView
            android:id="@+id/tvUnitYestDaily"
            style="@style/Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Steps"
            android:layout_marginBottom="2dp"
            android:layout_marginStart="4dp"
            android:textColor="@color/very_light_pink"
            app:layout_constraintBottom_toBottomOf="@+id/tvCount2"
            app:layout_constraintStart_toEndOf="@+id/tvCount2" />


    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>