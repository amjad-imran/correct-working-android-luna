<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black"
        tools:context=".ui.watchface2.Watchface2CategoryFragment">

        <include
            android:id="@+id/lytToolbar"
            layout="@layout/layout_toolbar_large"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <ImageButton
            android:id="@+id/backFav"
            style="@style/ToolbarFavButton"
            android:layout_marginEnd="@dimen/dimen_16dp"
            android:contentDescription="@string/text_favourite_watchface"
            app:layout_constraintBottom_toBottomOf="@+id/lytToolbar"
            app:layout_constraintEnd_toEndOf="@+id/lytToolbar"
            app:layout_constraintTop_toTopOf="@+id/lytToolbar" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv"
            android:layout_width="match_parent"
            android:layout_height="0dp"

            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/lytToolbar">

        </androidx.recyclerview.widget.RecyclerView>



        <include
            android:id="@+id/progressBar"
            layout="@layout/default_loader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>