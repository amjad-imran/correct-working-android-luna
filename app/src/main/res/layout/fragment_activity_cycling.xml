<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".ui.workout.cycling.ActivityCyclingFragment">

        <RelativeLayout
            android:id="@+id/relativeLayout"
            android:layout_width="0dp"
            android:layout_height="56dp"

            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.0">

            <ImageButton
                android:id="@+id/backBtn"
                style="@style/ToolbarBackButton"
                android:layout_alignParentStart="true"
                android:layout_centerInParent="true"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="@dimen/dimen_16dp"
                android:contentDescription="@string/text_back" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvToolbarTitle"
                style="@style/H4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:ellipsize="end"
                android:fontFamily="@font/gilroy_medium"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/white"
                tools:ignore="RelativeOverlap"
                tools:text="Outdoor Cycling" />

            <ImageButton
                android:id="@+id/viewShare"
                style="@style/ToolbarBackButton"
                android:layout_alignParentEnd="true"
                android:layout_centerInParent="true"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="@dimen/side_margin"
                android:padding="10dp"
                android:src="@drawable/ic_share"
                app:tint="@color/white" />

        </RelativeLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/relativeLayout"
            tools:visibility="visible">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <include
                    android:id="@+id/separator209"
                    layout="@layout/layout_line_separator"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:visibility="visible"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />


                <View
                    android:id="@+id/viewActivityBack"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_marginTop="@dimen/dimen_32dp"
                    android:background="@drawable/back_image_step"
                    android:layout_marginStart="@dimen/dimen_16dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/separator209" />

                <ImageView
                    android:id="@+id/ivActivityType"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/ic_act_outdoor_cycling"
                    app:layout_constraintBottom_toBottomOf="@+id/viewActivityBack"
                    app:layout_constraintEnd_toEndOf="@+id/viewActivityBack"
                    app:layout_constraintStart_toStartOf="@+id/viewActivityBack"
                    app:layout_constraintTop_toTopOf="@+id/viewActivityBack" />

                <TextView
                    android:id="@+id/tvHeaderDistance"
                    style="@style/H28"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dimen_24dp"
                    android:layout_marginBottom="@dimen/dimen_4dp"
                    android:textColor="@color/new_dark_lime"
                    app:layout_constraintBottom_toTopOf="@+id/tvDayTime"

                    app:layout_constraintStart_toEndOf="@+id/viewActivityBack"
                    tools:text="45.89" />

                <TextView
                    android:id="@+id/tvHeaderUnit"
                    style="@style/H6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="@dimen/dimen_4dp"
                    android:textColor="@color/new_dark_lime"
                    app:layout_constraintBottom_toBottomOf="@+id/tvHeaderDistance"
                    app:layout_constraintStart_toEndOf="@+id/tvHeaderDistance"
                    tools:text="km" />

                <TextView
                    android:id="@+id/tvDayTime"
                    style="@style/H6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:layout_marginStart="@dimen/dimen_24dp"
                    app:layout_constraintBottom_toBottomOf="@+id/viewActivityBack"

                    app:layout_constraintStart_toEndOf="@+id/viewActivityBack"
                    app:layout_constraintTop_toTopOf="@+id/viewActivityBack"
                    tools:text="Wed, 02/05/23" />


                <TextView
                    android:id="@+id/tvBetween"
                    style="@style/Small"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:textColor="@color/white_64"

                    app:layout_constraintBottom_toBottomOf="@+id/viewActivityBack"
                    app:layout_constraintEnd_toEndOf="@+id/tvTime"
                    app:layout_constraintStart_toStartOf="@+id/tvDayTime"
                    app:layout_constraintTop_toBottomOf="@+id/tvDayTime"
                    tools:text="Delhi - Madhya Pradesh" />

                <View
                    android:id="@+id/separator11"
                    android:layout_width="2dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="@dimen/dimen_4dp"
                    android:background="@color/modal_color"
                    app:layout_constraintBottom_toBottomOf="@+id/tvDayTime"
                    app:layout_constraintStart_toEndOf="@+id/tvDayTime"
                    app:layout_constraintTop_toTopOf="@+id/tvDayTime" />

                <TextView
                    android:id="@+id/tvTime"
                    style="@style/H6"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:textColor="@color/white"
                    android:layout_marginEnd="@dimen/dimen_8dp"
                    app:layout_constraintBottom_toBottomOf="@+id/tvDayTime"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/separator11"
                    app:layout_constraintTop_toTopOf="@+id/tvDayTime"
                    tools:text="11:33 am - 12:35 pm" />

                <include
                    android:id="@+id/separator1"
                    layout="@layout/layout_line_separator"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="32dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/viewActivityBack" />

                <TextView
                    android:id="@+id/tvDetails"
                    style="@style/H4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/side_margin"
                    android:layout_marginTop="@dimen/dimen_32dp"
                    android:layout_marginEnd="@dimen/side_margin"
                    android:text="@string/details"
                    android:textColor="@color/white"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/separator1" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvActivityDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/side_margin"
                    android:background="@drawable/back_modal_new"
                    android:nestedScrollingEnabled="false"
                    android:orientation="vertical"

                    app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvDetails"
                    app:spanCount="2"
                    tools:itemCount="5"
                    tools:listitem="@layout/row_cycling_details_item" />

                <include
                    android:id="@+id/separator2"
                    layout="@layout/layout_line_separator"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/dimen_32dp"
                    android:visibility="visible"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/rvActivityDetails" />


                <TextView
                    android:id="@+id/tvRouteTitle"
                    style="@style/H4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/side_margin"
                    android:layout_marginTop="@dimen/dimen_32dp"
                    android:text="@string/route"
                    android:visibility="visible"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/separator2" />

                <RelativeLayout
                    android:id="@+id/view1"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginStart="@dimen/side_margin"
                    android:layout_marginEnd="@dimen/dimen_16dp"
                    android:layout_marginBottom="-16dp"
                    android:background="@drawable/back_modal_new"
                    app:layout_constraintBottom_toBottomOf="@+id/tvHumidityValue"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/cardMap" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardMap"
                    android:layout_width="match_parent"
                    android:layout_height="224dp"
                    android:layout_marginStart="@dimen/side_margin"
                    android:layout_marginTop="@dimen/dimen_16dp"
                    android:layout_marginEnd="@dimen/side_margin"
                    app:cardForegroundColor="@color/transparent"
                    app:cardBackgroundColor="@color/transparent"
                    app:cardElevation="0dp"
                    app:cardCornerRadius="10dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvRouteTitle">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="224dp"
                        android:paddingBottom="10dp">

                        <androidx.fragment.app.FragmentContainerView
                            android:id="@+id/map"
                            android:name="com.google.android.gms.maps.SupportMapFragment"
                            android:layout_width="match_parent"
                            android:layout_height="214dp"
                            android:visibility="visible" />

                        <ImageView
                            android:id="@+id/imageTransparent"
                            android:layout_width="match_parent"
                            android:layout_height="214dp"
                            android:layout_marginStart="@dimen/side_margin"
                            android:layout_marginTop="@dimen/dimen_16dp"
                            android:layout_marginEnd="@dimen/side_margin"
                            android:src="@android:color/transparent"
                            android:visibility="visible" />

                        <ProgressBar
                            android:id="@+id/mapsPgBr"
                            android:layout_gravity="center"
                            android:layout_width="@dimen/dimen_32dp"
                            android:layout_height="@dimen/dimen_32dp"
                            android:visibility="gone" />

                    </FrameLayout>

                </com.google.android.material.card.MaterialCardView>


                <TextView
                    android:id="@+id/tvTemp"
                    style="@style/H6"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dimen_32dp"
                    android:layout_marginTop="6dp"
                    android:text="@string/text_temp"
                    android:textColor="@color/new_dark_lime"
                    app:layout_constraintEnd_toStartOf="@+id/tvHumidity"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/cardMap" />

                <TextView
                    android:id="@+id/tvTempValue"
                    style="@style/H3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_8dp"
                    android:text="@string/text_temp"
                    android:textColor="@color/white"
                    app:layout_constraintStart_toStartOf="@+id/tvTemp"
                    app:layout_constraintTop_toBottomOf="@+id/tvTemp" />

                <TextView
                    android:id="@+id/tvHumidity"
                    style="@style/H6"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/text_humidity"
                    android:textColor="@color/new_dark_lime"
                    app:layout_constraintEnd_toStartOf="@+id/tvUvIndex"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toEndOf="@+id/tvTemp"
                    app:layout_constraintTop_toBottomOf="@+id/cardMap" />

                <TextView
                    android:id="@+id/tvHumidityValue"
                    style="@style/H3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_8dp"
                    android:text="@string/text_temp"
                    android:textColor="@color/white"
                    app:layout_constraintStart_toStartOf="@+id/tvHumidity"
                    app:layout_constraintTop_toBottomOf="@+id/tvHumidity" />

                <TextView
                    android:id="@+id/tvUvIndex"
                    style="@style/H6"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginEnd="@dimen/dimen_16dp"
                    android:text="@string/text_uv_index"
                    android:textColor="@color/new_dark_lime"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toEndOf="@+id/tvHumidity"
                    app:layout_constraintTop_toBottomOf="@+id/cardMap" />

                <TextView
                    android:id="@+id/tvUvIndexValue"
                    style="@style/H3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_8dp"
                    android:text="@string/text_temp"
                    android:textColor="@color/white"
                    app:layout_constraintStart_toStartOf="@+id/tvUvIndex"
                    app:layout_constraintTop_toBottomOf="@+id/tvUvIndex" />

                <include
                    android:id="@+id/separator34"
                    layout="@layout/layout_line_separator"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/dimen_32dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/view1" />

                <include
                    android:id="@+id/lytDistanceSplit"
                    layout="@layout/layout_distance_split"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/separator34"
                    tools:visibility="visible" />


                <include
                    android:id="@+id/separator3"
                    layout="@layout/layout_line_separator"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/dimen_32dp"
                    android:visibility="gone"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/lytDistanceSplit" />

                <include
                    android:id="@+id/lytHrGraph"
                    layout="@layout/layout_cycling_hr_graph"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/separator3"
                    tools:visibility="visible" />


                <include
                    android:id="@+id/separator4"
                    layout="@layout/layout_line_separator"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/dimen_32dp"
                    android:visibility="gone"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/lytHrGraph" />

                <TextView
                    android:id="@+id/tvHeartRateZoneTitle"
                    style="@style/H4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/side_margin"
                    android:layout_marginTop="30dp"
                    android:text="@string/heart_rate_zone"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/separator4" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_view_heart_zone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dimen_16dp"
                    android:layout_marginEnd="@dimen/dimen_16dp"
                    android:nestedScrollingEnabled="false"
                    android:orientation="horizontal"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvHeartRateZoneTitle"
                    app:spanCount="2"
                    tools:itemCount="6"
                    tools:listitem="@layout/row_cycling_heart_rate_zone" />

                <include
                    android:id="@+id/separator5"
                    layout="@layout/layout_line_separator"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="32dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/recycler_view_heart_zone" />


                <TextView
                    android:id="@+id/tvMsg"
                    style="@style/Small"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="60dp"
                    android:layout_marginTop="32dp"
                    android:layout_marginEnd="60dp"
                    android:gravity="center_horizontal"
                    android:lineSpacingExtra="6sp"
                    android:text="@string/there_might_be_a_little_bit_of_inaccuracy_in_the_data_based_on_the_watch_performance"
                    android:textColor="@color/white_48"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/separator5" />

                <TextView
                    android:id="@+id/btnFeedback"

                    android:layout_width="wrap_content"
                    android:layout_height="35dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="46dp"
                    android:fontFamily="@font/gilroy_medium"
                    android:paddingStart="@dimen/dimen_24dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="@dimen/dimen_24dp"
                    android:paddingBottom="5dp"
                    android:text="@string/text_any_query_raise_a_complaint"
                    android:textColor="@color/purple_"
                    android:textSize="@dimen/text_12sp"

                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvMsg" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>