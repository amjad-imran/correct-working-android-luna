<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="24dp">

        <ImageView
            android:id="@+id/ivWatchFace"
            android:layout_width="130dp"
            android:layout_height="150dp"
            android:layout_marginBottom="16dp"
            android:adjustViewBounds="true"
            app:layout_constraintBottom_toTopOf="@+id/ivFavouriteBack"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/imageView24"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:adjustViewBounds="true"
            android:src="@drawable/ic_downloads"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@+id/ivWatchFace"
            app:layout_constraintTop_toTopOf="@+id/ivFavourite" />

        <TextView
            android:id="@+id/tvDownloadsCount"
            style="@style/Small"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="8dp"
            android:textColor="@color/very_light_pink"
            app:layout_constraintBottom_toBottomOf="@+id/imageView24"
            app:layout_constraintEnd_toStartOf="@+id/ivFavourite"
            app:layout_constraintStart_toEndOf="@+id/imageView24"
            app:layout_constraintTop_toTopOf="@+id/imageView24"
            tools:text="10000+" />

        <com.varunest.sparkbutton.SparkButton
            android:id="@+id/ivFavourite"
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/ivFavouriteBack"
            app:layout_constraintStart_toStartOf="@+id/ivFavouriteBack"
            app:layout_constraintTop_toTopOf="@+id/ivFavouriteBack"
            app:sparkbutton_activeImage="@drawable/ic_favourite_active"
            app:sparkbutton_iconSize="16dp"
            app:sparkbutton_inActiveImage="@drawable/ic_favourite_default"
            app:sparkbutton_primaryColor="@color/darker_gray"
            app:sparkbutton_secondaryColor="@color/colorRed2" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivFavouriteBack"
            android:background="@drawable/back_modal_new_round"
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/ivWatchFace"
            app:shapeAppearance="@style/ShapeAppearance.App.CircleImageView" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>