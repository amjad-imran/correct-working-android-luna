<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <me.dkzwm.widget.srl.SmoothRefreshLayout
        android:id="@+id/swipeToRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.noisefit.ui.custom.swipeHeader.srl.extra.header.ClassicHeader
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">


                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/animationView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:scaleType="fitXY"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:lottie_autoPlay="true"
                    app:lottie_loop="true" />

                <ProgressBar
                    android:id="@+id/progressBar2"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginTop="8dp"
                    app:layout_constraintBottom_toTopOf="@+id/textSyncingData"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_chainStyle="packed" />

                <TextView
                    android:id="@+id/textSyncingData"
                    style="@style/Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/gilroy_medium"
                    android:text="@string/text_refreshing"
                    android:textColor="@android:color/white"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/progressBar2" />

            </androidx.constraintlayout.widget.ConstraintLayout>


        </com.noisefit.ui.custom.swipeHeader.srl.extra.header.ClassicHeader>

        <RelativeLayout
            android:id="@+id/container"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/scrollViewMain"
                android:layout_width="match_parent"
                android:layout_height="match_parent">


                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/side_margin">

                    <View
                        android:id="@+id/view1"
                        style="@style/ModalStyleNew"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginStart="@dimen/side_margin"
                        android:layout_marginTop="@dimen/side_margin"
                        android:layout_marginEnd="@dimen/side_margin"
                        android:visibility="gone"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:visibility="visible" />

                    <ImageView
                        android:id="@+id/ivCalender"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/side_margin"
                        android:src="@drawable/ic_calender"
                        android:visibility="gone"
                        app:layout_constraintBottom_toBottomOf="@id/view1"
                        app:layout_constraintStart_toStartOf="@+id/view1"
                        app:layout_constraintTop_toTopOf="@id/view1"
                        tools:ignore="ContentDescription"
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/tvToday"
                        style="@style/Small"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/side_margin"
                        android:text="@string/text_today"
                        android:visibility="gone"
                        app:layout_constraintBottom_toBottomOf="@id/view1"
                        app:layout_constraintStart_toEndOf="@id/ivCalender"
                        app:layout_constraintTop_toTopOf="@id/view1"
                        tools:ignore="TextContrastCheck"
                        tools:visibility="visible" />

                <ImageView
                    android:id="@+id/ivNext"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    tools:visibility="visible"
                    android:layout_marginEnd="@dimen/side_margin"
                    android:src="@drawable/ic_arrow_right_cal"
                    app:layout_constraintBottom_toBottomOf="@id/view1"
                    app:layout_constraintEnd_toEndOf="@id/view1"
                    app:layout_constraintTop_toTopOf="@id/view1" />

                    <View
                        android:id="@+id/view2"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_marginStart="@dimen/side_margin_neg"
                        android:layout_marginTop="@dimen/side_margin_neg"
                        android:layout_marginEnd="@dimen/side_margin_neg"
                        android:layout_marginBottom="@dimen/side_margin_neg"
                        android:background="@drawable/back_highlight_purple_stroke"
                        android:padding="12dp"
                        android:visibility="gone"
                        app:layout_constraintBottom_toBottomOf="@+id/tvDoingBetter"
                        app:layout_constraintEnd_toEndOf="@+id/tvDoingBetter"
                        app:layout_constraintStart_toStartOf="@+id/tvDoingBetter"
                        app:layout_constraintTop_toTopOf="@+id/tvDoingBetter"
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/tvDoingBetter"
                        style="@style/Body"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="32dp"
                        android:layout_marginTop="46dp"
                        android:layout_marginEnd="32dp"
                        android:textColor="@color/white_80"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/view1"
                        tools:text="You are doing better then 60% of your friends.Keep it up" />


                    <include
                        android:id="@+id/include32"
                        layout="@layout/layout_divider"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="30dp"
                        android:visibility="gone"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/view2" />


                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvFriendList"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginTop="24dp"
                        android:clipToPadding="false"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        app:layout_behavior="@string/appbar_scrolling_view_behavior"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/include32"
                        tools:itemCount="10" />


                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.core.widget.NestedScrollView>

            <include
                android:id="@+id/progressBar"
                layout="@layout/default_loader"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />


            <include
                android:id="@+id/lytEmptyList"
                layout="@layout/layout_empty_friend_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                tools:visibility="visible" />
        </RelativeLayout>

    </me.dkzwm.widget.srl.SmoothRefreshLayout>


</layout>