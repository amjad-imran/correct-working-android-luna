<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".ui.onboarding.auth.JoinNoisefitFragment">

        <TextView
            android:id="@+id/textView16"
            style="@style/H2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/side_margin"
            android:layout_marginEnd="@dimen/side_margin"
            android:text="@string/text_join_noisefit"
            android:layout_marginTop="@dimen/dimen_96dp"
            app:layout_constraintBottom_toTopOf="@+id/textView15"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.0"
            app:layout_constraintVertical_chainStyle="packed" />

        <TextView
            android:id="@+id/textView15"
            style="@style/H6"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:lineSpacingExtra="6sp"
            android:text="@string/text_join_message"
            app:layout_constraintBottom_toTopOf="@+id/vGoogle"
            app:layout_constraintEnd_toEndOf="@+id/textView16"
            app:layout_constraintStart_toStartOf="@+id/textView16"
            app:layout_constraintTop_toBottomOf="@+id/textView16" />

        <View
            android:id="@+id/vGoogle"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginTop="40dp"
            android:contentDescription="Login via Google"
            android:background="@drawable/back_modal_new"
            app:layout_constraintBottom_toTopOf="@+id/vFacebook"
            app:layout_constraintEnd_toEndOf="@+id/textView16"
            app:layout_constraintStart_toStartOf="@+id/textView16"
            app:layout_constraintTop_toBottomOf="@+id/textView15" />

        <ImageView
            android:id="@+id/imageView9"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="@dimen/side_margin"
            android:src="@drawable/ic_google"
            app:layout_constraintBottom_toBottomOf="@+id/vGoogle"
            app:layout_constraintStart_toStartOf="@+id/vGoogle"
            app:layout_constraintTop_toTopOf="@+id/vGoogle" />

        <TextView
            style="@style/H4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/text_google"
            app:layout_constraintBottom_toBottomOf="@+id/vGoogle"
            app:layout_constraintStart_toEndOf="@+id/imageView9"
            app:layout_constraintTop_toTopOf="@+id/vGoogle" />

        <View
            android:id="@+id/vFacebook"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            android:background="@drawable/back_modal_new"
            app:layout_constraintBottom_toTopOf="@+id/vEmail"
            app:layout_constraintEnd_toEndOf="@+id/textView16"
            app:layout_constraintStart_toStartOf="@+id/textView16"
            app:layout_constraintTop_toBottomOf="@+id/vGoogle" />

        <com.facebook.login.widget.LoginButton
            android:id="@+id/facebookHideBtn"
            style="@style/RippleEffect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:padding="18dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@+id/vFacebook"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/vFacebook" />

        <ImageView
            android:id="@+id/imageView11"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_fb"
            android:visibility="gone"
            android:layout_marginStart="@dimen/side_margin"
            app:layout_constraintBottom_toBottomOf="@+id/vFacebook"
            app:layout_constraintStart_toStartOf="@+id/vFacebook"
            app:layout_constraintTop_toTopOf="@+id/vFacebook" />

        <TextView
            style="@style/H4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/text_facebook"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@+id/vFacebook"
            app:layout_constraintStart_toEndOf="@+id/imageView11"
            app:layout_constraintTop_toTopOf="@+id/vFacebook" />

        <View
            android:id="@+id/vEmail"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginTop="16dp"
            android:contentDescription="Login via Email"
            android:background="@drawable/back_modal_new"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/textView16"
            app:layout_constraintStart_toStartOf="@+id/textView16"
            app:layout_constraintTop_toBottomOf="@+id/vFacebook" />

        <ImageView
            android:id="@+id/imageView10"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="@dimen/side_margin"
            android:src="@drawable/ic_email"
            app:layout_constraintBottom_toBottomOf="@+id/vEmail"
            app:layout_constraintStart_toStartOf="@+id/vEmail"
            app:layout_constraintTop_toTopOf="@+id/vEmail" />

        <TextView
            style="@style/H4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/text_email"
            app:layout_constraintBottom_toBottomOf="@+id/vEmail"
            app:layout_constraintStart_toEndOf="@+id/imageView10"
            app:layout_constraintTop_toTopOf="@+id/vEmail" />

        <include
            android:id="@+id/progressBar"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            layout="@layout/default_loader"/>


    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>