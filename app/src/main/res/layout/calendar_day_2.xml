<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/dayLayoutMain"
    android:layout_width="48dp"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/tvWeekDay"
        style="@style/Small"
        android:layout_width="32dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        app:layout_constraintBottom_toTopOf="@+id/dayBack"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="S" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/dayBack"
        android:background="@drawable/back_modal_new_round"
        android:layout_width="32dp"
        android:layout_height="42dp"
        android:layout_marginTop="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvWeekDay"
        app:shapeAppearance="@style/ShapeAppearanceOverlay.App.CornerSize16dp" />

    <TextView
        android:id="@+id/tvDay"
        style="@style/Small"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@android:color/white"
        app:layout_constraintBottom_toTopOf="@+id/tvMonth"
        app:layout_constraintEnd_toEndOf="@+id/dayBack"
        app:layout_constraintStart_toStartOf="@+id/dayBack"
        app:layout_constraintTop_toTopOf="@+id/dayBack"
        app:layout_constraintVertical_chainStyle="packed"
        tools:text="22" />

    <TextView
        android:id="@+id/tvMonth"
        style="@style/Tinny"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_marginTop="4dp"
        android:textColor="@android:color/white"
        app:layout_constraintBottom_toBottomOf="@+id/dayBack"
        app:layout_constraintEnd_toEndOf="@+id/dayBack"
        app:layout_constraintStart_toStartOf="@+id/dayBack"
        app:layout_constraintTop_toBottomOf="@+id/tvDay"
        tools:text="Oct" />
</androidx.constraintlayout.widget.ConstraintLayout>
