<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:layout_marginStart="@dimen/side_margin"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="@dimen/side_margin">


        <View
            android:id="@+id/view1"
            style="@style/ModalStyleNew"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <ImageView
            android:id="@+id/ivCollectMoney"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="@dimen/side_margin"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:src="@drawable/ic_collect_money" />

        <TextView
            android:id="@+id/tvTitle"
            style="@style/H6"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/white_64"
            app:layout_constraintEnd_toStartOf="@+id/relativeLayout5"
            app:layout_constraintStart_toEndOf="@id/ivCollectMoney"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Smartwatch Paired" />

        <TextView
            android:id="@+id/tvEarnedCoin"
            style="@style/H5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            android:visibility="gone"
            tools:visibility="visible"
            app:layout_constraintStart_toEndOf="@id/ivCollectMoney"
            app:layout_constraintTop_toBottomOf="@id/tvTitle"
            tools:text="20" />

        <ImageView
            android:id="@+id/ivCoin"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginStart="4dp"
            android:src="@drawable/ic_bitcoin_completed"
            android:visibility="gone"
            tools:visibility="visible"
            app:layout_constraintBottom_toBottomOf="@id/tvEarnedCoin"
            app:layout_constraintStart_toEndOf="@id/tvEarnedCoin"
            app:layout_constraintTop_toTopOf="@id/tvEarnedCoin"
            tools:ignore="ContentDescription" />

        <RelativeLayout
            android:id="@+id/relativeLayout5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/view1"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tvCollect"
                style="@style/PrimaryButtonStyleHighlight2"
                android:layout_width="100dp"
                android:layout_height="32dp"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/side_margin"
                android:fontFamily="@font/google_sans_flex_medium"
                android:gravity="center"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="@string/text_collect"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:visibility="gone"
                tools:visibility="visible" />

            <ImageView
                android:id="@+id/ivNext"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_centerVertical="true"
                android:padding="16dp"
                android:src="@drawable/ic_arrow_right_duotone"
                android:visibility="gone"
                tools:ignore="ContentDescription"
                tools:visibility="visible" />
        </RelativeLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
