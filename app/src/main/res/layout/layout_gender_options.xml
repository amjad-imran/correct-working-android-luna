<?xml version="1.0" encoding="utf-8"?>
<layout>

    <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_16dp"
        android:layout_marginBottom="@dimen/dimen_16dp"
        android:background="@android:color/transparent"
        android:paddingStart="@dimen/dimen_24dp"
        android:paddingEnd="@dimen/dimen_24dp">

        <TextView
            android:id="@+id/tvMan"
            style="@style/H3"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:text="@string/man"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <RadioButton
            android:id="@+id/ivMan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="false"
            app:layout_constraintBottom_toBottomOf="@+id/tvMan"
            app:layout_constraintEnd_toEndOf="@+id/tvMan"
            app:layout_constraintTop_toTopOf="parent" />

        <include
            android:id="@+id/include6"
            layout="@layout/layout_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            app:layout_constraintTop_toBottomOf="@+id/tvMan"
            tools:layout_editor_absoluteX="0dp" />

        <TextView
            android:id="@+id/tvWoman"
            style="@style/H3"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:text="@string/text_woman"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/include6" />

        <RadioButton
            android:id="@+id/ivWoman"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="false"
            app:layout_constraintBottom_toBottomOf="@+id/tvWoman"
            app:layout_constraintEnd_toEndOf="@+id/tvWoman"
            app:layout_constraintTop_toBottomOf="@+id/include6" />

        <include
            android:id="@+id/include7"
            layout="@layout/layout_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            app:layout_constraintTop_toBottomOf="@+id/tvWoman"
            tools:layout_editor_absoluteX="0dp" />

        <TextView
            android:id="@+id/tvOther"
            style="@style/H3"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:text="@string/text_non_binary"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/include7" />

        <RadioButton
            android:id="@+id/ivOther"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="false"
            app:layout_constraintBottom_toBottomOf="@+id/tvOther"
            app:layout_constraintEnd_toEndOf="@+id/tvOther"
            app:layout_constraintTop_toBottomOf="@+id/include7" />

        <include
            android:id="@+id/include8"
            layout="@layout/layout_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            app:layout_constraintTop_toBottomOf="@+id/ivOther"
            tools:layout_editor_absoluteX="0dp" />

        <TextView
            android:id="@+id/tvPreferNoToSay"
            style="@style/H3"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:text="@string/prefer_not_to_say"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/include8" />

        <RadioButton
            android:id="@+id/ivPreferNoToSay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="false"
            app:layout_constraintBottom_toBottomOf="@+id/tvPreferNoToSay"
            app:layout_constraintEnd_toEndOf="@+id/tvPreferNoToSay"
            app:layout_constraintTop_toBottomOf="@+id/include8" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>