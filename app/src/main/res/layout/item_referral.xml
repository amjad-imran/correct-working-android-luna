<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="@drawable/back_modal_dialog_referral">

    <TextView
        android:id="@+id/tvName"
        style="@style/S16"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginTop="22dp"
        android:layout_marginEnd="16dp"
        android:textColor="#f4eded"
        app:layout_constraintEnd_toStartOf="@+id/tvDate"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Nikhil Mishra" />

    <TextView
        android:id="@+id/tvDate"
        style="@style/S12"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="26dp"
        android:layout_marginEnd="18dp"
        android:fontFamily="@font/google_sans_flex_medium"
        android:textColor="#ccf4eded"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="12,Sep,2024" />

    <ImageView
        android:id="@+id/ivPurchased"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="18dp"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvName"
        tools:src="@drawable/ic_ref_status_filled" />

    <TextView
        style="@style/S12"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:fontFamily="@font/google_sans_flex_medium"
        android:textColor="#ccf4eded"
        app:layout_constraintBottom_toBottomOf="@+id/ivPurchased"
        app:layout_constraintStart_toEndOf="@+id/ivPurchased"
        app:layout_constraintTop_toTopOf="@+id/ivPurchased"
        android:text="@string/text_ring_purchased" />

    <ImageView
        android:id="@+id/imageView53"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_ref_status_connect"
        app:layout_constraintEnd_toEndOf="@+id/ivPurchased"
        app:layout_constraintStart_toStartOf="@+id/ivPurchased"
        app:layout_constraintTop_toBottomOf="@+id/ivPurchased" />


    <ImageView
        android:id="@+id/ivDelivered"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginBottom="22dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/ivPurchased"
        app:layout_constraintStart_toStartOf="@+id/ivPurchased"
        app:layout_constraintTop_toBottomOf="@+id/imageView53"
        tools:src="@drawable/ic_ref_status_ring" />

    <TextView
        android:id="@+id/textView136"
        style="@style/S12"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:fontFamily="@font/google_sans_flex_medium"
        android:textColor="#ccf4eded"
        app:layout_constraintBottom_toBottomOf="@+id/ivDelivered"
        app:layout_constraintStart_toEndOf="@+id/ivDelivered"
        app:layout_constraintTop_toTopOf="@+id/ivDelivered"
        android:text="@string/text_ring_delivered" />

    <TextView
        style="@style/S12"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        android:fontFamily="@font/google_sans_flex_medium"
        android:text="@string/text_status"
        android:textColor="#ccf4eded"
        app:layout_constraintBottom_toBottomOf="@+id/tvStatus"
        app:layout_constraintEnd_toStartOf="@+id/tvStatus"
        app:layout_constraintTop_toTopOf="@+id/tvStatus" />

    <TextView
        android:id="@+id/tvStatus"
        style="@style/S12"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="18dp"
        android:fontFamily="@font/google_sans_flex_medium"
        android:textColor="#ccf4eded"
        app:layout_constraintBottom_toBottomOf="@+id/textView136"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/textView136"
        tools:text="Pending" />


</androidx.constraintlayout.widget.ConstraintLayout>