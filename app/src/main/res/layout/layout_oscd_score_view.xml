<layout xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        style="@style/ModalStyleReadiness"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tvTitle"
            style="@style/H5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/side_margin"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="@dimen/side_margin"
            tools:text="@string/text_score_overview"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvTrendProg"
            style="@style/H6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:paddingEnd="@dimen/_4sdp"
            android:textColor="@color/steps_arc"
            android:textSize="12sp"
            android:visibility="invisible"
            app:drawableStartCompat="@drawable/ic_trend_up"
            app:layout_constraintStart_toStartOf="@id/tvTitle"
            app:layout_constraintTop_toBottomOf="@id/tvTitle"
            tools:text="5%"
            tools:ignore="RtlSymmetry" />

        <TextView
            android:id="@+id/tvScoreMsg"
            style="@style/H6"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="@dimen/side_margin"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/white_48"
            android:textSize="12sp"
            app:layout_constraintStart_toEndOf="@+id/tvTrendProg"
            app:layout_constraintTop_toBottomOf="@id/tvTitle"
            tools:text="Today you burnt 160 kcal more than yesterday" />

        <include
            android:id="@+id/lytToday"
            layout="@layout/layout_oscd_score_view_subdata"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvScoreMsg" />

        <include
            android:id="@+id/lytYesterday"
            layout="@layout/layout_oscd_score_view_subdata"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/lytToday" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>