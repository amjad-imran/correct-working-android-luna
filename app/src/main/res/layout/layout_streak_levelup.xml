<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tvDailyTitle"
            style="@style/Small"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/text_level_up_in"
            android:textColor="@color/white_64"
            app:layout_constraintEnd_toStartOf="@id/tvMultipleTitle"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvNextLevelUpIn"
            style="@style/H3"
            android:layout_width="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="@id/tvDailyTitle"
            app:layout_constraintTop_toBottomOf="@id/tvDailyTitle"
            tools:text="5 Days" />

        <TextView
            android:id="@+id/tvMultipleTitle"
            style="@style/Small"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/text_longest_streak"
            android:textColor="@color/white_64"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/tvDailyTitle"
            app:layout_constraintTop_toTopOf="parent" />


        <TextView
            android:id="@+id/tvLongestStreak"
            style="@style/H3"
            android:layout_marginTop="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="@id/tvMultipleTitle"
            app:layout_constraintTop_toBottomOf="@id/tvMultipleTitle"
            tools:text="12 days" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
