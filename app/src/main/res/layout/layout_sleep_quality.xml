<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tvDate"
            style="@style/H4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/side_margin"
            android:layout_marginTop="16dp"
            android:text="Sleep Quality Score"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/bInfo"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="24dp"
            android:gravity="center"
            android:padding="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <com.noisefit.ui.custom.RestingHrBar
            android:id="@+id/pbSleep2"
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:visibility="gone"
            android:layout_marginStart="@dimen/side_margin"
            android:layout_marginEnd="@dimen/side_margin"
            android:layout_marginTop="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvDate" />

        <View
            android:id="@+id/backBar"
            style="@style/ModalStyleNew"
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvDate" />


        <ImageView
            android:id="@+id/pbSleep"
            android:layout_width="wrap_content"
            android:layout_height="4dp"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/backBar"
            app:layout_constraintStart_toStartOf="@+id/backBar"
            app:layout_constraintTop_toTopOf="@+id/backBar" />

        <TextView
            android:id="@+id/tvSleepScore"
            style="@style/H2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            app:layout_constraintTop_toTopOf="@+id/include6"
            app:layout_constraintEnd_toEndOf="@+id/textView9"
            app:layout_constraintStart_toStartOf="@+id/textView9"
            tools:text="65" />

        <TextView
            android:id="@+id/textView9"
            style="@style/Small"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/side_margin"
            android:layout_marginEnd="6dp"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@+id/tvSleepScore"
            app:layout_constraintEnd_toStartOf="@+id/include6"
            app:layout_constraintStart_toStartOf="parent"
            tools:text="Moderate" />

        <include
            android:id="@+id/include6"
            layout="@layout/layout_divider"
            android:layout_width="3dp"
            android:layout_height="0dp"
            android:layout_marginStart="100dp"
            android:layout_marginTop="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/textView9"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/backBar" />

        <TextView
            android:id="@+id/tvSleepScoreMessage"
            style="@style/Small"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:lineSpacingExtra="6sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/include6"
            app:layout_constraintTop_toBottomOf="@+id/backBar"
            tools:text="@string/text_sleep_message_fair" />


    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
