<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivBgImg"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:adjustViewBounds="true"
        android:scaleType="fitXY"
        app:layout_constraintDimensionRatio="1:1"
        android:src="@drawable/image_readiness_minimal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearance="@style/ShapeAppearanceOverlay.App.CornerSize10dp" />

    <TextView
        android:id="@+id/tvPersonaName"
        style="@style/S20"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:textFontWeight="600"
        android:fontFamily="@font/google_sans_flex_variable"
        app:layout_constraintStart_toStartOf="@+id/ivBgImg"
        app:layout_constraintTop_toTopOf="@+id/ivBgImg"
        tools:text="Bloom" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipsPrograms"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:layout_marginHorizontal="20dp"
        app:chipSpacingHorizontal="12dp"
        app:chipSpacingVertical="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/ivBgImg"
        app:layout_constraintEnd_toEndOf="@+id/ivBgImg"
        app:layout_constraintStart_toStartOf="@+id/ivBgImg" />

</androidx.constraintlayout.widget.ConstraintLayout>