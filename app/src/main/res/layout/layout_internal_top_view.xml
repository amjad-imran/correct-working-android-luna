<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/tvDate"
        style="@style/S14"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/white_48"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Monday  30 May, 2024" />

    <LinearLayout
        android:id="@+id/linearLayout8"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvDate">

        <TextView
            android:id="@+id/tvHour"
            style="@style/S28"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="3" />

        <TextView
            android:id="@+id/textHour"
            style="@style/S16"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/text_hr"
            android:textColor="@color/white_48" />

        <TextView
            android:id="@+id/tvMin"
            style="@style/S28"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="20" />

        <TextView
            android:id="@+id/textMin"
            style="@style/S16"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/text_min"
            android:textColor="@color/white_48" />
    </LinearLayout>


    <TextView
        android:id="@+id/tvChange"
        style="@style/S10"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#29cc74"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout8"
        tools:text="5% from yesterday" />

    <TextView
        android:id="@+id/tvNudge"
        style="@style/S14"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:textColor="@color/white_80"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvChange"
        tools:text="Your resting HR seems to be higher than previous day. Allow yourself sufficient time for recovery by taking it slow." />


</androidx.constraintlayout.widget.ConstraintLayout>