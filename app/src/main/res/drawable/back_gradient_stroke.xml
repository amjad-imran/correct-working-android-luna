<?xml version="1.0" encoding="UTF-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android" >
    <item>
        <shape android:shape="rectangle" >
            <gradient
                android:startColor="#cce9c259"
                android:centerColor="#ccdb8300"
                android:endColor="#ccf06749"
                android:type="linear" />
            <size android:width="100dp"
                android:height="50dp"/>
            <corners
                android:radius="10dp"/>
        </shape>
    </item>

    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle" >
            <solid android:color="#000" />
            <corners
                android:radius="10dp"/>
        </shape>
    </item>

</layer-list>