<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape
            android:shape="rectangle"
            android:thickness="1dp"
            android:useLevel="false">
            <size
                android:width="100dp"
                android:height="100dp" />
            <corners
                android:bottomLeftRadius="4dp"
                android:bottomRightRadius="4dp"
                android:topLeftRadius="20dp"
                android:topRightRadius="20dp" />
            <gradient
                android:centerColor="#cc7865e8"
                android:endColor="#cc668ced"
                android:startColor="#ccdd8ccb"
                android:type="linear" />
        </shape>
    </item>
    <item
        android:bottom="1dp"
        android:end="1dp"
        android:start="1dp"
        android:top="1dp">
        <shape>
            <corners
                android:bottomLeftRadius="4dp"
                android:bottomRightRadius="4dp"
                android:topLeftRadius="20dp"
                android:topRightRadius="20dp" />
            <gradient
                android:centerColor="#17143e"
                android:endColor="#1f2c5b"
                android:startColor="#40275c" />
        </shape>
    </item>
</layer-list>