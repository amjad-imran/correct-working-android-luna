<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#0CFFFFFF"
                android:startColor="#1AFFFFFF" />
            <corners android:radius="16dp" />
        </shape>
    </item>

    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/white_4" />
            <corners android:radius="@dimen/dimen_16dp" />
        </shape>
    </item>

</layer-list>
