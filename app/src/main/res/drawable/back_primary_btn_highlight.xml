<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape
            android:shape="rectangle"
            android:thickness="1dp"
            android:useLevel="false">
            <size
                android:width="100dp"
                android:height="100dp" />
            <corners android:radius="24dp" />
            <gradient
                android:startColor="#ccdd8ccb"
                android:centerColor="#cc7865e8"
                android:endColor="#cc668ced"
                android:type="linear" />
        </shape>
    </item>
    <item
        android:bottom="1dp"
        android:end="1dp"
        android:start="1dp"
        android:top="1dp">
        <shape>
            <solid android:color="@color/black" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item
        android:bottom="1dp"
        android:end="1dp"
        android:start="1dp"
        android:top="1dp">
        <shape>
            <gradient
                android:startColor="#51aa5bff"
                android:centerColor="#51491a95"
                android:endColor="#51406aff" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</layer-list>