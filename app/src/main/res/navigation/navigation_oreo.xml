<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/navigation_oreo"
    app:startDestination="@id/navigation_oreo_home">


    <fragment
        android:id="@+id/navigation_oreo_home"
        android:name="com.oreo.ui.home.summary.OSummaryFragment"
        android:label="fragment_summary_o">
        <action
            android:id="@+id/action_home_to_alertTextBottomSheet"
            app:destination="@id/alertTextBottomSheet" />
    </fragment>
    <fragment
        android:id="@+id/navigation_oreo_readiness"
        android:name="com.oreo.ui.readiness.OreoReadinessFragment"
        android:label="ReadinessFragment">
        <action
