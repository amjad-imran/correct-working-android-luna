        android:label="BottomSheetDataMetrics" >
        <argument
            android:name="infoData"
            app:argType="string"/>
    </dialog>
    <fragment
        android:id="@+id/ringCareFragment"
        android:name="com.oreo.ui.info.RingCareFragment"
