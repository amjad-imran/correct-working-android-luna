    {
      "type": "text",
      "text": "If you are unable to pair with your smartphone, then make sure your smartphone's location is turned on.\n",
      "image": null,
      "bold": false
    },
    {
      "type": "text",
      "text": "Pairing\n",
      "image": null,
      "bold": true
    },
    {
      "type": "text",
      "text": "i. Clear app's cache. \n\nGo to Settings > Apps & notifications >See all apps> App info > NoiseFit app > Storage & Cache > Clear cache.\n",
      "image": null,
      "bold": false
    },
    {
      "type": "image",
      "text": null,
      "image": "https://images.gonoise.com/user-manual-guide/production/App+Update+SS/ClearCache/image1.png",
      "bold": false
    },
    {
      "type": "image",
      "text": null,
      "image": "https://images.gonoise.com/user-manual-guide/production/App+Update+SS/ClearCache/image2.png",
      "bold": false
    },
    {
      "type": "image",
      "text": null,
      "image": "https://images.gonoise.com/user-manual-guide/production/App+Update+SS/ClearCache/image3.png",
      "bold": false
    },
    {
      "type": "image",
      "text": null,
      "image": "https://images.gonoise.com/user-manual-guide/production/App+Update+SS/ClearCache/image4.png",
      "bold": false
    },
    {
      "type": "image",
      "text": null,
      "image": "https://images.gonoise.com/user-manual-guide/production/App+Update+SS/ClearCache/image5.png",
      "bold": false
    },
    {
      "type": "text",
      "text": "ii. Turn ‘off’ and then ‘on’ your smartphone’s Bluetooth.\n",
      "image": null,
      "bold": false
    },
    {
      "type": "text",
      "text": "iii. Reset your smartwatch.\n",
      "image": null,
      "bold": false
    },
    {
      "type": "text",
      "text": "iv. Now follow the pairing steps.\n",
      "image": null,
      "bold": false
    },
    {
      "type": "text",
      "text": "Connectivity\n",
      "image": null,
      "bold": true
    },
    {
      "type": "text",
      "text": "If you are facing connectivity issues, getting “Trying to Connect“ on my device screen.\n",
      "image": null,
      "bold": false
    },

    {
      "type": "text",
      "text": "i. Force Stop the NoiseFit app. \n\nGo to settings > Apps & notifications > App info > NoiseFit app > Force Stop.\n",
      "image": null,
      "bold": false
    },
    {
      "type": "image",
      "text": null,
      "image": "https://images.gonoise.com/user-manual-guide/production/App+Update+SS/ForceStop/image1.png",
      "bold": false
    },
    {
      "type": "image",
      "text": null,
      "image": "https://images.gonoise.com/user-manual-guide/production/App+Update+SS/ForceStop/image2.png",
      "bold": false
    },
    {
      "type": "image",
      "text": null,
      "image": "https://images.gonoise.com/user-manual-guide/production/App+Update+SS/ForceStop/image3.png",
      "bold": false
    },
    {
      "type": "image",
      "text": null,
      "image": "https://images.gonoise.com/user-manual-guide/production/App+Update+SS/ForceStop/image4.png",
      "bold": false
    },
    {
      "type": "text",
      "text": "ii. Turn ‘off’ and then ‘on’ your smartphone’s Bluetooth.\n",
      "image": null,
      "bold": false
    },
    {
      "type": "text",
      "text": "iii. Make sure to give location permission to NoiseFit app. \n\n",
      "image": null,
      "bold": false
    }
  ]
