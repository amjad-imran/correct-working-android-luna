    </style>

    <style name="Body" parent="BaseTextRegular">
        <item name="android:lineSpacingExtra">6sp</item>
        <item name="android:textColor">@color/md_theme_dark_text_color_h6</item>
        <item name="android:textSize">@dimen/text_14sp</item>
    </style>

    <style name="Small" parent="BaseTextRegular">
        <item name="android:lineSpacingExtra">8sp</item>
