<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.NoiseFit" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:colorPrimary">@color/md_theme_light_primary</item>
        <item name="android:colorPrimaryDark">@color/md_theme_light_primary</item>
        <item name="android:textColorPrimary">@color/md_theme_light_text_color</item>
        <item name="colorAccent">@color/md_theme_light_accent</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/md_theme_light_background
        </item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowContentTransitions">true</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
        <!-- Customize your theme here. -->
        <!--<item name="android:background">@color/md_theme_light_background</item>-->

    </style>

    <style name="ToolbarTextTheme" parent="@android:style/TextAppearance.Medium">
        <item name="android:textColor">@color/md_theme_light_text_color_h3</item>
        <item name="android:textSize">@dimen/text_16sp</item>
        <item name="android:fontFamily">@font/gilroy_medium</item>

    </style>


    <style name="SplashTheme" parent="Theme.NoiseFit">
        <!--<item name="android:windowBackground">@drawable/splash_background</item>-->
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <style name="TransparentBgTheme" parent="Theme.NoiseFit">
        <!--<item name="android:windowBackground">@drawable/back_onboard_gradient</item>-->
        <item name="android:windowBackground">@android:color/black</item>
    </style>




    <style name="ModalStyle10">
        <item name="android:background">@drawable/back_modal_new</item>
    </style>


    <style name="Small" parent="BaseText">
        <item name="android:lineSpacingExtra">8sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/text_12sp</item>
    </style>


    <style name="Tinny" parent="BaseTextRegular">
        <item name="android:textColor">@color/text_color_h8</item>
        <item name="android:textSize">@dimen/text_10sp</item>
    </style>

    <style name="hGone" parent="BaseText">
        <item name="android:textColor">@color/text_color_h8</item>
        <item name="android:textSize">1sp</item>
    </style>




    <style name="WeekButtonStyle">
        <item name="android:layout_width">36dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:gravity">center</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@android:color/white</item>
    </style>


    <style name="MaterialAlertDialog_rounded" parent="@style/ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/DialogCorners</item>
    </style>

    <style name="DialogCorners">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/dimen_28dp</item>
    </style>

<!--    <style name="ModalStyle">-->
<!--        <item name="android:background">@drawable/back_modal</item>-->
<!--    </style>-->

    <style name="EditTextStyle">
        <item name="android:layout_height">60dp</item>
        <item name="android:background">@drawable/back_modal_edittext</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">@dimen/side_margin</item>
        <item name="android:paddingEnd">@dimen/side_margin</item>
        <item name="android:textColor">@color/edit_text_color</item>
        <item name="android:textColorHint">@color/edit_hint_color</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/gilroy_medium</item>
    </style>
    <style name="EditTextStyleSearch">
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:background">@drawable/back_modal_new</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">@dimen/side_margin</item>
        <item name="android:paddingEnd">@dimen/side_margin</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textColorHint">@color/white</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/gilroy_regular</item>
    </style>



    <style name="ModalStyleNew">
        <item name="android:background">@drawable/back_modal_new</item>
    </style>

    <style name="ButtonAppearance">
        <item name="cornerFamilyTopLeft">rounded</item>
        <item name="cornerFamilyBottomLeft">rounded</item>
        <item name="cornerFamilyTopRight">rounded</item>
        <item name="cornerFamilyBottomRight">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>



    <style name="PrimaryButtonStyle" parent="ThemeOverlay.Material3.Button.TextButton">
        <item name="shapeAppearance">@style/ButtonAppearance</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:fontFamily">@font/gilroy_medium</item>
        <item name="android:background">@drawable/btn_primary_bg_selector</item>
        <item name="android:textColor">@drawable/btn_primary_color_selector</item>
    </style>
    <style name="PrimaryButtonStyleRegular" parent="ThemeOverlay.Material3.Button.TextButton">
        <item name="shapeAppearance">@style/ButtonAppearance</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:fontFamily">@font/gilroy_regular</item>
        <item name="android:background">@drawable/btn_primary_bg_selector</item>
        <item name="android:textColor">@drawable/btn_primary_color_selector</item>
    </style>

    <style name="PrimaryButtonStyleHighlight1" parent="PrimaryButtonStyle">
        <item name="android:layout_height">40dp</item>
        <item name="android:background">@drawable/btn_primary_highlight_selector</item>
        <item name="android:textColor">@drawable/btn_primary_color_selector</item>
    </style>

    <style name="PrimaryButtonStyleHighlight2" parent="PrimaryButtonStyle">
        <item name="android:layout_height">40dp</item>
        <item name="android:background">@drawable/btn_primary_highlight_selector_2</item>
        <item name="android:textColor">@android:color/white</item>
    </style>

    <style name="SecondaryButtonStyle" parent="ThemeOverlay.Material3.Button.TextButton">
        <item name="shapeAppearance">@style/ButtonAppearance</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:fontFamily">@font/gilroy_medium</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:background">@drawable/btn_secondary_bg_selector</item>
        <item name="android:textColor">@drawable/btn_secondary_color_selector</item>
    </style>

    <style name="TextButtonStyle" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/text_14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/md_theme_light_text_button</item>
    </style>



    <style name="ToolbarBackButton" parent="Widget.AppCompat.ImageButton">
        <item name="android:src">@drawable/ic_back_arrow_new</item>
        <item name="android:layout_width">@dimen/dimen_32dp</item>
        <item name="android:layout_height">@dimen/dimen_32dp</item>
        <item name="android:background">@drawable/back_modal_new_round</item>
        <!--        <item name="android:background">@android:color/transparent</item>-->

        <item name="android:clickable">true</item>
        <item name="android:contentDescription">Back Button</item>
        <!-- Ripple for API 21 of android, and regular selector on older -->
        <item name="android:focusable">true</item>
        <!--<item name="android:foreground">?android:attr/selectableItemBackground</item>-->
    </style>

    <style name="MyDatePickerStyle" parent="@android:style/Widget.Material.DatePicker">
        <item name="android:colorControlActivated">#ffea00</item>
        <item name="android:datePickerMode">spinner</item>
        <item name="android:calendarViewShown">false</item>
    </style>

    <style name="MyTimePickerStyle" parent="@android:style/Widget.Material.TimePicker">
        <item name="android:colorControlActivated">#ffea00</item>
        <item name="android:timePickerMode">spinner</item>
        <item name="android:calendarViewShown">false</item>
    </style>

    <style name="MyDatePickerSpinnerStyle" parent="@android:style/Widget.Material.DatePicker">
        <item name="android:datePickerMode">spinner</item>
        <item name="android:calendarViewShown">false</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="colorControlNormal">@color/divider_color</item>
        <item name="android:textColorPrimary">@color/md_theme_light_text_color</item>
    </style>

    <style name="PasswordInputLayoutStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="errorEnabled">true</item>
        <item name="hintEnabled">true</item>
        <item name="passwordToggleEnabled">true</item>
        <item name="errorIconDrawable">@null</item>
    </style>


    <style name="textSelectorValueUpdate" parent="BaseText">
        <item name="android:textColor">@color/md_theme_dark_text_color_h3</item>
        <item name="colorControlNormal">@color/divider_color_update</item>
        <item name="android:textColorPrimary">@color/md_theme_light_text_color_update</item>
        <item name="android:textSize">@dimen/text_20sp</item>
    </style>

    <style name="ShapeAppearanceOverlay.App.CornerSize50Percent" parent="">
        <item name="cornerSize">50%</item>
    </style>

    <style name="ShapeAppearanceOverlay.App.CornerSize20dp" parent="">
        <item name="cornerSize">20dp</item>
    </style>

    <style name="ShapeAppearanceOverlay.App.CornerSize10dp" parent="">
        <item name="cornerSize">10dp</item>
    </style>

    <style name="ShapeAppearanceOverlay.App.CornerSize4dp" parent="">
        <item name="cornerSize">4dp</item>
    </style>

    <style name="ShapeAppearanceOverlay.App.CornerSize16dp" parent="">
        <item name="cornerSize">16dp</item>
    </style>

    <style name="ShapeAppearanceOverlay.App.CornerSize30dp" parent="">
        <item name="cornerSize">30dp</item>
    </style>

    <style name="CustomChipStyle" parent="Widget.MaterialComponents.Chip.Choice">
        <!-- Chip background color selector -->
        <item name="chipBackgroundColor">@color/chip_background_color_state</item>
        <item name="fontFamily">@font/gilroy_regular</item>
        <item name="textSize">@dimen/text_14sp</item>
        <item name="android:padding">@dimen/dimen_4dp</item>
        <!-- Border color -->
        <item name="chipSurfaceColor">@android:color/transparent</item>
        <item name="chipStrokeColor">@color/chip_stroke_color_state</item>
        <item name="chipStrokeWidth">1dp</item>

        <!-- Chip text color selector -->
        <item name="android:textColor">@color/chip_text_color_state</item>
    </style>

    <style name="CustomChipStyleRegular" parent="Widget.MaterialComponents.Chip.Choice">
        <!-- Chip background color selector -->
        <item name="chipBackgroundColor">@color/chip_background_color_state</item>
        <item name="fontFamily">@font/gilroy_regular</item>
        <item name="textSize">@dimen/text_12sp</item>
        <item name="android:padding">@dimen/dimen_4dp</item>
        <!-- Border color -->
        <item name="chipSurfaceColor">@android:color/transparent</item>
        <item name="chipStrokeColor">@color/chip_stroke_color_state</item>
        <item name="chipStrokeWidth">1dp</item>

        <!-- Chip text color selector -->
        <item name="android:textColor">@color/chip_text_color_state</item>
    </style>

    <style name="CardViewStyle" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">@dimen/dimen_8dp</item>
        <item name="cardElevation">@dimen/dimen_4dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="strokeColor">@color/white</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="ModalStyleReadiness">
        <item name="android:background">@drawable/back_modal_dialog</item>
    </style>

    <style name="ModalStyleReadinessNew">
        <item name="android:background">@drawable/back_modal_dialog_new</item>
    </style>
    <style name="ModalStyleTransparentOreo">
        <item name="android:background">@drawable/back_modal_transparent_oreo</item>
    </style>

    <style name="ModalStyleDialogNew">
        <item name="android:background">@drawable/back_modal_dialog_10</item>
    </style>

    <style name="Theme.NoiseFit.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />


</resources>